<popup
  show="{{ visible }}"
  title="{{ title }}"
  bind:close="onClose">
  <view class="category-popup__form">
    <input
      class="category-popup__input"
      placeholder="请输入分类名称"
      value="{{ form.name }}"
      data-field="form.name"
      bindinput="onFieldChange"
      focus="{{ visible }}"
      maxlength="30" />
  </view>
  <view class="category-popup__btns">
    <view class="category-popup__btn category-popup__btn--cancel" bind:tap="onClose">取消</view>
    <view class="category-popup__btn category-popup__btn--save btn--primary" bind:tap="onSave">保存</view>
  </view>
</popup>
