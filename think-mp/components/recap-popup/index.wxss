/* ===== recap-popup：复盘结局回填表单（van-popup 底部滑出，复用 review-popup 视觉范式） ===== */
.recap-popup {
  padding: 40rpx 36rpx 24rpx;
  background: var(--ts-card);
  box-sizing: border-box;
}

.recap-popup__title {
  font-size: 32rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  margin-bottom: 12rpx;
}

.recap-popup__intro {
  font-size: 22rpx;
  color: var(--ts-text-sub);
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.recap-popup__label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ts-text);
  margin-bottom: 20rpx;
}

/* 最终选择 */
.recap-popup__options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.recap-popup__option {
  flex: 1;
  min-width: 200rpx;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--ts-line);
  font-size: 24rpx;
  text-align: center;
  color: var(--ts-text);
  background: var(--ts-card);
  box-sizing: border-box;
}

.recap-popup__option--active {
  border-color: var(--ts-primary);
  background: var(--ts-tag-bg);
  color: var(--ts-brand);
  font-weight: var(--font-weight-6);
}

/* 实际结局输入 */
.recap-popup__textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--ts-text);
  background: var(--ts-fill);
  border-radius: 20rpx;
  line-height: 1.5;
}

/* 提交 */
.recap-popup__submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 28rpx;
  height: 88rpx;
  background: var(--ts-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--ts-radius-pill);
  box-shadow: var(--ts-shadow-btn);
}

.recap-popup__submit:active {
  opacity: 0.92;
}

/* 提交中禁用态：降透明并阻止按压反馈 */
.recap-popup__submit--disabled,
.recap-popup__submit--disabled:active {
  opacity: 0.6;
}

.recap-popup__seal {
  width: 12rpx;
  height: 12rpx;
  background: var(--ts-seal);
  border-radius: 50%;
}
