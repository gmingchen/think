<wxs src="../../../../wxs/index.wxs" module="utils" />
<view wx:if="{{ show }}" class="invite__mask {{ show ? 'invite__mask--visible' : '' }}" catch:tap="onClose" catchtouchmove="true">
  <view class="invite__panel" catch:tap="stopPropagation">
    <!-- 关闭按钮 -->
    <view class="invite__close" catch:tap="onClose">×</view>

    <!-- 骨架屏 -->
    <view wx:if="{{ loading }}" class="invite__skeleton">
      <view class="invite__sk-title invite__sk-block"></view>
      <view class="invite__sk-name invite__sk-block"></view>
      <view class="invite__sk-list">
        <view class="invite__sk-item" wx:for="{{ [1,2,3,4] }}" wx:key="*this">
          <view class="invite__sk-block invite__sk-icon"></view>
          <view class="invite__sk-block invite__sk-label"></view>
          <view class="invite__sk-block invite__sk-value"></view>
        </view>
      </view>
      <view class="invite__sk-btns">
        <view class="invite__sk-block invite__sk-btn"></view>
        <view class="invite__sk-block invite__sk-btn invite__sk-btn--primary"></view>
      </view>
    </view>

    <!-- 内容 -->
    <view wx:elif="{{ info }}" class="invite__content">
      <text class="invite__title">{{ info.inviterName }} 邀请你加入</text>
      <text class="invite__kitchen-name">{{ info.kitchenName }}</text>

      <view class="invite__info-list">
        <view class="invite__info-item">
          <text class="invite__info-icon">👨‍🍳</text>
          <text class="invite__info-label">厨师长</text>
          <text class="invite__info-value">{{ info.ownerName }}</text>
        </view>
        <view class="invite__info-item">
          <text class="invite__info-icon">🎭</text>
          <text class="invite__info-label">角色</text>
          <text class="invite__info-value">{{ utils.findEnumLabel(info.role, KITCHEN_ROLE_LIST) || '未知' }}</text>
        </view>
        <view class="invite__info-item">
          <text class="invite__info-icon">📋</text>
          <text class="invite__info-label">菜谱</text>
          <text class="invite__info-value">{{ info.dishCount }}道</text>
        </view>
        <view class="invite__info-item">
          <text class="invite__info-icon">👥</text>
          <text class="invite__info-label">成员</text>
          <text class="invite__info-value">{{ info.memberCount }}人</text>
        </view>
      </view>

      <view class="invite__btns">
        <view class="invite__btn invite__btn--cancel" catch:tap="onReject">暂不加入</view>
        <view class="invite__btn invite__btn--confirm" catch:tap="onAccept">接受邀请</view>
      </view>
    </view>

    <!-- 加载失败 -->
    <view wx:else class="invite__error">
      <text class="invite__error-text">邀请信息无效或已过期</text>
    </view>
  </view>
</view>
