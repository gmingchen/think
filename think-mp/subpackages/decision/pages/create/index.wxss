page {
  background: var(--ts-bg);
}

.form {
  padding: 24rpx 28rpx 32rpx;
}

/* 强隐私引导条 */
.form__privacy-lead {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--ts-tag-bg);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: var(--ts-brand);
  line-height: 1.4;
}

.form__privacy-lead-icon {
  font-size: 26rpx;
  line-height: 1.3;
}

/* 表单卡片 */
.form__card {
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  box-shadow: var(--ts-shadow);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form__title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.form__title-row--gap {
  margin-top: 28rpx;
}

.form__card-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
}

.form__card-title--sm {
  font-size: 26rpx;
}

.form__req {
  color: var(--ts-seal);
  font-size: 28rpx;
  margin-left: 4rpx;
}

.form__optional {
  font-size: 22rpx;
  color: var(--ts-text-sub);
  font-weight: normal;
  margin-left: 8rpx;
}

.form__counter {
  font-size: 22rpx;
  color: var(--ts-text-sub);
}

/* 单行输入 */
.form__input-box {
  display: flex;
  align-items: center;
  background: var(--ts-fill);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.form__input {
  flex: 1;
  font-size: 26rpx;
  color: var(--ts-text);
}

/* 多行输入 */
.form__textarea-box {
  background: var(--ts-fill);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.form__warn-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--ts-seal-bg);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  color: var(--ts-seal);
  margin-bottom: 12rpx;
}

.form__textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 26rpx;
  color: var(--ts-text);
  line-height: 1.5;
  box-sizing: border-box;
}

/* 图片上传（uploader 组件，此处仅控制宿主外边距） */
.form__img-upload {
  display: block;
  margin-top: 24rpx;
}

/* 你会怎么选 */
.form__option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.form__option-box {
  flex: 1;
  background: var(--ts-fill);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.form__option-input {
  width: 100%;
  font-size: 24rpx;
  color: var(--ts-text);
}

.form__option-del {
  flex-shrink: 0;
  padding: 0 8rpx;
  font-size: 28rpx;
  color: var(--ts-text-sub);
}

.form__option-add {
  border: 2rpx dashed var(--ts-line-dash);
  border-radius: 16rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--ts-primary);
  margin-top: 12rpx;
}

/* 可见范围 */
.form__scope {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.form__scope-card {
  flex: 1;
  border: 2rpx solid var(--ts-line);
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  text-align: center;
  background: var(--ts-card);
}

.form__scope-card--active {
  border-color: var(--ts-primary);
  background: var(--ts-fill-blue);
}

.form__scope-name {
  font-size: 24rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  margin-bottom: 4rpx;
}

.form__scope-card--active .form__scope-name {
  color: var(--ts-brand);
}

.form__scope-sub {
  font-size: 20rpx;
  color: var(--ts-text-sub);
}

.form__sub-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ts-text);
  margin-bottom: 12rpx;
}

.form__sub-label--mb0 {
  margin-bottom: 0;
}

/* 群选择器 */
.form__picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--ts-fill);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.form__picker-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  min-width: 0;
}

.form__group-tag {
  background: var(--ts-tag-bg);
  color: var(--ts-brand);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.form__picker-name {
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
}

.form__picker-ph {
  color: var(--ts-text-sub);
}

/* 选群入口右侧箭头（iconfont right，颜色经组件 color 属性传入） */
.form__picker-change {
  flex-shrink: 0;
}

/* 标签多选 */
.form__tag-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.form__tag-chip {
  background: var(--ts-fill);
  color: var(--ts-text);
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--ts-radius-pill);
}

.form__tag-chip--active {
  background: var(--ts-tag-bg);
  color: var(--ts-brand);
}

/* 评议人数上限（stepper 逐数 + 不限开关） */
.form__limit {
  margin-top: 24rpx;
}

.form__limit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form__limit-ctrl {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.form__unlimit {
  padding: 12rpx 24rpx;
  border-radius: var(--ts-radius-pill);
  background: var(--ts-fill);
  color: var(--ts-text-sub);
  font-size: 24rpx;
}

.form__unlimit--active {
  background: var(--ts-primary);
  color: #FFFFFF;
  font-weight: 500;
}

.form__stepper {
  display: flex;
  align-items: center;
  background: var(--ts-fill);
  border-radius: 16rpx;
  overflow: hidden;
}

.form__stepper-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--ts-text);
  background: var(--ts-fill-seg);
}

.form__stepper-val {
  width: 96rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-brand);
}

.form__stepper-val--wide {
  width: 120rpx;
}

/* 人数点击输入：复用数字位外观 */
.form__stepper-input {
  width: 96rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-brand);
}

.form__limit-sub {
  font-size: 20rpx;
  color: var(--ts-text-sub);
  margin-top: 12rpx;
}

/* 评议时限·分钟档（小时 stepper 下方的 0/15/30/45 可选） */
.form__minute {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.form__minute--disabled {
  opacity: 0.4;
}

.form__minute-pill {
  flex: 1;
  height: 64rpx;
  background: var(--ts-fill);
  border-radius: var(--ts-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--ts-text);
}

.form__minute-pill--active {
  background: var(--ts-primary);
  color: #FFFFFF;
  font-weight: 500;
}

/* 免责声明 */
.form__disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: var(--ts-text-sub);
  margin-top: 8rpx;
}

/* 底部操作 */
.form__actions {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--ts-card);
  border-top: 1rpx solid var(--ts-line);
}

.form__btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: var(--font-weight-5);
  border-radius: var(--ts-radius-pill);
}

.form__btn:active {
  opacity: .9;
}

/* 提交中禁用态：降透明并阻止按压反馈 */
.form__btn--disabled,
.form__btn--disabled:active {
  opacity: .5;
}

.form__btn--ghost {
  color: var(--ts-brand);
  background: var(--ts-tag-bg);
}

.form__btn--primary {
  color: #FFFFFF;
  background: var(--ts-primary);
  box-shadow: var(--ts-shadow-btn);
}

.form__btn-seal {
  width: 12rpx;
  height: 12rpx;
  background: var(--ts-seal);
  border-radius: 50%;
}
