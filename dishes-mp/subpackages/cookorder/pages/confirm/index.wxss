@import '../../../../common/style/index.wxss';

page {
  background: var(--bg-base);
}

/* ── 分区标题 ── */
.confirm__section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 12rpx;
}
.confirm__section-title {
  font-size: var(--font-size-small-1);
  font-weight: var(--font-weight-6);
  color: var(--font-color-sub);
}
.confirm__section-count {
  font-size: var(--font-size-small-3);
  color: var(--font-color-weak);
}
.confirm__section-hint {
  font-size: var(--font-size-small-3);
  color: var(--font-color-weak);
}

/* ── 菜谱卡片 ── */
.confirm__dish-card {
  margin: 0 32rpx;
  padding: 4rpx 24rpx;
}
.confirm__dish-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: var(--border-dashed);
}
.confirm__dish-item:last-child {
  border-bottom: none;
}
.confirm__dish-photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--border-radius-small);
  overflow: hidden;
  flex-shrink: 0;
  background: #F8F1E7;
}
.confirm__dish-img {
  width: 100%;
  height: 100%;
}
.confirm__dish-info {
  flex: 1;
  margin: 0 20rpx;
  overflow: hidden;
}
.confirm__dish-name {
  font-size: var(--font-size);
  font-weight: var(--font-weight-5);
  color: var(--font-color);
}

/* ── 字段卡片 ── */
.confirm__field-card {
  margin: 0 32rpx;
  padding: 24rpx 28rpx;
}
.confirm__field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.confirm__field-label {
  font-size: var(--font-size);
  color: var(--font-color);
}
.confirm__field-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.confirm__field-text {
  font-size: var(--font-size);
  font-weight: var(--font-weight-5);
  color: var(--color-primary);
}

/* ── 时段选择 ── */
.confirm__meal-list {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
}
.confirm__meal-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: var(--font-size);
  border-radius: var(--border-radius-small);
  background: var(--bg-card);
  color: var(--font-color-sub);
  border: 1rpx solid var(--border-color);
}
.confirm__meal-item--active {
  background: var(--color-primary);
  color: #FFF;
  border-color: var(--color-primary);
  font-weight: bold;
}
.confirm__meal-item--disabled {
  opacity: 0.35;
  pointer-events: none;
}

/* ── 备注 ── */
.confirm__remark-card {
  margin: 0 32rpx;
  padding: 20rpx 24rpx;
}
.confirm__remark-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: var(--font-size);
  color: var(--font-color);
  line-height: 1.6;
  box-sizing: border-box;
}

/* ── 底部间距 ── */
.confirm__bottom-spacer {
  height: 32rpx;
}
/* Banner 广告：左右间距由外层 p_h-32 承担，原生 ad 只加上下 margin */
.page__ad {
  margin: 32rpx 0 0;
}

/* ── 底部提交栏 ── */
.confirm__footer {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.confirm__submit-btn {
  background: var(--color-primary);
  color: #FFF;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--border-radius);
  font-size: var(--font-size-large-1);
  font-weight: var(--font-weight-6);
  box-shadow: var(--btn-primary-shadow);
}
.confirm__submit-btn--disabled {
  opacity: 0.6;
  pointer-events: none;
}
