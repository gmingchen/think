<container title="决策终身复盘" use-back use-scroll use-footer>
  <view wx:if="{{ loading }}" class="rc__loading">加载中...</view>

  <view wx:else class="rc">
    <!-- 当初评议 · 历史镜像 -->
    <view class="rc__card rc__card--mirror">
      <view class="rc__section-head">
        <text class="rc__section-tag font-serif">当初评议 · 历史镜像</text>
      </view>
      <view class="rc__intro-title font-serif">{{ title }}</view>
      <view class="rc__intro-tip">回看这件事，你最终怎么选了？后来发生了什么？</view>
    </view>

    <!-- 对照中轴装饰线 -->
    <view class="rc__divider">
      <view class="rc__divider-line"></view>
      <text class="rc__divider-text">现实终局对照</text>
      <view class="rc__divider-line"></view>
    </view>

    <!-- 现实结局 · 亲历沉淀 -->
    <view class="rc__card">
      <view class="rc__section-head">
        <text class="rc__section-tag rc__section-tag--dark font-serif">现实结局 · 亲历沉淀</text>
        <text class="rc__section-extra">事后回填</text>
      </view>

      <!-- 最终选择 -->
      <view class="rc__label">您最终做出的实际选择是？</view>
      <view class="rc__choices">
        <view
          wx:for="{{ options }}"
          wx:key="index"
          class="rc__choice {{ finalChoice === index ? 'rc__choice--active' : '' }}"
          data-index="{{ index }}"
          bindtap="onSelectChoice"
        >{{ item }}</view>
        <view
          class="rc__choice {{ finalChoice === OTHER ? 'rc__choice--active' : '' }}"
          data-index="{{ OTHER }}"
          bindtap="onSelectChoice"
        >其他 / 暂缓</view>
      </view>

      <!-- 实际结局 -->
      <view class="rc__label">实际执行结局与当初预测的偏差：</view>
      <textarea
        class="rc__textarea"
        placeholder="请详述结局：当初众人的推演是否应验？最坏的暗礁发生了吗？如今是否有新的感悟…"
        value="{{ actualResult }}"
        maxlength="{{ RESULT_MAX }}"
        bindinput="onResultInput"
      />

      <view class="rc__hint">💡 提交后决策单将转入「已复盘」终态，成为你人生决策资产库中的一份对照档案。</view>
    </view>
  </view>

  <view wx:if="{{ !loading }}" class="rc__bar" slot="footer">
    <view class="rc__save" bindtap="onSave">
      <text>{{ saving ? '保存中…' : '完成复盘 · 封存档案' }}</text>
      <text class="rc__save-seal"></text>
    </view>
  </view>
</container>
