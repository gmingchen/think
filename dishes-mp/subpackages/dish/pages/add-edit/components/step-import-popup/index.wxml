<popup show="{{ visible }}" title="导入整段步骤" subtitle="粘贴做法文本，自动按换行或序号拆分" bind:close="onClose">
  <view class="step-import__form">
    <textarea
      class="step-import__textarea"
      placeholder="粘贴整段做法，一行一步；也可用 1. 2. 3. 或 第一步、第二步 分隔"
      placeholder-style="color: #B8A99A; line-height: 1.6;"
      value="{{ text }}"
      bindinput="onInput"
      maxlength="5000" />
    <view class="step-import__count">已识别 {{ count }} 步{{ count ? '，导入后追加到现有步骤之后' : '' }}</view>
  </view>
  <view class="step-import__actions">
    <view class="step-import__cancel" catch:tap="onClose">取消</view>
    <view class="step-import__confirm btn--primary" catch:tap="onConfirm">导入</view>
  </view>
</popup>
