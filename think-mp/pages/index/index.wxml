<container use-navbar-left use-scroll use-footer>
  <view slot="navbar-left" class="home__nav-brand font-serif">众三思</view>
  <view class="home">
    <!-- 引导区：问候 + 大标题（用户信息、问候语均由组件自管） -->
    <header />

    <!-- 决策总览卡（大数字 + 摘要） -->
    <overview stats="{{ stats }}" />

    <!-- 评议中状态卡（可点入口，跳转由组件自管） -->
    <review />

    <!-- 三指标卡（横排等宽） -->
    <metrics stats="{{ stats }}" />

    <!-- 去责任化声明（常驻） -->
    <view class="home__notice">建议仅供参考，最终决定权归你</view>
  </view>

  <tabbar slot="footer"></tabbar>
</container>
