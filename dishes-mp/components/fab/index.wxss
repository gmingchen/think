/* 容器 */
.fab {
  position: fixed;
  z-index: 99;
}

/* 主按钮 */
.fab__main {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(200, 109, 81, 0.4);
  transition: box-shadow 0.3s ease;
}
.fab__main:active {
  box-shadow: 0 2px 8px rgba(200, 109, 81, 0.5);
}

/* 主按钮图标 */
.fab__main-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}
.fab__main-icon--rotate {
  transform: rotate(135deg);
}

/* 子菜单条目（收起状态） */
.fab__child {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 38px;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  pointer-events: none;
  transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.18s ease;
}

/* 子菜单条目（展开状态） */
.fab__child--visible {
  opacity: 1;
  pointer-events: auto;
}

/* 圆形子按钮 */
.fab__child-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3px 10px rgba(100, 80, 60, 0.1);
  transition: transform 0.2s ease;
}
.fab__child:active .fab__child-btn {
  transform: scale(0.88);
}

/* 条目图标 */
.fab__child-icon {
  font-size: 18px;
  line-height: 1;
}

/* 条目文字：固定行高占位，label 为空时间距也保持一致 */
.fab__child-label {
  display: block;
  height: 15px;
  margin-top: 2px;
  font-size: 12px;
  line-height: 15px;
  white-space: nowrap;
  color: var(--color-primary);
}

/* 角标 */
.fab__badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  line-height: 18px;
  text-align: center;
  font-size: 11px;
  font-weight: bold;
  color: #FFF;
  background: var(--color-danger);
  border-radius: 10px;
  padding: 0 5px;
  box-sizing: border-box;
}

/* 提示气泡容器（控制显隐过渡）
   提示与第一条 label 占同一区域，transition 写在各自的目标状态上，
   靠时序错开重影：隐藏 0.12s 抢先退场，显示等子项收回后再浮现 */
.fab__hint {
  position: absolute;
  bottom: calc(100% + 4px);
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  pointer-events: none;
  z-index: 1;
  opacity: 1;
  transition: opacity 0.25s ease 0.2s, transform 0.25s ease 0.2s;
}
.fab__hint--hidden {
  opacity: 0;
  transform: translateX(-50%) translateY(6px);
  transition: opacity 0.12s ease, transform 0.12s ease;
}

/* 提示文字（呼吸动画） */
.fab__hint-text {
  font-size: 12px;
  color: var(--color-primary);
  animation: fabHintPulse 2s ease-in-out infinite;
}

@keyframes fabHintPulse {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}
