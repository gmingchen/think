/* ===== ① 厨房信息卡 ===== */
.settings__info-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
}
/* 对齐设计稿：印章「贴着」名称右侧（而非被 space-between 推到卡边），名称过长时自身收缩省略 */
.settings__info-header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.settings__info-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--font-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 角色火印章：细描边 + 微斜，手账盖印的味道（不实心、不压色块） */
.settings__role {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.5;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-tag);
  border: 1rpx solid currentColor;
  transform: rotate(-2deg);
}
.settings__role--1 {
  color: var(--color-primary);
}
.settings__role--2 {
  color: var(--color-secondary);
}
.settings__role--3 {
  color: var(--font-color-sub);
}
/* 六格资产：3 列 × 2 行，只讲「这个厨房有什么」（纯数字），上限归扩容卡独占 */
.settings__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 12rpx;
  padding: 24rpx 0;
  margin-top: 16rpx;
  border-top: var(--border-dashed);
  border-bottom: var(--border-dashed);
  text-align: center;
}
.settings__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}
.settings__stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.1;
}
.settings__stat-label {
  font-size: 22rpx;
  color: var(--font-color-sub);
}
/* 「盛盘美味」不占格：降到卡底一行弱文字，与「创建于」同栏 */
.settings__info-foot {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--font-color-weak);
  text-align: center;
  letter-spacing: 1rpx;
}

/* ===== ② 厨房容量扩容 ===== */
.settings__expand-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
}
.settings__expand-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.settings__expand-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--font-color);
}
.settings__expand-tag {
  font-size: 20rpx;
  color: var(--font-color-sub);
  background: var(--bg-section);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-tag);
}
.settings__expand-desc {
  font-size: 24rpx;
  color: var(--font-color-sub);
  line-height: 1.6;
  margin-bottom: 28rpx;
}
.settings__quota-row {
  margin-bottom: 24rpx;
}
.settings__quota-row:last-child {
  margin-bottom: 0;
}
/* 上行：名称靠左、数量靠右 */
.settings__quota-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.settings__quota-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--font-color);
}
.settings__quota-count {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}
.settings__quota-fraction {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--font-color);
}
.settings__quota-remain {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.settings__quota-warn {
  font-size: 22rpx;
  color: var(--color-danger);
}
/* 下行：进度条与「📺 看视频 +1」按钮同一行、垂直居中 */
.settings__quota-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.settings__meter {
  flex: 1;
  min-width: 0;
  height: 12rpx;
  background: var(--bg-section);
  border-radius: 10rpx;
  overflow: hidden;
}
.settings__meter-fill {
  height: 100%;
  border-radius: 10rpx;
  background: var(--color-secondary);
  transition: width 0.4s ease;
}
.settings__meter-fill--alert {
  background: var(--color-primary);
}
/* 看视频按钮：沿用改版前的实心驼色底样式（麻布棕 #b79466 + 白字）；
   与同行进度条共存时靠 flex-shrink + nowrap 撑住，不改配色 */
.settings__expand-btn {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
  background: #b79466;
  border-radius: 12rpx;
  white-space: nowrap;
}
.settings__expand-btn:active {
  opacity: 0.85;
}
.settings__expand-btn--disabled {
  opacity: 0.6;
}
/* 会员引导行（§4 入口 4）：弱文字小字，不做按钮——与 📺 按钮并列会把转化位做成第二个广告位（§1.3 否决项） */
.settings__expand-vip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--font-color-weak);
}

/* ===== ③ 设置菜单 ===== */
.settings__menu-list-card {
  margin: 24rpx 32rpx;
  padding: 8rpx 32rpx;
}
.settings__menu-item {
  padding: 32rpx 0;
  border-bottom: var(--border-dashed);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: var(--font-color);
}
.settings__menu-item--last {
  border-bottom: none;
}
.settings__menu-item--danger {
  color: var(--color-danger);
}
.settings__menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.settings__menu-value {
  max-width: 320rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--font-color-sub);
  font-size: 26rpx;
}
.settings__arrow {
  font-size: 32rpx;
  color: var(--font-color-weak);
}

/* 原生模板广告：左右间距由外层 p_h-32 承担，只加上下 margin */
.page__ad {
  margin: 0 0 24rpx;
}
