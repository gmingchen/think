.invite__mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(45, 39, 36, 0.6);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}
.invite__mask--visible {
  opacity: 1;
  visibility: visible;
}
.invite__panel {
  position: relative;
  width: 520rpx;
  padding: 32rpx 40rpx 40rpx;
  border-radius: var(--border-radius-large);
  background: var(--bg-base);
  box-shadow: 0 16rpx 48rpx rgba(100, 80, 60, 0.15);
  transform: scale(0.9);
  transition: transform 0.3s ease;
}
.invite__mask--visible .invite__panel {
  transform: scale(1);
}
.invite__close {
  position: absolute;
  top: 20rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--font-color-weak);
  line-height: 1;
  border-radius: 50%;
}
.invite__close:active {
  background: rgba(0, 0, 0, 0.05);
}

/* 加载 / 错误 */
.invite__skeleton {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 380rpx;
}
.invite__sk-block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: invite-shimmer 1.5s infinite;
  border-radius: 6rpx;
}
.invite__sk-title {
  width: 240rpx;
  height: 24rpx;
  margin-bottom: 12rpx;
}
.invite__sk-name {
  width: 180rpx;
  height: 36rpx;
  margin-bottom: 32rpx;
}
.invite__sk-list {
  width: 90%;
  background: var(--bg-card);
  border-radius: var(--border-radius-small);
  padding: 12rpx 24rpx;
  margin-bottom: 32rpx;
}
.invite__sk-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.invite__sk-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}
.invite__sk-label {
  width: 80rpx;
  height: 22rpx;
  margin-right: 16rpx;
}
.invite__sk-value {
  width: 100rpx;
  height: 22rpx;
}
.invite__sk-btns {
  display: flex;
  width: 100%;
  gap: 20rpx;
}
.invite__sk-btn {
  flex: 1;
  height: 72rpx;
  border-radius: var(--radius-pill);
}
.invite__sk-btn--primary {
  background: linear-gradient(90deg, #e8d5c8 25%, #f0e0d4 50%, #e8d5c8 75%);
  background-size: 200% 100%;
  animation: invite-shimmer 1.5s infinite;
}
@keyframes invite-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.invite__error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
  gap: 16rpx;
}
.invite__error-text {
  font-size: 28rpx;
  color: var(--font-color-sub);
}

/* 内容 */
.invite__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 380rpx;
}
.invite__title {
  font-size: var(--font-size-small-2);
  color: var(--font-color-sub);
  letter-spacing: 2rpx;
}
.invite__kitchen-name {
  font-size: var(--font-size-large-4);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

/* 信息列表 */
.invite__info-list {
  width: 90%;
  background: var(--bg-card);
  border-radius: var(--border-radius-small);
  padding: 4rpx 24rpx;
  margin-bottom: 24rpx;
}
.invite__info-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.invite__info-item:last-child {
  border-bottom: none;
}
.invite__info-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.invite__info-label {
  font-size: var(--font-size-small-2);
  color: var(--font-color-sub);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.invite__info-value {
  font-size: var(--font-size-small-1);
  color: var(--font-color);
  font-weight: var(--font-weight-5);
}

/* 按钮 */
.invite__btns {
  display: flex;
  width: 100%;
  gap: 20rpx;
}
.invite__btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  font-size: var(--font-size);
  font-weight: var(--font-weight-5);
}
.invite__btn--cancel {
  background: var(--bg-card);
  color: var(--font-color-sub);
  border: 1rpx solid #E5DBD0;
}
.invite__btn--cancel:active {
  background: #F0EAE0;
}
.invite__btn--confirm {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--btn-primary-shadow);
}
.invite__btn--confirm:active {
  background: var(--color-primary-deep);
}
