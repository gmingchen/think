.skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  overflow: hidden;
}

.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}

/* ═══════════════════════════════════════
   老虎机机箱（对齐 slot-machine 组件真实尺寸）
   ═══════════════════════════════════════ */
.skeleton__cabinet-wrap {
  padding: 12rpx 60rpx 20rpx 32rpx;
  margin-top: 30rpx;
}

.skeleton__cabinet {
  background: linear-gradient(145deg, #A47D5E, #845F45);
  border: 6rpx solid #583D2A;
  border-radius: 40rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow:
    0 24rpx 56rpx rgba(50, 35, 20, 0.28),
    inset 0 4rpx 8rpx rgba(255,255,255,0.3),
    inset 0 -6rpx 12rpx rgba(0,0,0,0.4);
  position: relative;
}

/* 和纸胶带 */
.skeleton__block--tape {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 280rpx;
  height: 40rpx;
  border-radius: 4rpx;
  z-index: 2;
}

/* 铜质铭牌行 */
.skeleton__brass {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 8rpx 12rpx;
}
.skeleton__block--brass-tag {
  width: 140rpx;
  height: 24rpx;
  background: linear-gradient(90deg, rgba(248,239,228,0.35) 25%, rgba(248,239,228,0.55) 50%, rgba(248,239,228,0.35) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
}
.skeleton__block--stepper {
  width: 180rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, rgba(248,239,228,0.35) 25%, rgba(248,239,228,0.55) 50%, rgba(248,239,228,0.35) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
}

/* 玻璃视窗：与 .slot__viewport 严格等高 */
.skeleton__viewport {
  height: 168rpx;
  box-sizing: content-box;
  border-top: 6rpx solid #4D3421;
  border-bottom: 6rpx solid #4D3421;
  background-color: #FFFDF9;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  box-shadow: inset 0 16rpx 28rpx rgba(0,0,0,0.25), inset 0 -16rpx 28rpx rgba(0,0,0,0.25);
}
.skeleton__reel {
  flex: 1;
  min-width: 0;
  height: 168rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx;
}
.skeleton__reel + .skeleton__reel {
  border-left: 2rpx dashed rgba(77, 52, 33, 0.35);
}
.skeleton__block--item-photo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
}
.skeleton__block--item-name {
  width: 70%;
  height: 22rpx;
}

/* 启动拉杆按钮 */
.skeleton__block--spin-btn {
  width: 100%;
  height: 72rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
}

/* ═══════════════════════════════════════
   底部栏
   ═══════════════════════════════════════ */
.skeleton__footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(245, 239, 235, 0.96);
  border-top: 2rpx dashed #DDD1C4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.skeleton__block--cart {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
}
.skeleton__block--order-btn {
  width: 240rpx;
  height: 60rpx;
  border-radius: 12rpx;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
