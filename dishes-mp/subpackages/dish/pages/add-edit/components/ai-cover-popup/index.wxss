/* ── 内容区（三态共用容器，固定高度避免弹窗塌陷） ── */
.ai-cover__body {
  padding: 8rpx 48rpx 24rpx;
  min-height: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* ── 生图中 ── */
.ai-cover__loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.ai-cover__spinner {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid #EDE4D8;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: ai-cover-spin 0.9s linear infinite;
}
@keyframes ai-cover-spin {
  to { transform: rotate(360deg); }
}
.ai-cover__loading-text {
  font-size: 28rpx;
  color: var(--font-color);
}
.ai-cover__loading-sub {
  font-size: 22rpx;
  color: var(--font-color-weak);
}

/* ── 预览图（正方形与菜谱封面比例一致） ── */
.ai-cover__img {
  width: 100%;
  height: 480rpx;
  border-radius: 16rpx;
}

/* ── 失败态 ── */
.ai-cover__error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.ai-cover__error-text {
  font-size: 28rpx;
  color: var(--font-color);
}
.ai-cover__error-sub {
  font-size: 22rpx;
  color: var(--font-color-weak);
}

/* ── 底部操作区（footer 插槽，固定吸底） ── */
.ai-cover__actions {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 48rpx 0;
  border-top: 1rpx solid #EDE4D8;
}
.ai-cover__cancel {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--border-radius);
  font-size: 28rpx;
  background: var(--bg-section);
  color: var(--font-color-sub);
}
.ai-cover__ghost {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--border-radius);
  font-size: 28rpx;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  background: transparent;
  box-sizing: border-box;
}
.ai-cover__confirm {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: var(--color-primary);
  color: #FFF;
}
.ai-cover__confirm--disabled {
  opacity: 0.5;
}
