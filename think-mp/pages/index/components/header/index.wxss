/* 引导区：问候 + 大标题（页面私有组件，宿主块需占满宽度以维持 .home flex 列布局） */
:host {
  display: block;
}

.header {
  padding: 40rpx 8rpx 48rpx;
}

.header__greet {
  font-size: 24rpx;
  color: var(--ts-text-sub);
  margin-bottom: 12rpx;
}

.header__lead {
  font-size: 56rpx;
  font-weight: var(--font-weight-bold);
  color: var(--ts-text);
  line-height: 1.3;
  /* 隔离组件取不到全局 .font-serif 类，衬线字体就近声明 */
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}
