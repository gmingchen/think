<view class="skeleton">
  <!-- 左侧分类栏骨架 -->
  <view class="skeleton__sidebar">
    <view class="skeleton__tab skeleton__tab--active" wx:for="{{ [1,2,3,4,5,6] }}" wx:key="*this">
      <view class="skeleton__block skeleton__block--tab"></view>
    </view>
  </view>

  <!-- 右侧菜谱列表骨架 -->
  <view class="skeleton__main">
    <!-- 分组标题 -->
    <view class="skeleton__block skeleton__block--title"></view>
    <!-- 菜谱卡片 -->
    <view class="skeleton__card" wx:for="{{ [1,2,3,4] }}" wx:key="*this">
      <view class="skeleton__block skeleton__block--photo"></view>
      <view class="skeleton__card-text">
        <view class="skeleton__block skeleton__block--name"></view>
        <view class="skeleton__block skeleton__block--desc"></view>
      </view>
    </view>
    <!-- 第二组 -->
    <view class="skeleton__block skeleton__block--title" style="margin-top: 24rpx;"></view>
    <view class="skeleton__card" wx:for="{{ [5,6] }}" wx:key="*this">
      <view class="skeleton__block skeleton__block--photo"></view>
      <view class="skeleton__card-text">
        <view class="skeleton__block skeleton__block--name"></view>
        <view class="skeleton__block skeleton__block--desc"></view>
      </view>
    </view>
  </view>
</view>
