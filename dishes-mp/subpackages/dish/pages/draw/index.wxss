@import '../../../../common/style/index.wxss';

/* ── 色板变量 ── */
page {
  --zakka-terracotta: #C86D51;
  --zakka-terracotta-dark: #A44F37;
  --zakka-paper: #F5EFEB;
  --zakka-card: #FAF6F0;
  --zakka-ink: #3D352E;
  --zakka-pencil: #8C7E72;
  --zakka-wood: #845F45;
  --zakka-wood-dark: #583D2A;
  --zakka-wood-light: #A47D5E;
  --zakka-tape: rgba(224, 169, 79, 0.55);
  --zakka-stamp-red: #B84A39;
}

.draw__nav-action {
  font-size: 24rpx;
  color: var(--zakka-terracotta);
  font-weight: 600;
  padding: 8rpx 4rpx;
}

.draw__empty {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 空态 Banner：拉满整宽给原生 ad 横向空间（否则塌宽渲染不出），与按钮拉开间距 */
.draw__empty-ad {
  width: 100%;
  margin-top: 8rpx;
}

/* 空态去添加菜谱入口：沿用主按钮陶土砖红风格 */
.draw__empty-btn {
  margin-top: 32rpx;
  padding: 16rpx 44rpx;
  background: var(--zakka-terracotta);
  color: #FFF;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 12rpx;
  box-shadow: 2rpx 4rpx 8rpx rgba(200, 109, 81, 0.35);
}

.draw__empty-btn:active {
  transform: scale(0.96);
}

.draw__body {
  padding: 30rpx 0 0;
}

/* Banner 广告宿主：<ad-unit> 是 draw__chute（flex 列 + align-items:center）的直接子项，
   必须 display:block + align-self:stretch 拉满横宽，否则宿主收缩为 0 导致内部原生 ad 渲染不出 */
.draw__ad {
  display: block;
  align-self: stretch;
}
/* 原生 ad 左右间距由 chute 自带的 32rpx 内边距承担，只加上下 margin */
.page__ad {
  margin: 24rpx 0 32rpx;
}

/* ═══════════════════════════════════════
   出纸口 + 小票
   ═══════════════════════════════════════ */
.draw__chute {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx 0 32rpx;
  position: relative;
}

.draw__chute-slit {
  width: 560rpx;
  height: 20rpx;
  background: #3B291C;
  border: 4rpx solid #573F2E;
  border-radius: 10rpx;
  box-shadow: inset 0 6rpx 12rpx rgba(0,0,0,0.6), 0 4rpx 12rpx rgba(0,0,0,0.1);
  position: relative;
  z-index: 10;
}

/* 小票卡片（showResult 时才挂载，出纸动画由 @keyframes 在挂载时自动播放） */
.draw__receipt {
  width: 640rpx;
  background: #FFFDF9;
  border: 2rpx solid #E5DAD0;
  border-radius: 8rpx;
  padding: 32rpx 28rpx 36rpx;
  box-shadow: 0 20rpx 48rpx rgba(70, 50, 35, 0.12);
  position: relative;
  margin-top: -10rpx;
  z-index: 5;
  animation: drawReceiptOut 0.6s cubic-bezier(0.18, 0.89, 0.32, 1.15) both;
}

/* 出纸动画：从出纸口内向上偏移隐藏处滑出并淡入 */
@keyframes drawReceiptOut {
  from { transform: translateY(-80rpx); opacity: 0; }
  to   { transform: translateY(0); opacity: 1; }
}

/* 顶部穿孔虚线 */
.draw__receipt-perf {
  position: absolute;
  top: 8rpx;
  left: 24rpx;
  right: 24rpx;
  border-top: 2rpx dashed #D2C4B5;
}

/* 小票头 */
.draw__receipt-head {
  text-align: center;
  border-bottom: 2rpx dashed #D8CABE;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  margin-top: 12rpx;
}

.draw__receipt-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--zakka-ink);
}

.draw__receipt-time {
  display: block;
  font-size: 20rpx;
  color: var(--zakka-pencil);
  margin-top: 6rpx;
}

/* 菜品清单：菜品少时垂直居中，行内元素均匀分布 */
.draw__receipt-list {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  gap: 16rpx;
  min-height: 100rpx;
}

.draw__receipt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
}

.draw__receipt-row-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.draw__receipt-row-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0E6DC;
}

.draw__receipt-row-name {
  font-weight: bold;
  color: var(--zakka-ink);
}

.draw__receipt-row-meta {
  font-size: 22rpx;
  color: var(--zakka-pencil);
}

/* 右侧区域（做过次数 + 锁定按钮） */
.draw__receipt-row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 锁定图钉按钮（同 HTML .lock-pin-btn） */
.draw__lock-btn {
  width: 52rpx;
  height: 52rpx;
  background: #EFE4D6;
  border: 2rpx dashed #B89C82;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
  transition: all 0.15s;
}

.draw__lock-btn:active {
  transform: scale(0.92);
}

.draw__lock-btn--locked {
  background: var(--zakka-terracotta);
  border-color: var(--zakka-terracotta-dark);
  border-style: solid;
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.25), 0 2rpx 8rpx rgba(200, 109, 81, 0.4);
  transform: rotate(-1.5deg);
}

/* 已锁定行背景提示 */
.draw__receipt-row--locked {
  background: #FBECE8;
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  margin: -4rpx -8rpx;
}

/* ── 朱红印章 ── */
.draw__seal {
  position: absolute;
  bottom: 16rpx;
  right: 28rpx;
  width: 124rpx;
  height: 124rpx;
  border: 4rpx solid var(--zakka-stamp-red);
  border-radius: 50%;
  color: var(--zakka-stamp-red);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  pointer-events: none;
  opacity: 0;
  transform: scale(2.4) rotate(20deg);
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  background: rgba(245, 230, 226, 0.2);
  box-shadow: inset 0 0 0 2rpx rgba(184, 74, 57, 0.25);
  z-index: 15;
}

.draw__seal--hit {
  opacity: 0.9;
  transform: scale(1) rotate(-14deg);
}

.draw__seal-main {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.draw__seal-sub {
  font-size: 15rpx;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
}

/* 底部锯齿撕裂 */
.draw__receipt-tear {
  position: absolute;
  bottom: -16rpx;
  left: 0; right: 0;
  height: 16rpx;
  background-image: radial-gradient(circle, transparent 8rpx, #FFFDF9 8rpx);
  background-size: 20rpx 16rpx;
  background-position: 0 -8rpx;
}

/* 小票操作按钮 */
.draw__receipt-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dotted #D8CABE;
}

.draw__rbtn {
  flex: 1;
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 12rpx;
  text-align: center;
  margin: 0;
  line-height: normal;
  border: 0;
  transition: all 0.15s;
}

.draw__rbtn::after {
  display: none;
}

.draw__rbtn--pri {
  flex: 1.4;
  background: var(--zakka-terracotta);
  color: #FFF;
  box-shadow: 2rpx 4rpx 8rpx rgba(200, 109, 81, 0.35);
}

.draw__rbtn--pri:active {
  transform: scale(0.96);
}

/* 次要操作：透明底 + 主题色描边（与菜谱详情页「编辑」同档） */
.draw__rbtn--sub {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.draw__rbtn--sub:active {
  background: rgba(200, 109, 81, 0.12);
  transform: scale(0.96);
}

/* ═══════════════════════════════════════
   底部栏
   ═══════════════════════════════════════ */
.draw__footer {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(245, 239, 235, 0.96);
  border-top: 2rpx dashed #DDD1C4;
}

.draw__footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.draw__cart-badge {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 竹篮摇晃动画 */
.draw__cart-badge--shake {
  animation: drawCartShake 0.5s ease-in-out;
  transform-origin: center bottom;
}

@keyframes drawCartShake {
  0%   { transform: rotate(0); }
  20%  { transform: rotate(-15deg); }
  40%  { transform: rotate(12deg); }
  60%  { transform: rotate(-8deg); }
  80%  { transform: rotate(5deg); }
  100% { transform: rotate(0); }
}

.draw__cart-icon {
  font-size: 40rpx;
}

.draw__cart-count {
  position: absolute;
  top: -15rpx;
  left: 30rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #FFF;
  background: var(--color-danger);
  border-radius: 16rpx;
  padding: 0 6rpx;
}

.draw__footer-order-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: bold;
  background: var(--zakka-terracotta);
  color: #FFF;
  box-shadow: 2rpx 4rpx 8rpx rgba(200, 109, 81, 0.35);
}

.draw__footer-order-btn:active {
  transform: scale(0.96);
}
