page {
  background: var(--ts-bg);
}

.home {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100%;
  padding: 16rpx 32rpx 40rpx;
}

/* navbar 左侧品牌 */
.home__nav-brand {
  font-size: 40rpx;
  color: var(--ts-text);
  letter-spacing: 4rpx;
  font-weight: var(--font-weight-6);
}

/* 去责任化声明（常驻，顶到底部以均衡竖向空间） */
.home__notice {
  margin-top: auto;
  padding-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ts-text-sub);
}
