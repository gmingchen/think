.menu {
  margin: 24rpx 32rpx 0;
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 12rpx 20rpx;
}
/* 4 列：7 项排成 4 + 3，比原来的 5 列（5 + 2）收得住，末行不会空荡地飘两个 */
.menu__item {
  margin: 0 !important;
  width: 25% !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0;
}
/* 图标底框：贴纸感的小白方块 + 淡描边，让宫格不再是一排漂浮的 emoji */
.menu__icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: var(--color-white);
  border: 1rpx solid #E8DDD2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.menu__icon {
  font-size: 40rpx;
}
.menu__label {
  font-weight: 400 !important;
  font-size: 24rpx;
  color: var(--font-color);
}
.menu__btn {
  background: none;
  border: none;
  margin: 0;
  padding: 16rpx 0;
  line-height: inherit;
  box-sizing: border-box;
}
.menu__btn::after {
  display: none;
}
