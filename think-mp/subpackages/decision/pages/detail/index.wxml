<wxs src="../../../../wxs/index.wxs" module="s" />
<container title="决策详情" use-back use-scroll use-footer="{{ data.canReview }}">
  <view class="detail">
    <!-- 决策主体卡 -->
    <view class="detail__card">
      <view class="detail__author-row">
        <view class="detail__author">
          <image wx:if="{{ data.initiator.avatar }}" class="detail__avatar" src="{{ data.initiator.avatar }}" mode="aspectFill" />
          <view wx:else class="detail__avatar detail__avatar--text">{{ s.first(data.initiator.nickname) }}</view>
          <view class="detail__author-meta">
            <view class="detail__nick">{{ data.initiator.nickname }}</view>
            <view wx:if="{{ timeText }}" class="detail__time">{{ timeText }}</view>
            <view wx:if="{{ data.endedEarly === 1 }}" class="detail__ended">已提前结束</view>
          </view>
        </view>
        <view class="detail__badges">
          <status-badge status="{{ data.status }}"></status-badge>
          <text wx:if="{{ data.visibility === 2 }}" class="detail__vis">🔒 群内专属</text>
          <text wx:elif="{{ data.visibility === 3 }}" class="detail__vis">公开</text>
          <text wx:if="{{ data.checkStatus === CHECK.PENDING }}" class="detail__check detail__check--pending">审核中</text>
          <text wx:elif="{{ data.checkStatus === CHECK.REJECT }}" class="detail__check detail__check--reject">暂未能发布</text>
        </view>
      </view>

      <view class="detail__title font-serif">{{ data.title }}</view>
      <view class="detail__content">{{ data.content }}</view>

      <!-- 图片：统一用通用 previewer 组件（内置点击预览 wx.previewMedia），尺寸/圆角与创建页 uploader 一致 -->
      <previewer
        wx:if="{{ data.images && data.images.length }}"
        class="detail__thumbs"
        value="{{ data.images }}"
        width="136rpx"
        height="136rpx"
        radius="20rpx"
        gap="20rpx"
        fit="cover"
        preview="{{ true }}"
      />

      <!-- 标签 -->
      <view wx:if="{{ data.tags && data.tags.length }}" class="detail__tags">
        <text wx:for="{{ data.tags }}" wx:key="*this" class="detail__tag"># {{ item }}</text>
      </view>
    </view>

    <!-- 评议时限倒计时 + 进度（不限时走「满员即截止」文案；人数不限时计数无分母、不展进度条） -->
    <view class="detail__cooloff">
      <view class="detail__countdown-title">
        <text wx:if="{{ timeUnlimited }}">⏳ 不限时 · 满 {{ data.reviewLimit }} 人即截止</text>
        <text wx:else>⏳ 评议时限倒计时 {{ countdown || '—' }}</text>
        <text wx:if="{{ countUnlimited }}" class="detail__count">已评 {{ data.reviewCount || 0 }} 人 · 不限</text>
        <text wx:else class="detail__count">{{ data.reviewCount || 0 }} / {{ data.reviewLimit || 0 }} 人已评</text>
      </view>
      <view class="detail__countdown-sub">全员盲审保护期：截止前不展示票数偏向，杜绝羊群盲从效应</view>
      <view wx:if="{{ !countUnlimited }}" class="detail__track"><view class="detail__fill" style="width: {{ percent }}%;"></view></view>
    </view>

    <!-- 你会怎么选 -->
    <view class="detail__card">
      <view class="detail__section-title">你会怎么选</view>
      <view
        wx:for="{{ data.options }}"
        wx:key="index"
        class="detail__option {{ data.myReview && data.myReview.option === index ? 'detail__option--mine' : '' }}"
      >
        <text class="detail__option-text">{{ index + 1 }}. {{ item }}</text>
        <text wx:if="{{ data.myReview && data.myReview.option === index }}" class="detail__option-mine">你的倾向</text>
      </view>
    </view>

    <!-- 我的评议 -->
    <view wx:if="{{ data.myReview }}" class="detail__card">
      <view class="detail__section-title">我的评议</view>
      <view class="detail__mine-content">{{ data.myReview.content }}</view>
    </view>

    <!-- 他人评议 / 先评后看锁 -->
    <block wx:if="{{ data.canViewReviews }}">
      <view class="detail__card">
        <view class="detail__section-title">他人观点评议（{{ data.reviewCount || 0 }}）</view>
        <view wx:for="{{ data.reviews }}" wx:key="id" class="detail__review">
          <view class="detail__review-head">
            <image wx:if="{{ item.user.avatar }}" class="detail__review-avatar" src="{{ item.user.avatar }}" mode="aspectFill" />
            <view wx:else class="detail__review-avatar detail__review-avatar--text">{{ s.first(item.user.nickname) }}</view>
            <text class="detail__review-nick">{{ item.user.nickname }}</text>
            <text wx:if="{{ item.option >= 0 }}" class="detail__review-opt">倾向 · {{ data.options[item.option] }}</text>
          </view>
          <view class="detail__review-content">{{ item.content }}</view>
        </view>
        <view wx:if="{{ !data.reviews.length }}" class="detail__reviews-empty">还没有其他人评议</view>
      </view>
    </block>
    <view wx:else class="detail__locked">
      <view class="detail__section-title">他人观点评议（{{ data.reviewCount || 0 }}）</view>
      <view class="detail__lock-overlay">
        <view class="detail__lock-icon">🔒</view>
        <view class="detail__lock-title">先评后看机制生效中</view>
        <view class="detail__lock-sub">提交你的客观评议后，即可解锁全部同仁的三思观点</view>
      </view>
    </view>

    <!-- 现实结局 · 亲历沉淀（仅发起人 + 已复盘：只读展示回填结果） -->
    <view wx:if="{{ data.owner && recap }}" class="detail__card">
      <view class="detail__section-title">现实结局 · 亲历沉淀</view>
      <view class="detail__recap-row">
        <text class="detail__recap-k">最终选择</text>
        <text class="detail__recap-v font-serif">{{ recapChoiceText }}</text>
      </view>
      <view wx:if="{{ recap.actualResult }}" class="detail__recap-result">{{ recap.actualResult }}</view>
    </view>

    <!-- 发起人管理动作 -->
    <view wx:if="{{ data.owner }}" class="detail__actions">
      <view wx:if="{{ data.status === STATUS.DRAFT }}" class="detail__action" bindtap="onEdit">编辑</view>
      <view wx:if="{{ data.status === STATUS.DRAFT }}" class="detail__action detail__action--danger" bindtap="onDelete">删除</view>
      <view wx:if="{{ data.reportGenerated === 1 }}" class="detail__action detail__action--primary" bindtap="onViewReport">查看报告<view class="detail__action-seal"></view></view>
      <view wx:if="{{ data.status === STATUS.ENDED || data.status === STATUS.RECAPTURED }}" class="detail__action detail__action--primary" bindtap="onRecap">{{ recap ? '修改复盘' : '回填结局' }}<view class="detail__action-seal"></view></view>
      <view wx:if="{{ data.status === STATUS.REVIEWING }}" class="detail__action detail__action--primary" bindtap="onEndEarly">提前结束<view class="detail__action-seal"></view></view>
      <view wx:if="{{ data.status === STATUS.REVIEWING }}" class="detail__action detail__action--danger" bindtap="onClose">关闭</view>
    </view>

    <!-- 举报入口（公开档 + 非发起人） -->
    <view wx:if="{{ !data.owner && data.visibility === 3 }}" class="detail__report" bindtap="onReportTap">举报此内容</view>
  </view>

  <view wx:if="{{ data.canReview }}" slot="footer" class="detail__review-btn" bindtap="onReviewTap">
    <text>{{ data.myReview ? '修改我的评议' : '撰写评议' }}</text>
    <view class="detail__review-seal"></view>
  </view>
</container>

<review-popup
  show="{{ showReview }}"
  options="{{ data.options }}"
  myOption="{{ data.myReview ? data.myReview.option : -1 }}"
  myContent="{{ data.myReview ? data.myReview.content : '' }}"
  submitting="{{ submitting }}"
  bind:close="onReviewClose"
  bind:submit="onReviewSubmit"
/>

<confirm-popup id="actionConfirmPopup" bind:confirm="onConfirmDone" />

<report-popup
  show="{{ showReport }}"
  targetType="{{ 1 }}"
  targetId="{{ id }}"
  bind:close="onReportClose"
/>

<recap-popup
  show="{{ showRecap }}"
  options="{{ data.options }}"
  choice="{{ recap ? recap.finalChoice : null }}"
  result="{{ recap ? recap.actualResult : '' }}"
  submitting="{{ submitting }}"
  bind:close="onRecapClose"
  bind:submit="onRecapSubmit"
/>
