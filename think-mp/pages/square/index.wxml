<container use-navbar-left use-scroll use-footer use-refresher="{{ true }}" refresher-triggered="{{ refreshing }}" bind:refresherrefresh="onPullRefresh">
  <view slot="navbar-left" class="square__nav-brand font-serif">众三思</view>
  <!-- 随机入口横幅（置于 header 插槽：固定不随列表滚动） -->
  <view class="square__banner" slot="header" bindtap="onRandomTap">
    <view class="square__banner-text">
      <view class="square__banner-title">随便看看</view>
      <view class="square__banner-sub">随机遇见一份纠结，给点你的想法</view>
    </view>
    <view class="square__banner-btn">去看看</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{ loading }}" class="square__loading">加载中...</view>

  <!-- 列表 -->
  <view wx:elif="{{ list.length }}">
    <view class="square__item" wx:for="{{ list }}" wx:key="id">
      <review-card item="{{ item }}" bind:click="onCardTap" bind:review="onReviewFromCard" bind:report="onReportFromCard" />
    </view>
    <view wx:if="{{ list.length < page.total }}" class="square__more" bindtap="loadPageData">加载更多</view>
  </view>

  <!-- 缺省（空态）：引导发布决策单（页面私有组件，绝对定位撑满 body 居中） -->
  <empty wx:else />

  <!-- 底部留白：让最后一条内容与 tabbar 之间透气（container 的 is-use-footer 会把 body 底部内边距归零） -->
  <view class="square__spacer"></view>

  <tabbar slot="footer"></tabbar>
</container>

<!-- 「去看看」内容浏览弹窗（独立组件）：展示随机决策内容+选项，点选项回抛 review → 打开下方评议表单 -->
<decision-view-popup
  show="{{ showView }}"
  item="{{ viewItem }}"
  options="{{ viewOptions }}"
  bind:review="onReviewFromCard"
  bind:change="onChangeTap"
  bind:close="onViewClose"
  bind:report="onReportFromCard"
/>

<!-- 填写评议表单弹窗（卡片选项、或上方内容弹窗选选项回抛 review 触发；van-popup 底部滑出） -->
<review-popup
  show="{{ showReview }}"
  options="{{ reviewOptions }}"
  myOption="{{ reviewPreselect }}"
  myContent=""
  bind:close="onReviewClose"
  bind:submit="onReviewSubmit"
/>

<report-popup
  show="{{ showReport }}"
  targetType="{{ 1 }}"
  targetId="{{ reportTargetId }}"
  bind:close="onReportClose"
/>
