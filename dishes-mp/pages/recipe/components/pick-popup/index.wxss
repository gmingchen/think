/* 内容区：设计图卡片内边距 18px + 标题行下方虚线分割（胶带装饰已由通用 popup 提供） */
.pick-popup__content {
  padding: 20rpx 36rpx 16rpx;
  border-top: 2rpx dashed #D6C8BA;
}

.pick-popup__tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--font-color-sub);
  padding: 0 0 20rpx;
}

/* 菜品列表：卡片间按设计图留 20rpx，防 3 道时贴连 */
.pick-popup__list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pick-popup__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFDF9;
  border: 1rpx solid #E5DAD0;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 2rpx 4rpx 10rpx rgba(0,0,0,0.03);
}

.pick-popup__item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.pick-popup__item-pic {
  width: 88rpx;
  height: 88rpx;
  background: #F8F1E7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.pick-popup__item-img {
  width: 100%;
  height: 100%;
}

.pick-popup__item-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.pick-popup__item-name {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--font-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pick-popup__item-meta {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--font-color-sub);
}

.pick-popup__item-btn {
  width: unset !important;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin: 0 !important;
  line-height: normal;
}

/* 底部操作栏：设计图 .popup-actions-bar（点线分割 + 左右内边距与内容区对齐） */
.pick-popup__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 20rpx 36rpx 0;
  border-top: 2rpx dotted #DCD1C4;
}
.pick-popup__btn {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  margin: 0;
  line-height: normal;
  border: 0;
}
.pick-popup__btn::after {
  display: none;
}
.pick-popup__btn--primary {
  background: var(--color-primary);
  color: #FFF;
  box-shadow: var(--btn-primary-shadow);
  flex: 1.3;
}
/* 次要操作：透明底 + 主题色描边（与菜谱详情页「编辑」、抽菜页小票按钮同档） */
.pick-popup__btn--sub {
  background: transparent;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}
