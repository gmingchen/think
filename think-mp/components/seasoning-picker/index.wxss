.seasoning-picker__list {
  max-height: 600rpx;
  padding: 16rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.seasoning-picker__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
}

.seasoning-picker__tag {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: var(--font-color);
  background: #F8F1E7;
  border-radius: 8rpx;
}

.seasoning-picker__tag:active {
  background: rgba(139, 109, 78, 0.2);
}

.seasoning-picker__tag--selected {
  background: var(--color-primary);
  color: #FFF;
}

.seasoning-picker__tag--add {
  box-sizing: border-box;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: transparent;
  border: 1rpx dashed var(--color-primary);
}

.seasoning-picker__empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--font-color-sub);
}

.seasoning-picker__confirm {
  margin: 24rpx 40rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FFF;
  background: var(--color-primary);
  border-radius: 12rpx;
}
