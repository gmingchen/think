/* 微国风品牌字体层（宋体系），用于标题/决策单主标题 */
.font-serif {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}

/* ===== 日系手账风公共类 ===== */
/* 页面底色 */
.page__bg {
  background: var(--bg-base);
}
/* 页面主内容区 */
.page__content {
  padding: 0 32rpx;
}
/* 手账贴纸卡片 */
.zk__card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: var(--card-border);
  box-shadow: var(--card-shadow);
  position: relative;
}
/* 纸胶带装饰 */
.zk__tape {
  position: absolute;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-2deg);
  width: 136rpx;
  height: 36rpx;
  background: var(--tape-yellow);
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.06);
  clip-path: polygon(4% 0%, 96% 0%, 100% 100%, 0% 100%);
}
.zk__tape--green {
  position: absolute;
  top: -14rpx;
  left: 24rpx;
  width: 92rpx;
  height: 32rpx;
  background: var(--tape-green);
  transform: rotate(-5deg);
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}
/* 便签分割线（虚线） */
.zk__dashed {
  border-bottom: var(--border-dashed);
}
/* 主按钮 */
.btn--primary {
  background: var(--btn-primary-bg);
  color: var(--btn-primary-color);
  border-radius: 12rpx;
  box-shadow: var(--btn-primary-shadow);
  border: none;
  font-weight: 500;
  text-align: center;
}
.btn--primary::after { border: none; }
/* 抹茶绿按钮 */
.btn--matcha {
  background: var(--color-secondary);
  color: #FFFFFF;
  border-radius: 12rpx;
  border: none;
  font-weight: 500;
  text-align: center;
}
.btn--matcha::after { border: none; }
/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-tag);
  font-size: var(--font-size-small-2);
}
.tag--primary {
  background: rgba(200, 109, 81, 0.12);
  color: var(--color-primary);
}
.tag--success {
  background: #E8EFE5;
  color: var(--color-secondary);
  font-weight: bold;
}
.tag--default {
  background: #EFE6DC;
  color: var(--font-color-sub);
}
/* 印章标记 */
.stamp__circle {
  width: 116rpx;
  height: 116rpx;
  border: 4rpx solid var(--color-danger);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-small-3);
  font-weight: bold;
  color: var(--color-danger);
  transform: rotate(-12deg);
  opacity: 0.85;
}

/* ===================================================================
 * 众三思 UI 原子样式（严格取自 UI 高保真稿，px×2=rpx），供各页复用
 * =================================================================== */
/* 白底卡片：圆角 32 / 内边距 32 / 轻投影 */
.card {
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--ts-shadow);
  box-sizing: border-box;
}
/* 状态印章徽章（红底白字） */
.badge-seal {
  display: inline-flex;
  align-items: center;
  background: var(--ts-seal);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
/* 常规标签徽章（浅蓝底深蓝字，胶囊） */
.badge-subtle {
  display: inline-flex;
  align-items: center;
  background: var(--ts-tag-bg);
  color: var(--ts-brand);
  font-size: 20rpx;
  line-height: 1.2;
  padding: 4rpx 14rpx;
  border-radius: var(--ts-radius-pill);
  white-space: nowrap;
}
/* 朱砂落款点（胶囊主按钮尾部） */
.seal-dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--ts-seal);
  border-radius: 50%;
  display: inline-block;
}
/* 进度条轨道 + 填充 */
.progress {
  height: 8rpx;
  background: var(--ts-tag-bg);
  border-radius: var(--ts-radius-pill);
  overflow: hidden;
}
.progress__fill {
  height: 100%;
  background: var(--ts-primary);
  border-radius: var(--ts-radius-pill);
}
/* 主胶囊按钮（操作主蓝底白字，尾部落款点） */
.capsule-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 92rpx;
  background: var(--ts-primary);
  color: #FFFFFF;
  border-radius: var(--ts-radius-pill);
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: var(--ts-shadow-btn);
}
.capsule-btn::after { border: none; }
/* 幽灵线框胶囊按钮 */
.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--ts-line-dash);
  color: var(--ts-text);
  border-radius: var(--ts-radius-pill);
  font-size: 26rpx;
  font-weight: 500;
}
.ghost-btn::after { border: none; }
/* 通用分隔线 */
.divider {
  height: 1rpx;
  background: var(--ts-line);
  margin: 20rpx 0;
}
/* 去责任化声明 */
.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: var(--ts-text-sub);
  letter-spacing: 1rpx;
}
