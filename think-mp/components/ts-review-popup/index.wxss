.ts-review-popup {
  padding: 40rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--ts-card);
  box-sizing: border-box;
}

.ts-review-popup__title {
  font-size: 32rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  margin-bottom: 20rpx;
}

/* 锁定提示 */
.ts-review-popup__locked {
  background: var(--ts-fill);
  border: 1rpx dashed var(--ts-line-dash);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ts-text-sub);
  margin-bottom: 24rpx;
}

.ts-review-popup__label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ts-text);
  margin-bottom: 20rpx;
}

/* 倾向备选项 */
.ts-review-popup__options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.ts-review-popup__option {
  flex: 1;
  min-width: 200rpx;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--ts-line);
  font-size: 24rpx;
  text-align: center;
  color: var(--ts-text);
  background: var(--ts-card);
  box-sizing: border-box;
}

.ts-review-popup__option--active {
  border-color: var(--ts-primary);
  background: var(--ts-tag-bg);
  color: var(--ts-brand);
  font-weight: var(--font-weight-6);
}

/* 三思结构化引导 */
.ts-review-popup__hints {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background: var(--ts-fill-gray);
  padding: 20rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.ts-review-popup__hint {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 22rpx;
}

.ts-review-popup__hint-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  color: var(--ts-brand);
  background: var(--ts-tag-bg);
  font-weight: 500;
}

.ts-review-popup__hint-text {
  flex: 1;
  color: var(--ts-text);
  line-height: 1.4;
}

/* 观点输入 */
.ts-review-popup__textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--ts-text);
  background: var(--ts-fill);
  border-radius: 20rpx;
  line-height: 1.5;
}

/* 提交 */
.ts-review-popup__submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 28rpx;
  height: 88rpx;
  background: var(--ts-primary);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--ts-radius-pill);
  box-shadow: var(--ts-shadow-btn);
}

.ts-review-popup__submit:active {
  opacity: 0.92;
}

.ts-review-popup__seal {
  width: 12rpx;
  height: 12rpx;
  background: var(--ts-seal);
  border-radius: 50%;
}
