.popup__van {
  width: 100%;
}
.popup__van--center {
  width: auto;
}
.popup__panel {
  padding: 0 0 72rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--ts-bg);
  border-top: 4rpx solid var(--ts-primary);
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.popup__panel--center {
  border-radius: 40rpx;
  border-top: none;
  max-width: 640rpx;
  margin: 0 auto;
  /* 72rpx 底边是给 bottom 抽屉留给可视区的安全距离；居中卡片按设计图 18px 即可 */
  padding-bottom: 36rpx;
}
.popup__header {
  position: relative;
  text-align: center;
  padding: 16rpx 24rpx;
}
.popup__header-text {
  padding: 0 80rpx;
}
.popup__title {
  font-size: 32rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
}
.popup__subtitle {
  font-size: 24rpx;
  color: var(--ts-text-sub);
  margin-top: 8rpx;
}
.popup__header-actions {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  z-index: 1;
}
.popup__close {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
  height: 48rpx;
}
/* 内容滚动区：小程序下 scroll-view 必须有明确高度才生效，靠 flex:1 自动拉伸不可靠；
   60vh 是为了给 footer 插槽、标题栏与底部内边距留足余量，防止内容超出面板 85vh 而被截断 */
.popup__body {
  max-height: 60vh;
}
