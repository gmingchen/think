.review-card {
}

.review-card__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.review-card__avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.review-card__info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-card__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.review-card__nickname {
  font-size: 24rpx;
  color: var(--font-color-sub);
}

.review-card__time {
  font-size: 22rpx;
  color: var(--font-color-sub);
}

.review-card__content {
  font-size: 26rpx;
  color: var(--font-color);
  font-style: italic;
}
