<wxs src="../../../../wxs/index.wxs" module="utils" />

<container use-scroll title="厨房" use-back>
  <!-- 骨架屏 -->
  <skeleton wx:if="{{ loading }}" />

  <view class="kitchen-list">
    <view
      wx:for="{{ kitchen.list }}"
      wx:key="id"
      class="zk__card kitchen-list__item"
      data-id="{{ item.id }}"
      bind:tap="onTap">
      <view class="kitchen-list__info">
        <view class="kitchen-list__name-row">
          <text class="kitchen-list__name">{{ item.name }}</text>
          <text wx:if="{{ kitchen.active && kitchen.active.id === item.id }}" class="kitchen-list__tag kitchen-list__tag--current">当前</text>
        </view>
        <view class="kitchen-list__meta">
          <text class="kitchen-list__role kitchen-list__role--{{ item.role }}">{{ utils.findEnumLabel(item.role, KITCHEN_ROLE_LIST) }}</text>
          <text class="kitchen-list__stat">菜谱 {{ item.dishCount || 0 }} 道</text>
          <text wx:if="{{ item.role === 1 || item.role === 2 }}" class="kitchen-list__stat">成员 {{ item.memberCount || 0 }} 人</text>
        </view>
      </view>
      <iconfont name="arrow-right" size="28" color="#8C7E72" />
    </view>

    <empty wx:if="{{ kitchen.list.length === 0 }}" text="还没有厨房" />

    <!-- Banner 广告（列表/空态之后、内容末尾；kitchen-list 自带 32rpx 左右内边距，原生 ad 只加上下 margin；受 store.ad.enabled 总开关控制） -->
    <ad-unit wx:if="{{ !loading }}" ad-unit-id="{{ AD_UNIT_KITCHEN_LIST_BANNER }}" cls="page__ad" />
  </view>
</container>
