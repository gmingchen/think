@import '../../../../common/style/index.wxss';

.poster-draw__stage {
  /* min-height 由页面按可用高度内联下发，配合 justify-content 实现垂直居中 */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.poster-draw__loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 16rpx 32rpx;
  background: rgba(61, 53, 46, 0.72);
  color: #FAF5EE;
  font-size: 24rpx;
  border-radius: 40rpx;
  z-index: 20;
}

/* 底部按钮栏：尺寸与配色对齐全站底栏按钮 scale（参考 pick-popup 底栏、抽菜页小票操作区） */
.poster-draw__footer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(245, 239, 235, 0.96);
  border-top: 2rpx dashed var(--border-color);
}

.poster-draw__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 0;
  margin: 0;
  line-height: normal;
  border: 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.15s;
}

.poster-draw__btn::after {
  border: none;
}

/* 次要操作：透明底 + 主题色描边（与菜谱详情页「编辑」、抽菜页小票按钮同档） */
.poster-draw__btn--sub {
  background: transparent;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}

.poster-draw__btn--sub:active {
  background: rgba(200, 109, 81, 0.12);
  transform: scale(0.96);
}

/* 主操作：直接用全站主按钮令牌（砖红实底 + 轻投影），宽度略大于次要按钮 */
.poster-draw__btn--pri {
  flex: 1.3;
  background: var(--btn-primary-bg);
  color: var(--btn-primary-color);
  box-shadow: var(--btn-primary-shadow);
}

.poster-draw__btn--pri:active {
  transform: scale(0.96);
}
