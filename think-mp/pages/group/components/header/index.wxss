/* 顶部操作行：标题 + 建群（页面私有组件） */
:host {
  display: block;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 28rpx;
}

.header__title {
  font-size: 40rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  /* 隔离组件取不到全局 .font-serif，衬线就近声明 */
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}

.header__subtitle {
  font-size: 22rpx;
  color: var(--ts-text-sub);
  margin-top: 4rpx;
}

.header__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header__join {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--ts-card);
  color: var(--ts-primary);
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid var(--ts-line);
  border-radius: var(--ts-radius-pill);
}

.header__join:active {
  opacity: 0.92;
}

.header__create {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 28rpx;
  background: var(--ts-primary);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: var(--ts-radius-pill);
  box-shadow: var(--ts-shadow-btn);
}

.header__create:active {
  opacity: 0.92;
}

.header__create-seal {
  width: 10rpx;
  height: 10rpx;
  background: var(--ts-seal);
  border-radius: 50%;
}
