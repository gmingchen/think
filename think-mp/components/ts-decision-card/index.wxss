.ts-decision-card {
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  box-shadow: var(--ts-shadow);
  padding: 32rpx;
  box-sizing: border-box;
}

.ts-decision-card__head {
  margin-bottom: 20rpx;
}

.ts-decision-card__vis {
  font-size: 22rpx;
  color: var(--ts-brand);
  font-weight: 600;
}

.ts-decision-card__author {
  font-size: 22rpx;
  color: var(--ts-text-sub);
  max-width: 260rpx;
}

.ts-decision-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ts-text);
  line-height: 1.4;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.ts-decision-card__digest {
  font-size: 26rpx;
  color: var(--ts-text);
  opacity: 0.85;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.ts-decision-card__images {
  grid-gap: 12rpx;
  margin-bottom: 24rpx;
}

.ts-decision-card__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: var(--ts-fill-thumb);
}

.ts-decision-card__tags {
  grid-gap: 12rpx;
  margin-bottom: 20rpx;
}

.ts-decision-card__tag {
  font-size: 22rpx;
  color: var(--ts-brand);
  background: var(--ts-fill);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.ts-decision-card__foot {
  margin-top: 16rpx;
}

.ts-decision-card__progress-label {
  font-size: 22rpx;
  color: var(--ts-text-sub);
  margin-bottom: 8rpx;
}

.ts-decision-card__track {
  height: 8rpx;
  background: var(--ts-tag-bg);
  border-radius: 999rpx;
  overflow: hidden;
}

.ts-decision-card__fill {
  height: 100%;
  background: var(--ts-primary);
  border-radius: 999rpx;
}
