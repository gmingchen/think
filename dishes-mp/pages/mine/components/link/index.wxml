<view class="zk__card link">
  <block wx:for="{{ list }}" wx:key="label">
    <view
      wx:if="{{ item.type === 'reward' && ad.enabled }}"
      class="link__item"
      bind:tap="onReward">
      <text class="link__label">{{ item.label }}</text>
      <view class="link__reward">
        <text class="link__reward-tag">广告</text>
        <iconfont name="arrow-right" size="28" color="#8C7E72" />
      </view>
    </view>
    <button
      wx:elif="{{ item.type === 'share' }}"
      class="link__item link__item--btn {{ index === list.length - 1 ? 'link__item--last' : '' }}"
      open-type="share"
      hover-class="none">
      <text class="link__label">{{ item.label }}</text>
      <iconfont name="share" size="28" color="#8C7E72" />
    </button>
    <view
      wx:else
      class="link__item {{ index === list.length - 1 ? 'link__item--last' : '' }}"
      data-url="{{ item.url }}"
      bind:tap="onTap">
      <text class="link__label">{{ item.label }}</text>
      <iconfont name="arrow-right" size="28" color="#8C7E72" />
    </view>
  </block>
</view>
