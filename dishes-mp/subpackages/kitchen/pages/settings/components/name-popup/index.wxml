<popup show="{{ visible }}" title="修改厨房名称" bind:close="onClose">
  <view class="name-popup__form">
    <input
      class="name-popup__input"
      placeholder="请输入厨房名称"
      value="{{ form.name }}"
      data-field="form.name"
      bindinput="onFieldChange"
      focus="{{ visible }}"
      maxlength="30" />
  </view>
  <view class="name-popup__btns">
    <view class="name-popup__btn name-popup__btn--cancel" bind:tap="onClose">取消</view>
    <view class="name-popup__btn name-popup__btn--save btn--primary" bind:tap="onSave">保存</view>
  </view>
</popup>
