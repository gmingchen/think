/*
  手账风底部 TabBar
  由于该组件在 custom-tab-bar 中使用，无法使用 CSS 变量，色值硬编码
*/
.tabbar {
  height: 88rpx;
  background: #FAF5EE;
  border-top: 1rpx solid #DFD3C4;
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.tabbar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #8C7E72;
  flex: 1;
  transition: all 0.2s;
}
.tabbar__item--active {
  color: #C86D51;
  font-weight: bold;
}
.tabbar__icon {
  font-size: 44rpx;
  transition: transform 0.2s;
}
.tabbar__item--active .tabbar__icon {
  transform: scale(1.15);
}
