/* 会员中心（v12 §5 / §11，界面稿 docs/v12/会员中心.html 手账风）
   暖系再生棉麻底 + 会员这一处的「克制的贵金属点缀」：全站唯一深色金块留给「他付过钱」这件事 */

/* ---- 手账配色（本页私有，与全局 token 同值但为还原界面稿就近声明）---- */
page {
  --vip-terra: #C86D51;
  --vip-terra-dark: #B3583E;
  --vip-matcha: #688B58;
  --vip-mustard: #E0A94F;
  --vip-card: #FAF6F0;
  --vip-pure: #FFFDF9;
  --vip-ink: #3D352E;
  --vip-pencil: #8C7E72;
  --vip-weak: #B84A39;
  --vip-gold-ink: #F3E2C4;
  --vip-gold-line: #E5BE75;
  --vip-dashed: #DDD3C8;
}

/* ---- 板块槽位：与「我的」页各卡同一套左右间距 ---- */
.vip__sk-card,
.vip__hint,
.vip__status,
.vip__tier,
.vip__period-card,
.vip__compare-card,
.vip__notice,
.vip__records {
  margin: 0 32rpx 24rpx;
}
.vip__group-head {
  margin: 8rpx 32rpx 16rpx;
}

/* ---- 骨架：同高占位、微光扫过但不转圈（转圈会把一个数据未到的事说成一件在发生的事，§11） ---- */
.vip__sk-card {
  padding: 28rpx 32rpx;
  min-height: 148rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: var(--vip-card);
  border: 1rpx solid #E5DBD0;
  border-radius: 32rpx;
}
.vip__sk-bar {
  height: 28rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #EADFD3 25%, #F4EBE2 50%, #EADFD3 75%);
  background-size: 200% 100%;
  animation: vip-shimmer 1.8s infinite ease-in-out;
}
.vip__sk-bar--title { width: 240rpx; height: 36rpx; }
.vip__sk-bar--short { width: 180rpx; }
@keyframes vip-shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* ---- 弱提示（置灰期 / 低版本）：小字常驻条，不加横幅不与 CTA 抢焦点 ---- */
.vip__hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background: #F2ECE1;
  border: 1rpx solid #E0D5C7;
  border-radius: 24rpx;
}
.vip__hint-icon { font-size: 24rpx; }
.vip__hint-text { flex: 1; font-size: 22rpx; line-height: 1.5; color: #7A6B5D; }

/* ---- ① 身份状态卡 ---- */
.vip__status {
  padding: 28rpx 32rpx;
  min-height: 132rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: var(--vip-card);
  border: 1rpx solid #E5DBD0;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(61, 53, 46, 0.04);
}
.vip__status-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}
.vip__status-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.vip__status-crown { font-size: 26rpx; }
.vip__status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--vip-terra);
  flex-shrink: 0;
}
.vip__status-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--vip-ink);
}
.vip__status-note {
  font-size: 22rpx;
  color: var(--vip-pencil);
  line-height: 1.5;
}
.vip__status-pot {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #F3EDE3;
  border: 1rpx solid #E2D6C7;
}
.vip__status-reactivate {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: var(--vip-terra);
  background: var(--vip-pure);
  border: 1rpx solid #E0D2C2;
  border-radius: 12rpx;
}
/* 生效中：全站唯一深黑金块，卡内每处用主题色说话的元素都要跟着反色 */
.vip__status--gold {
  background: linear-gradient(135deg, #2D2622 0%, #1E1917 100%);
  border-color: rgba(229, 190, 117, 0.35);
  box-shadow: 0 12rpx 32rpx rgba(30, 25, 23, 0.35);
}
.vip__status--gold .vip__status-title { color: var(--vip-gold-ink); }
.vip__status--gold .vip__status-note { color: #C5B39A; }
.vip__status-btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  color: var(--vip-gold-ink);
  border: 1rpx solid var(--vip-gold-line);
}

/* ---- ② 选择档位：区头 + 两张堆叠卡 ---- */
.vip__group-title {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--vip-ink);
}
.vip__group-icon { color: var(--vip-pencil); margin-right: 6rpx; }
.vip__group-sub { font-size: 22rpx; color: var(--vip-pencil); }
.vip__group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.vip__tier {
  position: relative;
  padding: 28rpx 32rpx 24rpx;
  background: var(--vip-card);
  border: 1rpx solid var(--vip-dashed);
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(61, 53, 46, 0.04);
}
.vip__tier--on {
  background: var(--vip-pure);
  border: var(--border-width-large, 4rpx) solid var(--vip-terra);
}
/* 「推荐首选」芥末黄纸胶带：斜贴 + 梯形裁切，浮在卡左上沿 */
.vip__tape {
  position: absolute;
  top: -10rpx;
  right: 36rpx;
  padding: 4rpx 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #4A3515;
  background: var(--vip-mustard);
  transform: rotate(2deg);
  clip-path: polygon(6% 0, 94% 0, 100% 100%, 0 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}
.vip__tier-check {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  background: var(--vip-terra);
  box-shadow: 0 2rpx 6rpx rgba(200, 109, 81, 0.35);
}
.vip__tier-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* 选中卡右上有对勾，标题行留出右侧空间避免压字 */
  padding-right: 48rpx;
}
.vip__tier-head--roomy { padding-right: 0; }
.vip__tier-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--vip-ink);
}
.vip__tier-tag {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--vip-matcha);
  background: #EEF4EC;
  border: 1rpx solid #D7E5D3;
  border-radius: 8rpx;
}
.vip__tier-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--vip-pencil);
}
.vip__tier-price {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--vip-dashed);
}
.vip__tier-from { font-size: 22rpx; color: var(--vip-pencil); }
.vip__tier-from-num { font-size: 30rpx; font-weight: 700; color: var(--vip-terra); }
.vip__tier--on .vip__tier-from-num { color: var(--vip-terra); }
.vip__tier-to {
  font-size: 22rpx;
  color: var(--vip-ink);
  padding: 4rpx 16rpx;
  background: #FAF3EC;
  border-radius: 8rpx;
}
.vip__tier-to-num { font-weight: 700; color: var(--vip-terra); }

/* ---- ③ 选择开通周期：独立卡，胶囊一行三个 ---- */
.vip__period-card {
  padding: 24rpx 28rpx;
  background: var(--vip-card);
  border: 1rpx solid #E5DBD0;
  border-radius: 32rpx;
}
.vip__period-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.vip__period-title { font-size: 26rpx; font-weight: bold; color: var(--vip-ink); }
.vip__period-icon { margin-right: 6rpx; }
.vip__period-sub { font-size: 22rpx; color: var(--vip-matcha); }
.vip__periods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.vip__pill {
  flex: 0 0 calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 20rpx 8rpx;
  border-radius: 20rpx;
  background: var(--vip-pure);
  border: 1rpx solid var(--vip-dashed);
}
.vip__pill--on {
  background: var(--vip-terra);
  border-color: var(--vip-terra);
  box-shadow: 0 0 0 6rpx rgba(200, 109, 81, 0.15);
}
.vip__pill-label { font-size: 24rpx; font-weight: bold; color: var(--vip-ink); }
.vip__pill-price { font-size: 34rpx; font-weight: 800; color: var(--vip-ink); }
.vip__pill-saved { font-size: 20rpx; color: var(--vip-matcha); }
.vip__pill--on .vip__pill-label,
.vip__pill--on .vip__pill-price { color: #fff; }
.vip__pill--on .vip__pill-saved { color: rgba(255, 255, 255, 0.9); }
.vip__period-foot {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDE5DA;
  font-size: 22rpx;
  color: var(--vip-pencil);
}

/* ---- ④ 权益对比表：核心权益 41% / 免费 17% / 轻享 17% / 畅厨 25%（畅厨那列高亮） ---- */
.vip__compare-card {
  padding: 24rpx 28rpx;
  background: var(--vip-card);
  border: 1rpx solid #E5DBD0;
  border-radius: 32rpx;
}
.vip__compare-title { font-size: 26rpx; font-weight: bold; color: var(--vip-ink); margin-bottom: 16rpx; }
.vip__compare-icon { margin-right: 6rpx; }
.vip__table {
  background: var(--vip-pure);
  border: 1rpx solid var(--vip-dashed);
  border-radius: 20rpx;
  overflow: hidden;
}
.vip__tr {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #EAE0D5;
}
.vip__tr:last-child { border-bottom: none; }
.vip__tr--head {
  background: #F2EAE0;
  border-bottom: 1rpx solid var(--vip-dashed);
  padding: 18rpx 0;
}
.vip__th, .vip__td {
  text-align: center;
  font-size: 22rpx;
}
.vip__th--label, .vip__td--label {
  flex: 0 0 41%;
  text-align: left;
  padding-left: 24rpx;
  line-height: 1.3;
}
.vip__th--free, .vip__td--free { flex: 0 0 17%; }
.vip__th--lite, .vip__td--lite { flex: 0 0 17%; }
.vip__th--pro, .vip__td--pro {
  flex: 0 0 25%;
  background: #FCF6F0;
  border-left: 1rpx solid #F0E0D2;
  align-self: stretch;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vip__th { font-weight: 600; color: #54473C; }
.vip__th--free { color: #7C6F63; }
.vip__th--pro { color: var(--vip-terra); font-weight: 700; background: #FAEDE5; }
.vip__td--label { color: var(--vip-ink); }
.vip__td--free { color: var(--vip-pencil); }
.vip__td--lite { color: var(--vip-weak); font-weight: 500; }
.vip__td--pro { color: var(--vip-terra); font-weight: 700; }

/* ---- ⑤ 购买须知折叠条：默认收起，小字风，不与主 CTA 抢焦点（§5.4） ---- */
.vip__notice {
  overflow: hidden;
  background: var(--vip-card);
  border: 1rpx solid #E5DBD0;
  border-radius: 32rpx;
}
.vip__notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
}
.vip__notice-title { font-size: 26rpx; font-weight: bold; color: var(--vip-ink); }
.vip__notice-icon { margin-right: 8rpx; }
.vip__notice-toggle { display: flex; align-items: center; gap: 8rpx; }
.vip__notice-stat { font-size: 22rpx; color: var(--vip-pencil); }
.vip__notice-arrow {
  font-size: 22rpx;
  color: var(--vip-pencil);
  transition: transform 0.2s;
}
.vip__notice-arrow--open { transform: rotate(180deg); }
.vip__notice-body {
  padding: 4rpx 28rpx 28rpx;
  border-top: 1rpx dashed var(--vip-dashed);
}
.vip__notice-item {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
  margin-top: 16rpx;
}
.vip__notice-no { font-size: 22rpx; font-weight: 700; color: var(--vip-terra); flex-shrink: 0; }
.vip__notice-txt { flex: 1; font-size: 22rpx; line-height: 1.6; color: #635548; }
.vip__notice-b { font-weight: 700; color: #54473C; }

/* ---- ⑥ 开通记录 ---- */
.vip__records {
  padding: 24rpx 28rpx;
  background: var(--vip-card);
  border: 1rpx solid #E5DBD0;
  border-radius: 32rpx;
}
.vip__records-title { font-size: 26rpx; font-weight: bold; color: var(--vip-ink); margin-bottom: 8rpx; }
.vip__records-icon { margin-right: 6rpx; }
.vip__record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #E5DBD0;
}
.vip__record:last-child { border-bottom: none; }
.vip__record-left { display: flex; flex-direction: column; gap: 6rpx; }
.vip__record-label { font-size: 26rpx; color: var(--vip-ink); }
.vip__record-date { font-size: 20rpx; color: var(--vip-pencil); }
.vip__record-no { font-size: 20rpx; color: var(--vip-pencil); opacity: .55; }
.vip__record-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; }
.vip__record-price { font-size: 26rpx; font-weight: 700; color: var(--vip-ink); }
.vip__record-status {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
}
.vip__record-status--active { color: var(--vip-matcha); background: #EBF2E8; }
.vip__record-status--refund { color: var(--vip-weak); background: #F8ECE8; }

/* ---- ⑦ 协议链接 ---- */
.vip__links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}
.vip__link { font-size: 22rpx; color: #6E6053; text-decoration: underline; }
.vip__link-split { font-size: 22rpx; color: #C0B2A3; }
/* 底栏吸底常驻，正文最后一段得给它腾出高度，否则「开通记录」末行永远被压着看不见 */
.vip__bottom-space { height: 24rpx; }

/* ---- 底部 CTA：实心主按钮，权重与 add-edit 底栏一致（§11「全站主按钮权重统一」） ---- */
.vip__bar {
  background: rgba(250, 245, 238, 0.96);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--vip-dashed);
}
.vip__cta {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 28rpx;
  background: var(--vip-terra);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 16rpx rgba(200, 109, 81, 0.28);
}
.vip__cta-crown { font-size: 30rpx; }
.vip__cta--off {
  /* 置灰态要说得出为什么点不动（§4.1 同口径），所以这里只换视觉，话术由 onBuy 那一层给 */
  background: #E5DCD1;
  color: #9E9084;
  font-weight: 500;
  box-shadow: none;
}
