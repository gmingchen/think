/* 选群弹窗（全局 popup 的业务封装，显隐与群组拉取内聚于组件） */

/* 内容区：popup 面板不带左右内边距，这里补齐留白 + 顶部呼吸感（对齐群组侧弹窗规范） */
.grp-picker__body {
  padding: 8rpx 40rpx 40rpx;
}

.grp-picker__tip {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ts-text-sub);
  margin-bottom: 24rpx;
}

.grp-picker__loading,
.grp-picker__empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ts-text-sub);
}

/* 群组项：浅底圆角卡片，与 edit-popup 输入框同款底色/圆角 */
.grp-picker__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  background: var(--ts-fill);
  border: 1rpx solid transparent;
  border-radius: var(--ts-radius-input);
}

.grp-picker__item--active {
  background: var(--ts-fill-blue);
  border-color: var(--ts-primary);
}

.grp-picker__name {
  font-size: 28rpx;
  font-weight: var(--font-weight-5);
  color: var(--ts-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.grp-picker__item--active .grp-picker__name {
  color: var(--ts-brand);
}

.grp-picker__right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.grp-picker__meta {
  font-size: 24rpx;
  color: var(--ts-text-sub);
}
