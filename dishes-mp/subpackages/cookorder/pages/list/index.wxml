<wxs src="../../../../wxs/index.wxs" module="utils" />

<container use-scroll title="厨房订单" use-back>

  <!-- 顶部切换（食客只看自己的订单，不显示 tab） -->
  <view class="list__tab-bar" slot="header" wx:if="{{ isChef }}">
    <view class="list__tab-btn {{ activeTab === 1 ? 'list__tab-btn--active' : '' }}" data-tab="{{ 1 }}" bindtap="onSwitchTab">我下的</view>
    <view class="list__tab-btn {{ activeTab === 2 ? 'list__tab-btn--active' : '' }}" data-tab="{{ 2 }}" bindtap="onSwitchTab">厨房所有</view>
  </view>

  <!-- 加载中 -->
  <skeleton wx:if="{{ loading }}" />

  <!-- 订单列表 -->
  <view wx:elif="{{ list.length }}">
    <view class="zk__card list__order-card" wx:for="{{ list }}" wx:key="id" data-id="{{ item.id }}" bindtap="onViewDetail">
      <view class="list__order-head">
        <text class="list__order-title">{{ item.periodLabel }} · {{ item.ordererName || '我' }}</text>
        <text class="tag {{ item.isPending ? 'tag--primary' : item.isServed ? 'tag--success' : 'tag--default' }}">{{ item.statusLabel }}</text>
      </view>
      <!-- 菜品行：封面+名称+数量居右（同详情页字段 dishCover，无封面时占位图兑底） -->
      <view class="list__order-dishes">
        <view wx:for="{{ item.dishes }}" wx:for-item="dish" wx:key="dishId" class="list__dish-item">
          <image wx:if="{{ dish.dishCover }}" src="{{ dish.dishCover }}" mode="aspectFill" class="list__dish-cover" />
          <image wx:else src="{{ DEFAULT_DISH_COVER }}" mode="aspectFit" class="list__dish-cover" />
          <text class="list__dish-name e">{{ dish.dishName }}</text>
          <text class="list__dish-qty">×{{ dish.quantity }}</text>
        </view>
      </view>
      <view wx:if="{{ item.remark }}" class="list__order-remark">备注：{{ item.remark }}</view>
      <!-- 底栏拆两行：行1 时间+评星元信息，行2 操作区左取消右主操作（同详情页分组模式） -->
      <view class="list__order-foot">
        <view class="list__foot-meta">
          <text class="list__order-time">{{ item.dateLabel }}</text>
          <view wx:if="{{ item.isReviewed && item.rating }}" class="list__rating-display">
            <van-rate value="{{ item.rating }}" color="#E8A87C" void-color="#D8CCBE" size="10px" readonly />
          </view>
        </view>
        <view class="list__order-actions" wx:if="{{ !item.isCancelled }}" catchtap="">
          <view class="list__actions-left">
            <text wx:if="{{ item.isPending || item.isAccepted }}" class="list__action list__action--cancel" data-id="{{ item.id }}" catchtap="onCancel">取消</text>
          </view>
          <view class="list__actions-group">
            <view class="list__ghost-btn" data-id="{{ item.id }}" catchtap="onGoShopping">🛒 采购清单</view>
            <view wx:if="{{ item.isPending && isChef }}" class="btn--primary list__main-btn" data-id="{{ item.id }}" catchtap="onAccept">🧾 接单</view>
            <view wx:if="{{ item.isPending || item.isAccepted }}" class="btn--primary list__main-btn" data-id="{{ item.id }}" catchtap="onServe">🍽️ 上菜</view>
            <text wx:if="{{ item.isServed && item.isMine }}" class="list__action list__action--primary" data-id="{{ item.id }}" catchtap="onReview">✍️ 夸夸大厨</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{ list.length < page.total }}" class="list__load-more" bindtap="loadPageData">加载更多</view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="list__empty">
    <empty title="暂无订单" desc="{{ activeTab === 1 ? '你还没有下过单哦' : '厨房还没有订单哦' }}" />
  </view>

  <!-- Banner 广告（列表/空态之后、页面末尾；加载完成即展示，无数据也展示、加载中不展示；受 store.ad.enabled 总开关控制，无填充自动隐藏） -->
  <view class="p_h-32">
    <ad-unit wx:if="{{ !loading }}" ad-unit-id="{{ AD_UNIT_COOKORDER_LIST_CUSTOM }}" cls="page__ad" />
  </view>

</container>

<!-- 评价弹窗 -->
<review-popup id="reviewPopup" bind:success="onReviewSuccess" />

<!-- 操作确认弹窗 -->
<confirm-popup id="actionConfirmPopup" bind:confirm="onActionConfirm" />
