
.best__wrapper {
  padding: 0;
}
.best__header {
  padding-left: 32rpx;
}
.best__strip {
  white-space: nowrap;
  padding: 8rpx 0 40rpx;
}
.best__strip-inner {
  padding: 16rpx 0;
  display: inline-flex;
}
.best__card {
  position: relative;
  display: inline-block;
  width: 280rpx;
  background: #FFF;
  border-radius: 8rpx;
  padding: 16rpx 16rpx 24rpx;
  box-shadow: 2rpx 6rpx 12rpx rgba(0,0,0,0.08);
  border: 1rpx solid #ECE3D9;
  margin-right: 24rpx;
  vertical-align: top;
}
.best__card:first-child {
  margin-left: 32rpx;
}
.best__card:last-child {
  margin-right: 32rpx;
}
.best__card--star {
  border-color: var(--color-primary);
  box-shadow: 2rpx 6rpx 16rpx rgba(196, 149, 106, 0.25);
}
.best__badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  font-size: 18rpx;
  background: #FFF7E6;
  color: var(--color-primary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--color-primary);
  font-weight: bold;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.best__card:nth-child(1) { transform: rotate(-1deg); }
.best__card:nth-child(2) { transform: rotate(1.5deg); }
.best__card:nth-child(3) { transform: rotate(-2deg); }
.best__photo {
  width: 100%;
  height: 248rpx;
  background: #F2E8DC;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}
image.best__photo {
  display: block;
}
.best__caption {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: var(--font-color);
  text-align: center;
  display: block;
}
.best__note {
  font-size: 20rpx;
  color: var(--font-color-sub);
  text-align: center;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.best__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 16rpx;
}
.best__empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.best__empty-text {
  font-size: 26rpx;
  color: var(--font-color);
  font-weight: 600;
}
.best__empty-hint {
  font-size: 22rpx;
  color: var(--font-color-sub);
  margin-top: 4rpx;
}
