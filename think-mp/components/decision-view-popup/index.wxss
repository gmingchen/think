/* ===== decision-view-popup：「去看看」内容浏览弹窗（固定头 + 可滚动主体 + 选项按钮，点选项弹评议表单） ===== */
.decision-view__mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(34, 38, 46, 0.55);
  animation: dvMaskIn 0.24s ease;
}

/* 关闭时遮罩同步淡出 */
.decision-view__mask--closing {
  animation: dvMaskOut 0.24s ease forwards;
}

.decision-view {
  position: relative;
  width: 640rpx;
  max-width: 90vw;
  /* 面板整体随内容自适应（不固定高度）；max-height 仅作不超出视口的兜底 guard，
     取得比“头部+主体上限+底部”自然高度更大，确保不会裁掉底部按钮 */
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  background: var(--ts-card);
  border-radius: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  animation: dvPopupIn 0.24s ease;
}

/* 关闭动画：淡出 + 轻微缩小，forwards 保持终态直到卸载 */
.decision-view--closing {
  animation: dvPopupOut 0.24s ease forwards;
}

@keyframes dvPopupIn {
  from { opacity: 0; transform: scale(0.94); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes dvPopupOut {
  from { opacity: 1; transform: scale(1); }
  to { opacity: 0; transform: scale(0.94); }
}

@keyframes dvMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes dvMaskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* 关闭叉（右上角，浮于头部之上） */
.decision-view__close {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* ── 固定头部 ── */
.decision-view__header {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 36rpx 20rpx;
}

.decision-view__report {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--ts-text-sub);
  padding: 8rpx 0 8rpx 16rpx;
}

.decision-view__title {
  font-size: 34rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
}

/* ── 可滚动主体：决策内容 ──
   关键：scroll-view 必须自身有确定高度才能内部滚动。用 max-height 直接给它高度上限：
   内容少→自然高（面板贴合）；内容多→卡在 max-height 并内部滚动（不能靠 flex:1，
   自适应高度的 flex 容器里 flex-grow 拿不到确定高，会导致展开后溢出压底）。 */
.decision-view__body {
  flex: 0 0 auto;
  max-height: 60vh;
  width: 100%;
  box-sizing: border-box;
  /* 滚动容器自身不留左右 padding，否则滚动条会被内边距挤离弹窗边缘；横向内缩交给内层 */
  padding: 0;
}

/* 内层包裹：承担正文区左右 36rpx 内缩（与固定头/底对齐） */
.decision-view__body-inner {
  padding: 4rpx 36rpx;
}

.decision-view__author {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.decision-view__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--ts-fill-thumb);
  margin-right: 14rpx;
  flex-shrink: 0;
}

/* 无头像回退：昵称首字圆形徒章 */
.decision-view__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ts-tag-bg);
  color: var(--ts-brand);
  font-size: 26rpx;
  font-weight: var(--font-weight-6);
  line-height: 1;
}

.decision-view__author-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.decision-view__name {
  font-size: 24rpx;
  color: var(--ts-text);
  font-weight: var(--font-weight-6);
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.decision-view__time {
  font-size: 20rpx;
  color: var(--ts-text-sub);
  margin-top: 2rpx;
}

.decision-view__c-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ts-text);
  line-height: 1.4;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.decision-view__c-content {
  font-size: 26rpx;
  color: var(--ts-text);
  opacity: 0.85;
  line-height: 1.6;
  margin-bottom: 20rpx;
  word-break: break-all;
}

/* 正文包裹层：为隐藏测量克隆提供定位基准（= 正文可用宽度）。
   overflow:hidden 必须：把绝对定位克隆（全文高、visibility:hidden 仍占布局）的溢出就地裁掉，
   否则其高度会向上传播到 scroll-view，导致正文未展开时也可滚动；克隆自身布局高度不变，仍可测。 */
.decision-view__content-wrap {
  position: relative;
  overflow: hidden;
}

/* 测量专用克隆：复用正文样式但不加 .e-2（不钳制、自然撑到全文高），
   绝对定位 + left/right:0 与正文等宽，visibility 隐藏不影响布局 */
.decision-view__measure {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  margin-bottom: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: -1;
  white-space: normal;
}

/* 展开/收起（靠右） */
.decision-view__expand {
  font-size: 24rpx;
  color: var(--ts-brand);
  font-weight: var(--font-weight-5);
  text-align: right;
  margin-bottom: 20rpx;
}

/* 标签 */
.decision-view__tags {
  display: flex;
  flex-wrap: wrap;
  grid-gap: 12rpx;
  margin-bottom: 20rpx;
}

.decision-view__tag {
  font-size: 22rpx;
  color: var(--ts-brand);
  background: var(--ts-fill);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.decision-view__images {
  display: flex;
  flex-wrap: wrap;
  grid-gap: 12rpx;
  margin-bottom: 20rpx;
}

.decision-view__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--ts-fill-thumb);
}

.decision-view__foot {
  padding-bottom: 8rpx;
}

.decision-view__progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--ts-text-sub);
  margin-bottom: 8rpx;
}

.decision-view__track {
  height: 8rpx;
  background: var(--ts-tag-bg);
  border-radius: 999rpx;
  overflow: hidden;
}

.decision-view__fill {
  height: 100%;
  background: var(--ts-primary);
  border-radius: 999rpx;
}

/* 结束条件（满员/到时）次要提示行 */
.decision-view__end {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ts-text-sub);
}

/* ── 固定底部：仅选项按钮（点选项弹评议表单） ── */
.decision-view__footer {
  z-index: 10;
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 36rpx 36rpx;
  border-top: 1rpx solid var(--ts-line);
}

.decision-view__options {
  display: flex;
  flex-wrap: wrap;
  grid-gap: 16rpx;
}

.decision-view__option {
  flex: 1;
  min-width: 200rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--ts-line);
  font-size: 24rpx;
  text-align: center;
  color: var(--ts-brand);
  background: var(--ts-tag-bg);
  box-sizing: border-box;
}

.decision-view__option:active {
  opacity: 0.85;
}

/* 「换一个」：选项下方的居中次要文字按钮（图标 + 文字横排） */
.decision-view__shuffle {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  grid-gap: 8rpx;
  font-size: 26rpx;
  color: var(--ts-text-sub);
}

.decision-view__shuffle-text {
  line-height: 1;
}

.decision-view__shuffle:active {
  opacity: 0.6;
}
