page {
  background: var(--ts-bg);
}

.mine {
  padding: 24rpx 28rpx 40rpx;
}

/* ===== 居中个人信息头 ===== */
.mine__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 32rpx 0 40rpx;
}

.mine__avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--ts-tag-bg);
  border: 3rpx solid var(--ts-line-dash);
  flex-shrink: 0;
}

.mine__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ts-brand);
  font-size: 56rpx;
  font-weight: var(--font-weight-6);
  line-height: 1;
}

.mine__nick-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.mine__nick {
  max-width: 480rpx;
  font-size: 36rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  letter-spacing: 1rpx;
}

.mine__days {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ts-text-sub);
}

/* ===== 统计卡（对齐 UI：三列网格 + 竖分隔线） ===== */
.mine__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  box-shadow: var(--ts-shadow);
  padding: 28rpx 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.mine__stat {
  border-right: 1rpx solid var(--ts-line-weak);
}

.mine__stat:last-child {
  border-right: none;
}

.mine__stat-num {
  font-size: 40rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-brand);
  margin-bottom: 4rpx;
}

.mine__stat-label {
  font-size: 22rpx;
  color: var(--ts-text-sub);
}

/* ===== 通用卡片（记录宫格容器） ===== */
.mine__card {
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  box-shadow: var(--ts-shadow);
  padding: 28rpx 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.mine__grid {
  display: flex;
}

.mine__grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.mine__grid-item:active .mine__grid-icon {
  background: var(--ts-fill-blue);
}

.mine__grid-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--ts-tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine__grid-label {
  font-size: 22rpx;
  color: var(--ts-text);
}

/* ===== 设置行卡 ===== */
.mine__group {
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  box-shadow: var(--ts-shadow);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.mine__cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--ts-line-weak);
}

.mine__cell:last-child {
  border-bottom: none;
}

.mine__cell:active {
  background: var(--ts-fill-blue);
}

/* 微信客服按钮：重置 button 默认样式，与普通行卡对齐 */
.mine__contact {
  width: 100% !important;
  margin: 0;
  font-size: 28rpx;
  line-height: normal;
  color: var(--ts-text);
  background: transparent;
  border: none;
  border-radius: 0;
  text-align: left;
}

.mine__contact::after {
  border: none;
}

.mine__cell-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mine__cell-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--ts-tag-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mine__cell-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ts-text);
}

.mine__cell-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ts-text-sub);
  font-size: 24rpx;
}

