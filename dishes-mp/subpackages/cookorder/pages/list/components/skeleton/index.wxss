/* Tab 栏 */
.skeleton__tab-bar {
  display: flex;
  padding: 20rpx 32rpx;
  gap: 20rpx;
}
.skeleton__block--tab {
  flex: 1;
  height: 52rpx;
  border-radius: 12rpx;
}

/* 骨架块基础 */
.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}

/* 订单卡片 */
.skeleton__card {
  margin: 0 32rpx 20rpx;
  padding: 24rpx 32rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  border: 1rpx solid #E5DBD0;
}

/* 头部 */
.skeleton__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #EDE4D8;
}
.skeleton__block--title {
  width: 200rpx;
  height: 26rpx;
}
.skeleton__block--status {
  width: 80rpx;
  height: 32rpx;
  border-radius: 8rpx;
}

/* 菜谱 */
.skeleton__dishes {
  padding: 12rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.skeleton__block--dish {
  width: 140rpx;
  height: 24rpx;
}

/* 底部 */
.skeleton__foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx dashed #EDE4D8;
}
.skeleton__block--time {
  width: 80rpx;
  height: 20rpx;
}
.skeleton__block--action {
  width: 100rpx;
  height: 24rpx;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
