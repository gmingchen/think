<popup show="{{ visible }}" title="{{ dish.name }}" bind:close="onClose">
  <view class="dish__photo" wx:if="{{ dish }}" catch:tap="onPreviewCover">
    <image wx:if="{{ !isDefaultCover }}" src="{{ gallery[0] }}" mode="aspectFill" class="dish__photo-img" />
    <image wx:else src="{{ DEFAULT_DISH_COVER }}" mode="aspectFit" class="dish__photo-img" />
  </view>
  <view class="dish__name" wx:if="{{ dish }}">{{ dish.name }}</view>
  <view class="dish__meta" wx:if="{{ dish }}">
    <text>{{ dish.cookCount }}次 · </text>
    <van-rate value="{{ dish.rating }}" color="#E8A87C" void-color="#D8CCBE" size="12px" readonly />
  </view>
  <!-- 传播动作（贴图/分享） -->
  <view class="dish__actions" wx:if="{{ dish }}">
    <view class="dish__action-btn dish__action-btn--sticker" wx:if="{{ canPostOfficial }}" bind:tap="onSticker">
      <view class="dish__sticker-badge">NEW</view>
      <iconfont name="sticker" size="30" color="#E8A87C" />
    </view>
    <button class="dish__action-btn" open-type="share" hover-class="none"
      data-type="recipe" data-id="{{ dish.id }}" data-name="{{ dish.name }}" data-cover="{{ dish.photo }}">
      <iconfont name="share" size="30" color="#8C7E72" />
    </button>
  </view>
  <view class="dish__remark" wx:if="{{ dish && dish.remark }}">
    <text class="dish__sub-title">📝 备注：</text>
    <text>{{ dish.remark }}</text>
  </view>
  <view class="dish__ingredients" wx:if="{{ dish && dish.ingredients.length }}">
    <text class="dish__sub-title">用料手记：</text>
    <view class="dish__tags">
      <text class="dish__tag" wx:for="{{ dish.ingredients }}" wx:key="*this">{{ item }}</text>
    </view>
  </view>
  <view class="dish__steps" wx:if="{{ dish && dish.steps.length }}">
    <text class="dish__sub-title">掌勺叮嘱：</text>
    <text wx:for="{{ dish.steps }}" wx:key="*this">{{ index + 1 }}. {{ item }}</text>
  </view>
  <!-- 底部按钮放在 footer 插槽，不随详情区滚动 -->
  <view class="btn--primary dish__btn" slot="footer" wx:if="{{ useAdd && dish }}" bind:tap="onAdd">+ 点这道</view>
  <view class="dish__link" slot="footer" wx:if="{{ dish }}" bind:tap="onDetail">查看完整菜谱 <iconfont name="arrow-right" size="22" color="#8C7E72" /></view>
</popup>
