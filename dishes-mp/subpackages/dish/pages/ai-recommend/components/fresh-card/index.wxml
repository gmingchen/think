<view class="fresh-card" bind:tap="onCardTap">
  <text class="fresh-card__stamp">AI 原生灵感</text>

  <text class="fresh-card__name">🌿 {{ fresh.name }}</text>
  <text wx:if="{{ fresh.hint }}" class="fresh-card__hint">{{ fresh.hint }}</text>

  <view class="fresh-card__meta">
    <view wx:if="{{ foodText }}" class="fresh-card__meta-row">
      <text class="fresh-card__meta-key">• 食材配比：</text>
      <text class="fresh-card__meta-val">{{ foodText }}</text>
    </view>
    <view wx:if="{{ seasoningText }}" class="fresh-card__meta-row">
      <text class="fresh-card__meta-key">• 提味佐料：</text>
      <text class="fresh-card__meta-val">{{ seasoningText }}</text>
    </view>
  </view>

  <view class="fresh-card__steps">
    <text class="fresh-card__steps-title">步骤摘要：</text>
    <view
      wx:for="{{ fresh.steps }}"
      wx:key="*this"
      wx:if="{{ expanded || index < previewCount }}"
      class="fresh-card__step"
    >{{ index + 1 }}. {{ item }}</view>
    <view wx:if="{{ !expanded && fresh.steps.length > previewCount }}" class="fresh-card__step-toggle" catch:tap="onToggleSteps">展开看全文 <iconfont class="fresh-card__step-toggle-icon" name="arrow-bottom" size="22" color="#C86D51" /></view>
    <view wx:if="{{ expanded }}" class="fresh-card__step-toggle" catch:tap="onToggleSteps">收起步骤 <iconfont class="fresh-card__step-toggle-icon" name="arrow-top" size="22" color="#C86D51" /></view>
  </view>

  <view class="fresh-card__foot">
    <text class="fresh-card__foot-tip">{{ fresh.adopted ? '点击查看菜谱详情' : '采纳后自动存入厨房菜谱库' }}</text>
    <view
      class="fresh-card__adopt {{ fresh.adopted ? 'fresh-card__adopt--done' : '' }}"
      catch:tap="onAdopt"
    >{{ fresh.adopted ? '✓ 已采纳' : '📥 采纳' }}</view>
  </view>
</view>
