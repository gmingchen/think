/* 群核心资料卡（detail 页私有组件） */
:host {
  display: block;
}

.info {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  box-shadow: var(--ts-shadow);
}

.info__hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.info__avatar {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ts-brand);
  background: var(--ts-tag-bg);
  border-radius: 28rpx;
  /* 隔离组件取不到全局 .font-serif，衬线就近声明 */
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
}

.info__info {
  flex: 1;
  min-width: 0;
}

.info__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info__name {
  font-size: 32rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  min-width: 0;
  /* 隔离组件取不到全局 .font-serif / .e，就近内联衬线 + 单行省略 */
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 编辑按钮：iconfont（name=edit）外套方块浅蓝背景 */
.info__edit-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  background: var(--ts-tag-bg);
  border-radius: 12rpx;
}

.info__role-line {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.info__role {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.info__role--owner {
  font-weight: 600;
  color: var(--ts-seal);
  background: var(--ts-seal-bg);
  border: 1rpx solid rgba(178, 60, 46, 0.2);
}

.info__role--member {
  color: var(--ts-brand);
  background: var(--ts-tag-bg);
}

.info__role--dissolved {
  color: var(--ts-text-sub);
  background: var(--ts-dissolved-bg);
}

.info__role-sep {
  margin: 0 12rpx;
  color: var(--ts-text-sub);
}

.info__role-count {
  color: var(--ts-brand);
}

.info__role-arrow {
  margin-left: 6rpx;
}

/* 操作按钮行：邀请（全员）/ 解散（群主）/ 退出（成员） */
.info__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.info__action {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: var(--font-weight-5);
  border-radius: var(--ts-radius-pill);
}

.info__action:active {
  opacity: .9;
}

.info__action--primary {
  color: #FFFFFF;
  background: var(--ts-primary);
  box-shadow: var(--ts-shadow-btn);
}

.info__action--danger {
  color: var(--ts-seal);
  background: var(--ts-seal-bg);
}
