.privacy__content {
  padding: 32rpx;
}
.privacy__title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--font-color);
  display: block;
  text-align: center;
  margin-bottom: 16rpx;
}
.privacy__update-time {
  font-size: 24rpx;
  color: var(--font-color-sub);
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}
.privacy__section {
  margin-bottom: 32rpx;
}
.privacy__section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--font-color);
  display: block;
  margin-bottom: 12rpx;
}
.privacy__text {
  font-size: 26rpx;
  color: var(--font-color);
  line-height: 1.8;
  display: block;
}
