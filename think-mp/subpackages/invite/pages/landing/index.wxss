.il {
  padding: 80rpx 32rpx 48rpx;
  text-align: center;
}

/* 品牌冠部 */
.il__brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.il__brand-name {
  font-size: 48rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  letter-spacing: 8rpx;
}

.il__brand-slogan {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ts-text-sub);
  letter-spacing: 2rpx;
}

/* 邀请信息卡 */
.il__card {
  padding: 48rpx 40rpx;
  background: var(--ts-card);
  border-radius: 40rpx;
  box-shadow: var(--ts-shadow);
}

.il__lead {
  font-size: 34rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  margin-bottom: 20rpx;
}

.il__desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ts-text-sub);
  margin-bottom: 40rpx;
}

.il__code {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 40rpx;
  background: var(--ts-tag-bg);
  border-radius: 20rpx;
}

.il__code-label {
  font-size: 24rpx;
  color: var(--ts-text-sub);
}

.il__code-value {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--ts-brand);
}

.il__privacy {
  padding: 16rpx 20rpx;
  margin-bottom: 40rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ts-brand);
  text-align: left;
  background: var(--ts-tag-bg);
  border-radius: 16rpx;
}

.il__join {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  grid-gap: 12rpx;
  font-size: 28rpx;
  font-weight: var(--font-weight-5);
  color: #FFFFFF;
  background: var(--ts-primary);
  border-radius: var(--ts-radius-pill);
  box-shadow: var(--ts-shadow-btn);
}

.il__join--disabled {
  opacity: 0.6;
}

.il__join-seal {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ts-seal);
}

.il__home {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: var(--font-weight-5);
  color: var(--ts-text);
  background: var(--ts-card);
  border: 2rpx solid var(--ts-line-dash);
  border-radius: var(--ts-radius-pill);
}

.il__footer {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: var(--ts-text-sub);
}
