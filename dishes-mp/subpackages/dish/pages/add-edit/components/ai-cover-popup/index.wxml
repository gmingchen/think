<popup
  show="{{ visible }}"
  title="AI 生成封面"
  subtitle="{{ status === 'ready' ? ('⚠️ ' + AI_DISCLAIMER_TEXT) : ('今日还可生成 ' + remainCount + ' 张') }}"
  bind:close="onClose">

  <view class="ai-cover__body">
    <!-- 生图中：骨架占位 + 耗时预期文案 -->
    <view wx:if="{{ status === 'loading' }}" class="ai-cover__loading">
      <view class="ai-cover__spinner"></view>
      <view class="ai-cover__loading-text">AI 正在为您构思封面…</view>
      <view class="ai-cover__loading-sub">预计 15～30 秒，稍候片刻</view>
    </view>

    <!-- 预览态：本地临时文件直接展示（右下角已含混元合规水印） -->
    <image
      wx:elif="{{ status === 'ready' }}"
      class="ai-cover__img"
      src="{{ tempPath }}"
      mode="aspectFit" />

    <!-- 失败态：后端已返还额度，可重试 -->
    <view wx:else class="ai-cover__error">
      <view class="ai-cover__error-text">生成失败</view>
      <view class="ai-cover__error-sub">本次额度已返还，可点「重试」再试一次</view>
    </view>
  </view>

  <!-- 底部操作区：footer 插槽固定吸底（对齐 ai-parse-popup） -->
  <view class="ai-cover__actions" slot="footer">
    <view class="ai-cover__cancel" catch:tap="onClose">{{ status === 'ready' ? '取消' : '关闭' }}</view>
    <view wx:if="{{ status === 'ready' }}" class="ai-cover__ghost" catch:tap="onRegenerate">重生成</view>
    <view wx:if="{{ status === 'error' }}" class="ai-cover__ghost" catch:tap="onRegenerate">重试</view>
    <view wx:if="{{ status === 'ready' }}" class="ai-cover__confirm {{ uploading ? 'ai-cover__confirm--disabled' : '' }}" catch:tap="onUse">使用这张</view>
  </view>
</popup>
