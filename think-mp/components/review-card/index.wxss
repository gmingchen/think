/* ===== review-card：评议中专用信息流卡（广场 / 群详情） ===== */
.review-card {
  position: relative;
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  box-shadow: var(--ts-shadow);
  padding: 32rpx;
  box-sizing: border-box;
}

/* 作者行：头像（左） + 昵称/时间（右） */
.review-card__author {
  margin-bottom: 20rpx;
  min-width: 0;
}

.review-card__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--ts-fill-thumb);
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 无头像回退：昵称首字圆形徒章 */
.review-card__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ts-tag-bg);
  color: var(--ts-brand);
  font-size: 28rpx;
  font-weight: var(--font-weight-6);
  line-height: 1;
}

.review-card__author-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.review-card__name {
  font-size: 26rpx;
  color: var(--ts-text);
  font-weight: var(--font-weight-6);
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.review-card__time {
  font-size: 22rpx;
  color: var(--ts-text-sub);
  margin-top: 4rpx;
}

.review-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ts-text);
  line-height: 1.4;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.review-card__content {
  font-size: 26rpx;
  color: var(--ts-text);
  opacity: 0.85;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

/* 测量专用克隆：复用正文样式但不加 .e-2（不钳制、自然撑到全文高），
   绝对定位 + 左右内缩 32rpx 与正文等宽，visibility 隐藏不影响布局 */
.review-card__measure {
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  margin-bottom: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: -1;
  white-space: normal;
}

.review-card__expand {
  font-size: 24rpx;
  color: var(--ts-brand);
  font-weight: var(--font-weight-5);
  margin-bottom: 20rpx;
  /* 折叠/展开按钮靠右（view 默认块级，text-align 即右对齐文字） */
  text-align: right;
}

.review-card__images {
  grid-gap: 12rpx;
  margin-bottom: 24rpx;
}

.review-card__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: var(--ts-fill-thumb);
}

.review-card__tags {
  grid-gap: 12rpx;
  margin-bottom: 20rpx;
}

.review-card__tag {
  font-size: 22rpx;
  color: var(--ts-brand);
  background: var(--ts-fill);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.review-card__foot {
  margin-top: 16rpx;
}

.review-card__progress-label {
  font-size: 22rpx;
  color: var(--ts-text-sub);
  margin-bottom: 8rpx;
}

.review-card__track {
  height: 8rpx;
  background: var(--ts-tag-bg);
  border-radius: 999rpx;
  overflow: hidden;
}

.review-card__fill {
  height: 100%;
  background: var(--ts-primary);
  border-radius: 999rpx;
}

/* 结束条件（满员/到时）次要提示行 */
.review-card__end {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ts-text-sub);
}

/* 选项按钮 */
.review-card__options {
  grid-gap: 16rpx;
  margin-top: 24rpx;
}

.review-card__option {
  /* 等宽等高、每行最多 2 枚（不足自动拉平），构成均衡的选项网格 */
  flex: 1 1 calc(50% - 8rpx);
  min-width: calc(50% - 8rpx);
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--ts-brand);
  background: var(--ts-tag-bg);
  border-radius: var(--ts-radius-pill);
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.review-card__option:active {
  opacity: 0.85;
}
