page {
  background: var(--ts-bg);
}

.rc {
  padding: 24rpx 28rpx 8rpx;
}

.rc__loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ts-text-sub);
}

/* 白底卡片 */
.rc__card {
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: var(--ts-card);
  border-radius: var(--ts-radius);
  box-shadow: var(--ts-shadow);
}

.rc__card--mirror {
  border: 2rpx solid var(--ts-line);
  box-shadow: none;
}

/* 区块标题 */
.rc__section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx dashed var(--ts-line);
}

.rc__section-tag {
  font-size: 22rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-brand);
  letter-spacing: 4rpx;
}

.rc__section-tag--dark {
  color: var(--ts-text);
}

.rc__section-extra {
  font-size: 22rpx;
  color: var(--ts-seal);
}

/* 镜像卡内容 */
.rc__intro-title {
  font-size: 34rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  line-height: 1.4;
}

.rc__intro-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ts-text-sub);
}

/* 对照中轴装饰线 */
.rc__divider {
  display: flex;
  align-items: center;
  justify-content: center;
  grid-gap: 16rpx;
  margin: 8rpx 0 20rpx;
}

.rc__divider-line {
  width: 80rpx;
  height: 1rpx;
  background: var(--ts-line-dash);
}

.rc__divider-text {
  font-size: 20rpx;
  color: var(--ts-text-sub);
  letter-spacing: 2rpx;
}

/* 表单 */
.rc__label {
  margin: 12rpx 0 20rpx;
  font-size: 24rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
}

.rc__choices {
  display: flex;
  flex-wrap: wrap;
  grid-gap: 12rpx;
  margin-bottom: 8rpx;
}

.rc__choice {
  flex: 1;
  min-width: 200rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: var(--ts-text);
  background: var(--ts-card);
  border: 2rpx solid var(--ts-line);
  border-radius: 999rpx;
}

.rc__choice--active {
  color: var(--ts-brand);
  font-weight: var(--font-weight-6);
  background: var(--ts-tag-bg);
  border-color: var(--ts-primary);
}

.rc__textarea {
  width: 100%;
  height: 220rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--ts-text);
  line-height: 1.5;
  background: var(--ts-fill);
  border: 2rpx solid var(--ts-line);
  border-radius: 24rpx;
}

.rc__hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ts-text-sub);
  line-height: 1.5;
}

/* 底部胶囊 */
.rc__bar {
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--ts-card);
  border-top: 1rpx solid var(--ts-line);
}

.rc__save {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  grid-gap: 12rpx;
  font-size: 28rpx;
  font-weight: var(--font-weight-5);
  color: #FFFFFF;
  background: var(--ts-primary);
  border-radius: var(--ts-radius-pill);
  box-shadow: var(--ts-shadow-btn);
}

.rc__save-seal {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ts-seal);
}
