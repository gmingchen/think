/* 骨架屏遮罩 */
.skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #F5F0EB;
  padding: 24rpx 32rpx;
  overflow: hidden;
}

/* 卡片 */
.skeleton__card {
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: #FFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECE3D9;
  box-shadow: 2rpx 6rpx 16rpx rgba(0,0,0,0.06);
}

/* 头部 */
.skeleton__header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

/* 统计格（与真实六格同构：3 列 × 2 行） */
.skeleton__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 12rpx;
  padding: 24rpx 0;
  border-top: 1rpx dashed #ECE3D9;
  border-bottom: 1rpx dashed #ECE3D9;
}
.skeleton__stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

/* 容量行骨架（与真实卡片同构：名称/数量一行，进度条/按钮一行） */
.skeleton__quota {
  margin-bottom: 24rpx;
}
.skeleton__quota-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.skeleton__quota-line {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 菜单项 */
.skeleton__menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}
.skeleton__menu-item + .skeleton__menu-item {
  border-top: 1rpx dashed #ECE3D9;
}

/* 骨架块 */
.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}
.skeleton__block--name {
  width: 200rpx;
  height: 34rpx;
}
.skeleton__block--role {
  width: 100rpx;
  height: 32rpx;
  border-radius: 8rpx;
}
.skeleton__block--stat-value {
  width: 60rpx;
  height: 36rpx;
}
.skeleton__block--stat-label {
  width: 48rpx;
  height: 22rpx;
}
.skeleton__block--menu-text {
  width: 180rpx;
  height: 28rpx;
}
.skeleton__block--menu-arrow {
  width: 40rpx;
  height: 28rpx;
  border-radius: 50%;
}
.skeleton__block--foot {
  width: 320rpx;
  height: 22rpx;
  margin: 20rpx auto 0;
}
.skeleton__block--meter {
  flex: 1;
  height: 12rpx;
  border-radius: 10rpx;
}
.skeleton__block--btn {
  width: 160rpx;
  /* 跟真实按钮同高（字体 24rpx + 上下一对 12rpx padding） */
  height: 56rpx;
  border-radius: 12rpx;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
