/* 骨架屏遮罩 */
.skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  overflow: hidden;
}

/* 骨架块基础 */
.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}

/* 左侧分类栏：宽度与 .recipe__sidebar 保持一致（150rpx + 1rpx 右边框），避免骨架屏与真实列表几何错位 */
.skeleton__sidebar {
  flex-shrink: 0;
  width: 150rpx;
  background: #EDE4D8;
  border-right: 1rpx solid #DED2C4;
  padding-top: 16rpx;
}
.skeleton__tab {
  padding: 24rpx 12rpx;
  text-align: center;
  border-bottom: 1rpx dotted #DED2C4;
}
.skeleton__tab--active {
  background: #F5F0EB;
  border-left: 6rpx solid var(--color-primary);
}
.skeleton__block--tab {
  width: 80%;
  height: 24rpx;
  margin: 0 auto;
}

/* 右侧菜谱列表 */
.skeleton__main {
  flex: 1;
  padding: 24rpx 24rpx 0;
  overflow: hidden;
}
.skeleton__block--title {
  width: 120rpx;
  height: 26rpx;
  margin-bottom: 16rpx;
}

/* 菜谱卡片 */
.skeleton__card {
  display: flex;
  gap: 24rpx;
  background: #FFF;
  border: 1rpx solid #E8DDD0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 2rpx 4rpx 12rpx rgba(0,0,0,0.04);
}
.skeleton__block--photo {
  width: 152rpx;
  height: 152rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.skeleton__card-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}
.skeleton__block--name {
  width: 60%;
  height: 28rpx;
}
.skeleton__block--desc {
  width: 40%;
  height: 22rpx;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
