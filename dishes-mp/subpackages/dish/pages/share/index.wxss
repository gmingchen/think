@import '../../../../common/style/index.wxss';

/* 空态（骨架屏见 components/skeleton） */
.dish-share__empty {
  padding: 200rpx 60rpx;
  text-align: center;
}
.dish-share__empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.dish-share__empty-text {
  font-size: 28rpx;
  color: var(--font-color-sub);
  margin-bottom: 40rpx;
}
.dish-share__empty-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  font-size: 26rpx;
}

/* ===== 1. 拍立得主相片 ===== */
.dish-share__hero {
  padding: 32rpx 28rpx 0;
}
.dish-share__frame {
  position: relative;
  padding: 24rpx 24rpx 28rpx;
  background: #FFFDF9;
  border: 1rpx solid #E3D9CC;
  border-radius: 8rpx;
  box-shadow: 4rpx 8rpx 28rpx rgba(80, 65, 50, 0.12);
  transform: rotate(-0.6deg);
}
.dish-share__photo {
  position: relative;
  width: 100%;
  height: 392rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F8EFE4 0%, #EADDCF 100%);
  border: 1rpx solid #DFD2C3;
  border-radius: 6rpx;
}
.dish-share__photo-img {
  display: block;
  width: 100%;
  height: 100%;
}
.dish-share__photo-tag {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  max-width: 80%;
  padding: 4rpx 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  background: rgba(255, 253, 249, 0.9);
  border: 1rpx dashed var(--color-primary);
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 拍立得题注 */
.dish-share__caption {
  margin-top: 28rpx;
  padding: 0 8rpx;
}
.dish-share__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.dish-share__title {
  flex: 1;
  min-width: 0;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--font-color);
}
.dish-share__stamp {
  flex-shrink: 0;
  margin-top: 6rpx;
  padding: 4rpx 12rpx;
  background: rgba(184, 74, 57, 0.08);
  border: 3rpx solid var(--color-danger);
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--color-danger);
  transform: rotate(4deg);
}

/* 分享者信笺 */
.dish-share__sharer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: #F7EFE6;
  border: 1rpx dashed #DDD0C1;
  border-radius: 16rpx;
}
.dish-share__avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  background: #FFF;
  border: 3rpx solid var(--color-primary);
  border-radius: 50%;
}
.dish-share__sharer-meta {
  flex: 1;
  min-width: 0;
}
.dish-share__sharer-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.dish-share__sharer-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--font-color);
}
.dish-share__sharer-role {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #8C7E72;
  background: rgba(140, 126, 114, 0.12);
}
.dish-share__sharer-role--1 {
  color: #B79466;
  background: rgba(183, 148, 102, 0.14);
}
.dish-share__sharer-role--2 {
  color: #5B8C6E;
  background: rgba(91, 140, 110, 0.14);
}
.dish-share__sharer-sub {
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 22rpx;
  color: var(--font-color-sub);
}

/* 评价与统计横栏 */
.dish-share__stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #E5DBD0;
}
.dish-share__stats-rate {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dish-share__stats-num {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-accent);
}
.dish-share__stats-badges {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.dish-share__badge {
  padding: 4rpx 14rpx;
  background: #FFF;
  border: 1rpx solid #DFD4C7;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--font-color-sub);
}
.dish-share__badge--hot {
  background: #FFF9F7;
  border-color: #E9D1C8;
  color: var(--color-primary);
}

/* ===== 手账便签卡片通用 ===== */
.dish-share__card {
  margin: 36rpx 28rpx 0;
  padding: 32rpx 28rpx;
}
/* 砖红纸胶带（右上角） */
.dish-share__tape--red {
  position: absolute;
  top: -14rpx;
  right: 24rpx;
  width: 96rpx;
  height: 32rpx;
  background: rgba(200, 109, 81, 0.4);
  transform: rotate(4deg);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  clip-path: polygon(4% 0%, 96% 0%, 100% 100%, 0% 100%);
}
.dish-share__section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.dish-share__section-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.dish-share__section-icon {
  font-size: 30rpx;
  color: var(--color-primary);
}
.dish-share__section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--font-color);
}
.dish-share__section-hint {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--font-color-weak);
}

/* ===== 2. 食材清单（紧凑标签流） ===== */
.dish-share__foods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.dish-share__food {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  max-width: 100%;
  padding: 12rpx 20rpx;
  background: #FFF;
  border: 1rpx dashed #E5DBD0;
  border-radius: 999rpx;
}
.dish-share__food-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--font-color);
}
.dish-share__food-amount {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.dish-share__food-process {
  font-size: 20rpx;
  color: var(--font-color-sub);
}

/* ===== 3. 调料清单（紧凑标签流） ===== */
.dish-share__seasonings {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.dish-share__seasoning {
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  max-width: 100%;
  padding: 12rpx 20rpx;
  background: #FFF;
  border: 1rpx solid #E6DCD1;
  border-radius: 999rpx;
}
.dish-share__seasoning-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--font-color);
}
.dish-share__seasoning-amount {
  padding: 2rpx 12rpx;
  background: #FAF1E8;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* ===== 4. 步骤时间线 ===== */
.dish-share__steps {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.dish-share__steps::before {
  content: '';
  position: absolute;
  top: 28rpx;
  bottom: 40rpx;
  left: 26rpx;
  width: 4rpx;
  background: repeating-linear-gradient(to bottom, #D7CBBF 0, #D7CBBF 8rpx, transparent 8rpx, transparent 16rpx);
}
.dish-share__step {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 24rpx;
}
.dish-share__step-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 4rpx solid var(--color-primary);
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-primary);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}
.dish-share__step-box {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx;
  background: #FFF;
  border: 1rpx solid #E5DCD2;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--font-color);
}

/* ===== 5. 小贴士便签纸 ===== */
.dish-share__memo {
  position: relative;
  margin: 36rpx 28rpx 0;
  padding: 32rpx 28rpx;
  background: #FEF9EB;
  border: 1rpx dashed #E0C895;
  border-radius: 16rpx;
  box-shadow: 4rpx 8rpx 20rpx rgba(180, 150, 90, 0.08);
}
.dish-share__memo-title {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5D4427;
}
.dish-share__memo-item {
  position: relative;
  margin-bottom: 12rpx;
  padding-left: 28rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #614D32;
}
.dish-share__memo-item:last-child {
  margin-bottom: 0;
}
.dish-share__memo-item::before {
  content: '★';
  position: absolute;
  left: 0;
  top: 0;
  font-size: 22rpx;
  color: var(--color-accent);
}

/* ===== 尾部品牌标印 ===== */
.dish-share__brand {
  padding: 44rpx 40rpx 20rpx;
  text-align: center;
}
.dish-share__brand-slogan {
  font-size: 22rpx;
  color: var(--font-color-sub);
}
.dish-share__brand-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--font-color-weak);
}

/* 底部间距 */
.dish-share__bottom-spacer {
  height: 32rpx;
}

/* Banner 广告：置于主食材卡片上方，左右间距由页面侧 p_h-28 包裹承担；与 hero 拉开 32rpx，下方卡片自带 36rpx margin-top 自然留白 */
.page__ad {
  margin: 32rpx 0 0;
}

/* ===== 底部吸底操作栏 ===== */
/* 按 v2 文档约定，落地页不放「分享」按钮，不刻意引导二次传播 */
.dish-share__footer {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(250, 245, 238, 0.96);
  border-top: var(--border);
  box-shadow: 0 -8rpx 36rpx rgba(90, 70, 50, 0.06);
}
.dish-share__collect {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #CF7459 0%, #B8583D 100%);
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFF;
  box-shadow: 0 8rpx 24rpx rgba(200, 109, 81, 0.38), inset 0 2rpx 0 rgba(255, 255, 255, 0.3);
}
.dish-share__collect.is-collected {
  background: linear-gradient(135deg, #688B58 0%, #527543 100%);
  box-shadow: 0 8rpx 24rpx rgba(104, 139, 88, 0.32);
}
.dish-share__collect.is-disabled {
  opacity: 0.7;
}
.dish-share__collect-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dish-share__collect-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  background: rgba(0, 0, 0, 0.18);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* ===== 厨房选择抽屉 ===== */
.dish-share__drawer {
  padding: 8rpx 32rpx 0;
}
.dish-share__drawer-desc {
  margin-bottom: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--font-color-sub);
}
.dish-share__drawer-list {
  max-height: 40vh;
}
.dish-share__kitchen {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  background: #FFF;
  border: 3rpx solid #E5DBD0;
  border-radius: 20rpx;
}
.dish-share__kitchen.is-selected {
  background: #FFFDF9;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(200, 109, 81, 0.12);
}
.dish-share__kitchen.is-collected {
  opacity: 0.55;
}
.dish-share__kitchen-info {
  flex: 1;
  min-width: 0;
}
.dish-share__kitchen-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.dish-share__kitchen-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--font-color);
}
.dish-share__kitchen-role {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #8C7E72;
  background: rgba(140, 126, 114, 0.12);
}
.dish-share__kitchen-role--1 {
  color: #B79466;
  background: rgba(183, 148, 102, 0.12);
}
.dish-share__kitchen-role--2 {
  color: #5B8C6E;
  background: rgba(91, 140, 110, 0.12);
}
.dish-share__kitchen-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--font-color-sub);
}
.dish-share__kitchen-done {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-secondary);
}
.dish-share__radio {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 4rpx solid #D1C5B8;
  border-radius: 50%;
}
.dish-share__kitchen.is-selected .dish-share__radio {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.dish-share__kitchen.is-selected .dish-share__radio::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  background: #FFF;
  border-radius: 50%;
}
.dish-share__drawer-rules {
  margin-bottom: 28rpx;
  padding: 20rpx 24rpx;
  background: #FFFDF9;
  border: 1rpx dashed #DDD2C4;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--font-color-sub);
}
.dish-share__rules-title {
  margin-bottom: 6rpx;
  font-weight: 700;
  color: var(--font-color);
}
.dish-share__drawer-btn {
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: bold;
}
.dish-share__drawer-btn.is-disabled {
  opacity: 0.5;
}
