
.guide__header {
  flex-shrink: 0;
  text-align: center;
  padding: 0 40rpx 24rpx;
  border-bottom: var(--border-dashed);
}
.guide__title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--font-color);
}
.guide__subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--font-color-sub);
  margin-top: 8rpx;
}
.guide__section {
  margin-top: 28rpx;
  padding: 0 40rpx;
}
.guide__section:last-child {
  padding-bottom: 40rpx;
}
.guide__label {
  display: block;
  font-size: 24rpx;
  color: var(--font-color-sub);
  text-align: center;
  margin-bottom: 16rpx;
}
.guide__group {
  margin-bottom: 20rpx;
}
.guide__group-title {
  display: block;
  font-size: 22rpx;
  color: var(--color-primary);
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}
.guide__options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.guide__option {
  font-size: 22rpx;
  color: var(--font-color);
  background: #FFF;
  border: 1rpx solid #E0D4C5;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}
.guide__option--active {
  background: var(--color-primary);
  color: #FFF;
  border-color: var(--color-primary);
}
.guide__footer {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx 0;
  border-top: var(--border-dashed);
}
.guide__skip {
  font-size: 26rpx;
  color: var(--font-color-sub);
}
.guide__confirm {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}
