<van-popup
  show="{{ show }}"
  position="bottom"
  round
  closeable
  safe-area-inset-bottom
  custom-style="max-height: 88vh; border-radius: 32rpx 32rpx 0 0;"
  bind:close="onClose"
>
  <view class="ts-review-popup">
    <view class="ts-review-popup__title font-serif">填写你的评议</view>

    <!-- 未评议锁定提示 -->
    <view class="ts-review-popup__locked">🔒 提交评议后即可解锁其他人的观点</view>

    <!-- 第一步：倾向备选项 -->
    <view class="ts-review-popup__label">第一步：选择你的建议倾向</view>
    <view class="ts-review-popup__options">
      <view
        wx:for="{{ options }}"
        wx:key="index"
        class="ts-review-popup__option {{ selected === index ? 'ts-review-popup__option--active' : '' }}"
        data-index="{{ index }}"
        bindtap="onSelectOption"
      >{{ item.label }}</view>
    </view>

    <!-- 第二步：三思结构化引导 -->
    <view class="ts-review-popup__label">第二步：从三思角度给建议</view>
    <view class="ts-review-popup__hints">
      <view wx:for="{{ angles }}" wx:key="value" class="ts-review-popup__hint">
        <text class="ts-review-popup__hint-tag">{{ item.label }}</text>
        <text class="ts-review-popup__hint-text">{{ item.hint }}</text>
      </view>
    </view>

    <!-- 观点输入 -->
    <textarea
      class="ts-review-popup__textarea"
      value="{{ content }}"
      placeholder="写下你的严谨推演（建议结合思危/思退/思变其一展开）…"
      maxlength="500"
      bindinput="onInputContent"
    />

    <!-- 提交 -->
    <view class="ts-review-popup__submit" bindtap="onSubmit">
      <text>提交深思评议</text>
      <view class="ts-review-popup__seal"></view>
    </view>
  </view>
</van-popup>
