<view class="user" bind:tap="onTap">
  <image class="user__avatar" src="{{ user.avatar || defaultAvatar }}" mode="aspectFill" />
  <view class="user__info">
    <view class="user__name-row">
      <text class="user__name">{{ user.nickname || '未登录' }}</text>
      <!-- 会员角标（§4 入口 2）：纯展示，不可单独点（整行仍是进编辑资料） -->
      <text wx:if="{{ memberBadge }}" class="user__badge">👑 {{ memberBadge }}</text>
      <text class="user__tip">点击编辑资料</text>
    </view>
    <!-- 「加入 · 第 N 天」：用户级数据（user.createdAt），旧版本快照无此字段时整行不渲染 -->
    <text wx:if="{{ joinLabel }}" class="user__join">{{ joinLabel }}</text>
  </view>
</view>
