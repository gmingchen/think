.skeleton {
  padding: 16rpx 32rpx 0;
}

.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}

/* 时段标签 */
.skeleton__section-tag {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 24rpx;
}
.skeleton__block--section {
  width: 160rpx;
  height: 28rpx;
}

/* 卡片 */
.skeleton__card {
  background: #FFFDF9;
  border: 2rpx dashed #E8DDD0;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}

/* 人物分区 */
.skeleton__person {
  padding: 8rpx 0;
}
.skeleton__divider {
  border-top: 1rpx dashed #E8DDD0;
  margin: 16rpx 0;
}
.skeleton__person-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #E8DDD0;
  margin-bottom: 12rpx;
}
.skeleton__block--name {
  width: 80rpx;
  height: 24rpx;
}
.skeleton__block--tag {
  width: 72rpx;
  height: 28rpx;
  border-radius: 8rpx;
}
.skeleton__block--status {
  width: 96rpx;
  height: 22rpx;
  margin-left: auto;
}

/* 菜谱行 */
.skeleton__dish {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}
.skeleton__block--cover {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.skeleton__block--dish-name {
  flex: 1;
  height: 24rpx;
}
.skeleton__block--qty {
  width: 48rpx;
  height: 22rpx;
  flex-shrink: 0;
}

/* 按钮 */
.skeleton__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}
.skeleton__block--btn {
  width: 160rpx;
  height: 48rpx;
  border-radius: 8rpx;
}
.skeleton__block--btn-short {
  width: 80rpx;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
