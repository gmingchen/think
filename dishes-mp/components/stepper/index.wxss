.stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.stepper__btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6EDE4;
  border-radius: 8rpx;
}
.stepper__btn--add {
  background: var(--color-primary);
}
.stepper__btn--disabled {
  opacity: 0.4;
}
.stepper__value {
  font-size: 28rpx;
  color: var(--font-color);
  min-width: 40rpx;
  text-align: center;
}
