.previewer {
  display: grid;
}
.previewer__item {
  position: relative;
}
.previewer__delete {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--ts-seal-bg);
  border: 2rpx solid var(--ts-card);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
