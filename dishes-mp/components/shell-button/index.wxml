<button
  class="shell-button"
  open-type="{{ openType }}"
  app-parameter="{{ appParameter }}"
  disabled="{{ disabled }}"
  bind:tap="onTap"
  bind:getphonenumber="triggerHandle"
  bind:chooseavatar="triggerHandle"
  bind:contact="triggerHandle"
  bind:opensetting="triggerHandle"
  bind:getrealtimephonenumber="triggerHandle"
  bind:agreeprivacyauthorization="triggerHandle"
  bind:launchapp="triggerHandle"
  binderror="handleError">
  <slot></slot>
</button>
