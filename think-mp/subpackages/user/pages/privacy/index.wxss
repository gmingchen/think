.privacy__content {
  padding: 32rpx;
}
.privacy__title {
  font-size: 36rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
  display: block;
  text-align: center;
  margin-bottom: 16rpx;
}
.privacy__update-time {
  font-size: 24rpx;
  color: var(--ts-text-sub);
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}
.privacy__section {
  margin-bottom: 32rpx;
}
.privacy__section-title {
  font-size: 28rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-brand);
  display: block;
  margin-bottom: 12rpx;
}
.privacy__text {
  font-size: 26rpx;
  color: var(--ts-text);
  line-height: 1.8;
  display: block;
}
