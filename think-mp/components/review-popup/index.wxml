<popup show="{{ visible }}" title="✍️ 评价掌厨人" bind:close="close">
  <!-- 加载中 -->
  <view class="review__loading" wx:if="{{ loading }}">
    <text class="review__loading-text">加载菜谱中...</text>
  </view>

  <!-- 可滚动内容区 -->
  <scroll-view class="review__scroll" scroll-y wx:if="{{ !loading }}">
    <!-- 菜谱评价列表 -->
    <view class="review__dish" wx:for="{{ dishes }}" wx:for-index="dishIndex" wx:for-item="dish" wx:key="dishId">
      <view class="review__dish-header">
        <image class="review__dish-cover" wx:if="{{ dish.cover }}" src="{{ dish.cover }}" mode="aspectFill" />
        <image class="review__dish-cover" wx:else src="{{ DEFAULT_DISH_COVER }}" mode="aspectFit" />
        <text class="review__dish-name">{{ dish.name }}</text>
        <text class="review__dish-qty">× {{ dish.quantity }}</text>
      </view>
      <!-- 星级评分 -->
      <van-rate
        value="{{ dish.rating }}"
        color="#E8A87C"
        void-color="#D8CCBE"
        size="20px"
        data-dish-index="{{ dishIndex }}"
        bind:change="onRating"
      />
      <!-- 评语输入 -->
      <textarea
        class="review__input"
        placeholder="给大厨留一句暖心评语..."
        value="{{ dish.content }}"
        data-dish-index="{{ dishIndex }}"
        bindinput="onContentInput"
      />
    </view>

    <!-- 空状态 -->
    <view class="review__empty" wx:if="{{ !dishes.length }}">
      <text>暂无菜谱</text>
    </view>
  </scroll-view>

  <!-- 提交按钮（固定在底部） -->
  <view class="btn--primary review__btn" wx:if="{{ !loading && dishes.length }}" bind:tap="onSubmit">盖章完成</view>
</popup>
