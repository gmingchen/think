<view class="skeleton">
  <!-- 信息卡片骨架 -->
  <view class="skeleton__card">
    <view class="skeleton__header">
      <view class="skeleton__block skeleton__block--name"></view>
      <view class="skeleton__block skeleton__block--role"></view>
    </view>
    <view class="skeleton__stats">
      <view class="skeleton__stat" wx:for="{{ [1,2,3,4,5,6] }}" wx:key="*this">
        <view class="skeleton__block skeleton__block--stat-value"></view>
        <view class="skeleton__block skeleton__block--stat-label"></view>
      </view>
    </view>
    <view class="skeleton__block skeleton__block--foot"></view>
  </view>
  <!-- 容量扩容卡骨架 -->
  <view class="skeleton__card">
    <view class="skeleton__header">
      <view class="skeleton__block skeleton__block--menu-text"></view>
      <view class="skeleton__block skeleton__block--stat-label"></view>
    </view>
    <view class="skeleton__quota" wx:for="{{ [1,2] }}" wx:key="*this">
      <view class="skeleton__quota-head">
        <view class="skeleton__block skeleton__block--menu-text"></view>
        <view class="skeleton__block skeleton__block--stat-label"></view>
      </view>
      <view class="skeleton__quota-line">
        <view class="skeleton__block skeleton__block--meter"></view>
        <view class="skeleton__block skeleton__block--btn"></view>
      </view>
    </view>
  </view>
  <!-- 菜单列表骨架 -->
  <view class="skeleton__card">
    <view class="skeleton__menu-item" wx:for="{{ [1,2] }}" wx:key="*this">
      <view class="skeleton__block skeleton__block--menu-text"></view>
      <view class="skeleton__block skeleton__block--menu-arrow"></view>
    </view>
  </view>
</view>
