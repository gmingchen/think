/* 会员卡固定槽位：六态共用一套版式，只有文案、火印与按钮色调在变（设计稿 358×104px → 定高 208rpx） */
.member {
  margin: 0 32rpx;
  height: 208rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 纸胶带（设计稿方案 A）：左上角一小条，压在卡片边缘上 */
.member__tape {
  position: absolute;
  top: -16rpx;
  left: 48rpx;
  width: 108rpx;
  height: 32rpx;
  background: var(--tape-yellow);
  transform: rotate(-3deg);
  clip-path: polygon(4% 0%, 96% 0%, 100% 100%, 0% 100%);
}

/* 左侧文案区 */
.member__left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  max-width: 440rpx;
  min-width: 0;
}
.member__left--skeleton {
  gap: 16rpx;
}
.member__title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.member__title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--font-color);
}
/* 价格胶囊：琥珀底 + 深砖红字，与厨房设置页容量标签同一路子（rgba(224,169,79,.28)） */
.member__price {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-primary-deep);
  background: rgba(224, 169, 79, 0.28);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-tag);
}
.member__desc {
  display: block;
  font-size: 22rpx;
  color: var(--font-color-sub);
  line-height: 1.35;
}
.member__note {
  font-size: 20rpx;
  color: var(--font-color-sub);
}
/* 生效 / 临期的小火印：细框 + 微歪，手账盖章的味道 */
.member__stamp {
  font-size: 18rpx;
  font-weight: bold;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
  padding: 0 8rpx;
  border-radius: var(--radius-tag);
  transform: rotate(-3deg);
}
/* 临期的「剩余 N 天」：只在这一处上荧光笔，不加横幅（§1.3 温和不施压） */
.member__urgent {
  background: rgba(224, 169, 79, 0.28);
  color: #8A5D1A;
  padding: 2rpx 8rpx;
  border-radius: var(--radius-tag);
  font-weight: bold;
}

/* 行动按钮：三种色调由 tone + 是否临期推导（见 index.js resolveActionTone） */
.member__btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  white-space: nowrap;
}
.member__btn--primary {
  background: var(--color-primary);
  color: var(--font-color-white);
  box-shadow: 0 4rpx 10rpx rgba(200, 109, 81, 0.35);
}
.member__btn--outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}
.member__btn--disabled {
  background: #E8DFD5;
  color: #A39689;
}

/* 骨架块：与设计稿 skeleton-box 同色同律动 */
.member__sk {
  background: #E9E1D8;
  border-radius: 8rpx;
  animation: member-pulse 1.6s infinite ease-in-out;
}
.member__sk--title { width: 216rpx; height: 32rpx; }
.member__sk--desc { width: 360rpx; height: 24rpx; }
.member__sk--note { width: 260rpx; height: 20rpx; }
.member__sk--btn { width: 136rpx; height: 60rpx; border-radius: 36rpx; }
@keyframes member-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 0.95; }
}

/* ---- 各态微调：只改颜色，不动版式 ---- */
/* gold（生效中 / 临期）：深底身份卡，全站唯一深色块（§4.1 / §10.1 定稿）。
   卡片一旦转深，卡内每一处「用主题色说话」的元素都得跟着反色，
   否则会红底红字（描边按钮）、红底红印（火印）、红底琥珀虚影（胶带与荧光笔），等于这些信息直接消失 */
.member--gold {
  background: var(--color-primary);
  border-color: var(--color-primary-deep);
  box-shadow: 0 6rpx 16rpx rgba(168, 90, 66, 0.28);
}
.member--gold .member__title {
  color: var(--bg-card);
}
.member--gold .member__desc,
.member--gold .member__note {
  color: rgba(250, 246, 240, 0.82);
}
.member--gold .member__tape {
  background: rgba(250, 246, 240, 0.55);
}
.member--gold .member__stamp {
  color: var(--bg-card);
  border-color: var(--bg-card);
}
.member--gold .member__btn--outline {
  color: var(--bg-card);
  border-color: var(--bg-card);
}
.member--gold .member__btn--primary {
  /* 临期态：主色按钮落在同色卡上会整块糊掉，做成浅底深字 */
  background: var(--bg-card);
  color: var(--color-primary);
  box-shadow: none;
}
.member--gold .member__urgent {
  /* 深卡上不用荧光笔底（琥珀压砖红看不出），按 §4.1 把「剩 N 天」直接转 --color-warning */
  background: transparent;
  padding: 0;
  color: var(--color-warning);
}
/* expired：浅卡灰字，不用红色、不用感叹号（已过期不该有羞辱感，但也不能装作没发生） */
.member--expired .member__title,
.member--expired .member__desc {
  color: var(--font-color-sub);
}
