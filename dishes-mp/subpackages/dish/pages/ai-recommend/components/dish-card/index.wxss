.dish-card {
  background: #FFF;
  border: 2rpx solid #E8DDD0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 2rpx 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.dish-card__top {
  display: flex;
  gap: 24rpx;
}

.dish-card__thumb {
  width: 136rpx;
  height: 136rpx;
  background: #F7EFE4;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.dish-card__detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.dish-card__name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-card__name {
  font-size: 28rpx;
  font-weight: bold;
  color: #3D352E;
}

.dish-card__badge {
  font-size: 18rpx;
  background: #FBEBD8;
  color: #C86D51;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: bold;
  border: 2rpx solid rgba(200, 109, 81, 0.4);
}

.dish-card__meta {
  font-size: 20rpx;
  color: #8C7E72;
  margin-top: 4rpx;
}

.dish-card__diff {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
}

.dish-card__diff-have,
.dish-card__diff-lack {
  font-size: 22rpx;
  line-height: 1.6;
}

.dish-card__diff-have {
  color: #688B58;
}

.dish-card__diff-lack {
  color: #B84A39;
}

.dish-card__reason {
  font-size: 22rpx;
  color: #6A5B4F;
  background: #FBF7F0;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin: 16rpx 0;
  line-height: 1.45;
  border-left: 4rpx solid #C86D51;
  font-style: italic;
}

.dish-card__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.dish-card__tip {
  font-size: 22rpx;
  color: #8C7E72;
}

.dish-card__btn {
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.dish-card__btn--solid {
  background: #C86D51;
  color: #FFF;
}

.dish-card__btn:active {
  transform: scale(0.96);
}
