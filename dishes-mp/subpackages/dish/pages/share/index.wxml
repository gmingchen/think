<wxs src="../../../../wxs/index.wxs" module="utils" />

<container use-scroll use-back title="{{ dish.name || '菜谱分享' }}" use-footer="{{ !!dish }}">
  <!-- 骨架屏 -->
  <skeleton wx:if="{{ loading }}" />

  <!-- 菜谱已被删除 -->
  <view wx:elif="{{ notFound }}" class="dish-share__empty">
    <view class="dish-share__empty-icon">🍽️</view>
    <view class="dish-share__empty-text">该菜谱已被删除或不存在</view>
    <view class="btn--primary dish-share__empty-btn" bind:tap="onGoHome">去首页看看</view>
  </view>

  <block wx:elif="{{ dish }}">
    <!-- 1. 拍立得主相片与分享者信笺 -->
    <view class="dish-share__hero">
      <view class="dish-share__frame">
        <view class="zk__tape"></view>

        <view class="dish-share__photo">
          <image class="dish-share__photo-img" src="{{ dish.cover || DEFAULT_DISH_COVER }}" mode="aspectFill" />
          <view class="dish-share__photo-tag">✦ {{ dish.categoryName || '私房手账菜谱' }}</view>
        </view>

        <view class="dish-share__caption">
          <!-- 菜名与印章 -->
          <view class="dish-share__title-row">
            <text class="dish-share__title">{{ dish.name }}</text>
            <text class="dish-share__stamp">私房手录</text>
          </view>

          <!-- 分享者小笺 -->
          <view class="dish-share__sharer" wx:if="{{ sharer }}">
            <image class="dish-share__avatar" src="{{ sharer.avatar }}" mode="aspectFill" />
            <view class="dish-share__sharer-meta">
              <view class="dish-share__sharer-row">
                <text class="dish-share__sharer-name">{{ sharer.nickname }}</text>
                <text class="dish-share__sharer-role dish-share__sharer-role--{{ sharer.role }}" wx:if="{{ sharer.role }}">{{ utils.findEnumLabel(sharer.role, KITCHEN_ROLE_LIST) }}</text>
              </view>
              <view class="dish-share__sharer-sub">🏠 {{ sharer.kitchenName }}{{ dishCount > 0 ? ' · 共 ' + dishCount + ' 道手账菜谱' : '' }}</view>
            </view>
          </view>

          <!-- 评价与被收藏统计（数据为 0 时不展示） -->
          <view class="dish-share__stats" wx:if="{{ dish.rating > 0 || dish.cookCount > 0 || dish.collectCount > 0 }}">
            <view class="dish-share__stats-rate">
              <van-rate wx:if="{{ dish.rating > 0 }}" value="{{ dish.rating }}" color="#E0A94F" void-color="#D8CCBE" size="13px" readonly />
              <text class="dish-share__stats-num" wx:if="{{ dish.rating > 0 }}">{{ dish.rating }}</text>
            </view>
            <view class="dish-share__stats-badges">
              <text class="dish-share__badge" wx:if="{{ dish.cookCount > 0 }}">做过 {{ dish.cookCount }} 次</text>
              <text class="dish-share__badge dish-share__badge--hot" wx:if="{{ dish.collectCount > 0 }}">🔥 被收藏 {{ dish.collectCount }} 次</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Banner 广告：置于拍立得 hero 之后、「用料手记 · 主食材」卡片上方；本页卡片用 margin 36rpx 28rpx，故用 p_h-28 包裹对齐；受 store.ad.enabled 总开关控制，无填充自动隐藏 -->
    <view class="p_h-28">
      <ad-unit ad-unit-id="{{ AD_UNIT_SHARE_BANNER }}" cls="page__ad" />
    </view>

    <!-- 2. 用料手记 · 主食材 -->
    <view class="zk__card dish-share__card" wx:if="{{ foods.length }}">
      <view class="zk__tape--green"></view>
      <view class="dish-share__section">
        <view class="dish-share__section-left">
          <text class="dish-share__section-icon">✎</text>
          <text class="dish-share__section-title">用料手记 · 主食材</text>
        </view>
        <text class="dish-share__section-hint">共 {{ foods.length }} 种</text>
      </view>
      <view class="dish-share__foods">
        <view class="dish-share__food" wx:for="{{ foods }}" wx:key="index">
          <text class="dish-share__food-name">{{ item.name }}</text>
          <text class="dish-share__food-amount" wx:if="{{ item.amount }}">{{ item.amount }}</text>
          <text class="dish-share__food-process" wx:if="{{ item.process }}">· {{ item.process }}</text>
        </view>
      </view>
    </view>

    <!-- 3. 秘制配方 · 调料清单 -->
    <view class="zk__card dish-share__card" wx:if="{{ seasonings.length }}">
      <view class="dish-share__tape--red"></view>
      <view class="dish-share__section">
        <view class="dish-share__section-left">
          <text class="dish-share__section-icon">✎</text>
          <text class="dish-share__section-title">秘制配方 · 调料清单</text>
        </view>
        <text class="dish-share__section-hint">共 {{ seasonings.length }} 味</text>
      </view>
      <view class="dish-share__seasonings">
        <view class="dish-share__seasoning" wx:for="{{ seasonings }}" wx:key="index">
          <text class="dish-share__seasoning-name">{{ item.name }}</text>
          <text class="dish-share__seasoning-amount" wx:if="{{ item.amount }}">{{ item.amount }}</text>
        </view>
      </view>
    </view>

    <!-- 4. 掌勺慢火 · 步骤分解 -->
    <view class="zk__card dish-share__card" wx:if="{{ steps.length }}">
      <view class="zk__tape--green"></view>
      <view class="dish-share__section">
        <view class="dish-share__section-left">
          <text class="dish-share__section-icon">✎</text>
          <text class="dish-share__section-title">掌勺慢火 · 步骤分解</text>
        </view>
        <text class="dish-share__section-hint">共 {{ steps.length }} 步</text>
      </view>
      <view class="dish-share__steps">
        <view class="dish-share__step" wx:for="{{ steps }}" wx:key="index">
          <view class="dish-share__step-badge">{{ index + 1 }}</view>
          <view class="dish-share__step-box">{{ item.text }}</view>
        </view>
      </view>
    </view>

    <!-- 5. 掌厨人独家小贴士 -->
    <view class="dish-share__memo" wx:if="{{ tips.length }}">
      <view class="zk__tape"></view>
      <view class="dish-share__memo-title">📝 掌厨人独家小贴士</view>
      <view class="dish-share__memo-item" wx:for="{{ tips }}" wx:key="index">{{ item }}</view>
    </view>

    <!-- 尾部品牌标印 -->
    <view class="dish-share__brand">
      <view class="dish-share__brand-slogan">~ 厨菜记 · 每一餐都值得手写记录 ~</view>
      <view class="dish-share__brand-sub" wx:if="{{ sharer }}">本菜谱由 {{ sharer.nickname }} 分享于 {{ sharer.kitchenName }}</view>
    </view>

    <!-- 底部间距 -->
    <view class="dish-share__bottom-spacer"></view>
  </block>

  <!-- 底部吸底操作栏 -->
  <view slot="footer" class="dish-share__footer" wx:if="{{ dish }}">
    <view
      class="dish-share__collect {{ allCollected ? 'is-collected' : '' }} {{ submitting ? 'is-disabled' : '' }}"
      bind:tap="onCollect">
      <text class="dish-share__collect-text">{{ collectText }}</text>
      <text class="dish-share__collect-tag" wx:if="{{ !allCollected && collectTag }}">{{ collectTag }}</text>
    </view>
  </view>

  <!-- 厨房选择抽屉 -->
  <popup show="{{ collectVisible }}" title="🏡 选择收藏到哪个厨房" bind:close="onCloseCollect">
    <view class="dish-share__drawer">
      <view class="dish-share__drawer-desc">你在以下 {{ ownKitchens.length }} 个厨房拥有掌勺权限，菜谱将被完整收录进该厨房的菜谱簿：</view>

      <scroll-view scroll-y class="dish-share__drawer-list">
        <view
          class="dish-share__kitchen {{ selectedKitchenId === item.id ? 'is-selected' : '' }} {{ item.collected ? 'is-collected' : '' }}"
          wx:for="{{ ownKitchens }}"
          wx:key="id"
          data-id="{{ item.id }}"
          bind:tap="onSelectKitchen">
          <view class="dish-share__kitchen-info">
            <view class="dish-share__kitchen-row">
              <text class="dish-share__kitchen-name">{{ item.name }}</text>
              <text class="dish-share__kitchen-role dish-share__kitchen-role--{{ item.role }}">{{ utils.findEnumLabel(item.role, KITCHEN_ROLE_LIST) }}</text>
            </view>
            <view class="dish-share__kitchen-sub">已有 {{ item.dishCount || 0 }} 道菜 · {{ item.memberCount || 0 }} 位家人</view>
          </view>
          <text class="dish-share__kitchen-done" wx:if="{{ item.collected }}">✓ 已收藏</text>
          <view class="dish-share__radio" wx:else></view>
        </view>
      </scroll-view>

      <view class="dish-share__drawer-rules">
        <view class="dish-share__rules-title">📌 手账收藏规则</view>
        <view>· 食材与调料会自动匹配厨房库存，缺失的会自动新建；</view>
        <view>· 菜谱封面需你亲自掌勺后拍照点亮。</view>
      </view>

      <view class="btn--primary dish-share__drawer-btn {{ selectedKitchenId ? '' : 'is-disabled' }}" bind:tap="onConfirmCollect">
        确认收藏到该厨房
      </view>
    </view>
  </popup>

  <!-- 菜谱数达上限（4005）引导：看激励视频为上限 +1，确认后自动重试收藏 -->
  <confirm-popup id="limitPopup" bind:confirm="onExpandConfirm" />
</container>
