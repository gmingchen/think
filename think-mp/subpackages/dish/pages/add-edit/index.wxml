<container use-scroll use-footer use-back title="{{ form.id ? '编辑菜谱' : '新增菜谱' }}">

  <!-- 封面 + 基本信息 -->
  <view class="add-edit__top">
    <!-- 封面图 + 菜名 + 分类 -->
    <view class="add-edit__header">
      <view class="add-edit__photo-box">
        <uploader
          value="{{ form.photo }}"
          count="{{ 1 }}"
          limit="{{ 10 }}"
          preview="{{ true }}"
          deletable="{{ true }}"
          width="180rpx"
          height="180rpx"
          radius="20rpx"
          options="{{ coverOptions }}"
          bind:on-complete="onCoverComplete"
          bind:on-delete="onCoverDelete" />
      </view>
      <view class="add-edit__fields">
        <view class="add-edit__field">
          <text class="add-edit__field-label">菜名</text>
          <input class="add-edit__field-input" placeholder="输入菜名" value="{{ form.name }}" bindinput="onNameInput" maxlength="30" />
        </view>
        <view class="add-edit__field" bind:tap="onOpenCategoryPicker">
          <text class="add-edit__field-label">分类</text>
          <view class="add-edit__field-value">
            <text class="{{ form.categoryName ? '' : 'add-edit__field-placeholder' }}">{{ form.categoryName || '点击选择分类' }}</text>
            <iconfont name="arrow-right" size="28" color="#8C7E72" />
          </view>
        </view>
      </view>
    </view>
    <view class="add-edit__photo-tip">
      <text class="add-edit__photo-tip-text">💡 {{ photoTip }}</text>
      <view class="add-edit__cover-ai-btn" catch:tap="onOpenAiCover">✨ {{ form.photo ? 'AI 重新生成' : 'AI 生成封面' }}</view>
    </view>
  </view>

  <!-- 详情图（食材上方，除封面外最多 3 张） -->
  <view class="add-edit__section-header">
    <text class="add-edit__section-title">✎ 详情图（最多 3 张）</text>
  </view>
  <view class="zk__card add-edit__detail-card">
    <uploader
      value="{{ form.images }}"
      count="{{ 3 }}"
      limit="{{ 10 }}"
      preview="{{ true }}"
      deletable="{{ true }}"
      width="180rpx"
      height="180rpx"
      radius="16rpx"
      options="{{ detailOptions }}"
      bind:on-complete="onDetailComplete"
      bind:on-delete="onDetailDelete" />
  </view>

  <!-- 食材 -->
  <view class="add-edit__section-header">
    <text class="add-edit__section-title">✎ 食材</text>
    <view class="add-edit__section-add" wx:if="{{ form.ingredients.length > 0 }}" catch:tap="onOpenFoodPicker">+ 添加</view>
  </view>
  <view class="zk__card add-edit__list-card" wx:if="{{ form.ingredients.length > 0 }}">
    <view class="add-edit__list-item" wx:for="{{ form.ingredients }}" wx:key="id">
      <view class="add-edit__list-row">
        <text class="add-edit__list-name">{{ item.name }}</text>
        <view class="add-edit__list-side">
          <view class="tag add-edit__optional {{ item.isOptional ? 'add-edit__optional--on' : '' }}" catch:tap="onFoodOptionalToggle" data-index="{{ index }}">可选</view>
          <view class="add-edit__list-remove" catch:tap="onRemoveFood" data-index="{{ index }}">×</view>
        </view>
      </view>
      <view class="add-edit__list-fields">
        <input
          class="add-edit__list-input"
          placeholder="用量 如：500g"
          value="{{ item.amount }}"
          data-index="{{ index }}"
          data-field="amount"
          bindinput="onFoodInput" />
        <input
          class="add-edit__list-input"
          placeholder="处理方式 如：切块"
          value="{{ item.process }}"
          data-index="{{ index }}"
          data-field="process"
          bindinput="onFoodInput" />
      </view>
    </view>
  </view>
  <view class="add-edit__empty-tip" wx:if="{{ !form.ingredients.length }}" catch:tap="onOpenFoodPicker">暂无食材，点击添加</view>

  <!-- 调料 -->
  <view class="add-edit__section-header">
    <text class="add-edit__section-title">✎ 调料</text>
    <view class="add-edit__section-add" wx:if="{{ form.seasonings.length > 0 }}" catch:tap="onOpenSeasoningPicker">+ 添加</view>
  </view>
  <view class="zk__card add-edit__list-card" wx:if="{{ form.seasonings.length > 0 }}">
    <view class="add-edit__list-item" wx:for="{{ form.seasonings }}" wx:key="id">
      <view class="add-edit__list-row">
        <text class="add-edit__list-name">{{ item.name }}</text>
        <view class="add-edit__list-side">
          <view class="tag add-edit__optional {{ item.isOptional ? 'add-edit__optional--on' : '' }}" catch:tap="onSeasoningOptionalToggle" data-index="{{ index }}">可选</view>
          <view class="add-edit__list-remove" catch:tap="onRemoveSeasoning" data-index="{{ index }}">×</view>
        </view>
      </view>
      <view class="add-edit__list-fields">
        <input
          class="add-edit__list-input"
          placeholder="如：适量"
          value="{{ item.amount }}"
          data-index="{{ index }}"
          data-field="amount"
          bindinput="onSeasoningInput" />
      </view>
    </view>
  </view>
  <view class="add-edit__empty-tip" wx:if="{{ !form.seasonings.length }}" catch:tap="onOpenSeasoningPicker">暂无调料，点击添加</view>

  <!-- 做法步骤 -->
  <view class="add-edit__section-header">
    <text class="add-edit__section-title">✎ 做法步骤（选填）</text>
    <view class="add-edit__section-actions">
      <text class="add-edit__section-action" catch:tap="onOpenStepImport">导入整段</text>
      <text class="add-edit__section-action add-edit__section-action--primary" catch:tap="onAddStep">+ 新增步骤</text>
    </view>
  </view>
  <view class="zk__card add-edit__list-card add-edit__step-card" wx:if="{{ form.steps.length > 0 }}">
    <view
      class="add-edit__step-item {{ dragIndex === index ? 'add-edit__step-item--dragging' : '' }}"
      wx:for="{{ form.steps }}"
      wx:key="index"
      style="{{ dragIndex === index ? 'transform: translateY(' + dragOffsetY + 'px); z-index: 1;' : dragIndex >= 0 ? 'transform: translateY(' + (dragOffsets[index] || 0) + 'px); transition: transform 0.2s ease;' : '' }}">
      <text
        class="add-edit__step-drag"
        data-index="{{ index }}"
        catch:touchstart="onStepDragStart"
        catch:touchmove="onStepDragMove"
        catch:touchend="onStepDragEnd">☰</text>
      <text class="add-edit__step-num">{{ index + 1 }}</text>
      <view class="add-edit__step-text" data-index="{{ index }}" catch:tap="onEditStep">{{ item.text }}</view>
      <view class="add-edit__list-remove" catch:tap="onRemoveStep" data-index="{{ index }}">×</view>
    </view>
  </view>
  <view class="add-edit__empty-tip" wx:if="{{ !form.steps.length }}" catch:tap="onAddStep">暂无步骤，点击新增</view>
  <view class="add-edit__tip-text" wx:if="{{ form.steps.length }}">提示：点击步骤可修改 · 拖拽 ☰ 调整顺序 · 「导入整段」可粘贴成段做法自动拆分</view>

  <!-- 备注 -->
  <view class="add-edit__section-header">
    <text class="add-edit__section-title">✎ 备注（选填）</text>
  </view>
  <view class="zk__card add-edit__note-card">
    <textarea class="add-edit__note-textarea" placeholder="写点掌勺叮嘱..." value="{{ form.note }}" bindinput="onNoteInput" auto-height maxlength="200" />
  </view>

  <!-- Banner 广告（备注卡片之后、内容末尾；本页卡片用 margin 0 32rpx，故用 p_h-32 包裹对齐；受 store.ad.enabled 总开关控制，无填充自动隐藏） -->
  <view class="p_h-32">
    <ad-unit ad-unit-id="{{ AD_UNIT_ADD_EDIT_BANNER }}" cls="page__ad" />
  </view>

  <!-- 底部操作栏：AI 识别靠左，两个保存按钮成组靠右（footer 固定常驻，长表单滚动不丢） -->
  <view slot="footer" class="add-edit__bottom-bar">
    <view class="add-edit__ai-btn" catch:tap="onOpenAiParse">✨ AI 识别</view>
    <view class="add-edit__save-group">
      <view class="add-edit__bottom-btn add-edit__btn--outline" catch:tap="onSaveAndContinue">继续新增</view>
      <view class="add-edit__bottom-btn add-edit__btn--primary" catch:tap="onSaveAndBack">保存</view>
    </view>
  </view>
</container>

<!-- 分类选择弹窗 -->
<category-picker
  visible="{{ showCategoryPicker }}"
  value="{{ form.categoryId }}"
  bind:close="onCloseCategoryPicker"
  bind:confirm="onCategoryConfirm" />

<!-- 食材选择弹窗 -->
<food-picker
  visible="{{ showFoodPicker }}"
  selectedIds="{{ selectedFoodIds }}"
  bind:close="onCloseFoodPicker"
  bind:confirm="onFoodConfirm" />

<!-- 调料选择弹窗 -->
<seasoning-picker
  visible="{{ showSeasoningPicker }}"
  selectedIds="{{ selectedSeasoningIds }}"
  bind:close="onCloseSeasoningPicker"
  bind:confirm="onSeasoningConfirm" />

<!-- 步骤录入弹窗（新增/编辑单条；确认关闭 / 确认并继续连录） -->
<step-popup id="stepPopup" bind:confirm="onStepConfirm" />

<!-- 步骤批量导入弹窗 -->
<step-import-popup id="stepImportPopup" bind:confirm="onStepImportConfirm" />

<!-- AI 文案识别弹窗（输入态↔预览态，预览即确认，确认回填表单） -->
<ai-parse-popup id="aiParsePopup" kitchen-id="{{ kitchen.active.id }}" remain-count="{{ parseRemainCount }}" bind:parsed="onAiParsed" bind:confirm="onParseConfirm" />

<!-- AI 封面生图弹窗（打开即生图 → base64 本地预览 → 使用这张才上传七牛并回填封面） -->
<ai-cover-popup id="aiCoverPopup" kitchen-id="{{ kitchen.active.id }}" remain-count="{{ imageRemainCount }}" bind:consumed="onAiImageConsumed" bind:confirm="onAiCoverConfirm" />

<!-- 菜谱数达上限（4005）引导：看激励视频为上限 +1，确认后自动重试保存 -->
<confirm-popup id="limitPopup" bind:confirm="onExpandConfirm" />
