
.latest {
  padding: 24rpx 36rpx;
  margin-top: 32rpx;
}
.latest__order {
  padding: 20rpx 0;
  border-bottom: var(--border-dashed);
}
.latest__order--last {
  border-bottom: none;
}
.latest__orderer {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--font-color);
  display: block;
  margin-bottom: 16rpx;
}
.latest__remark {
  font-size: 22rpx;
  color: var(--font-color-sub);
  display: block;
  margin-bottom: 12rpx;
}
.latest__dishes {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.latest__dish {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.latest__dish-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F2E8DC;
}
.latest__dish-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.latest__dish-name {
  font-size: 26rpx;
  color: var(--font-color);
}
.latest__dish-qty {
  font-size: 24rpx;
  color: var(--font-color-sub);
  flex-shrink: 0;
}
.latest__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 16rpx;
}
.latest__empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.latest__empty-text {
  font-size: 26rpx;
  color: var(--font-color);
  font-weight: 600;
}
.latest__empty-hint {
  font-size: 22rpx;
  color: var(--font-color-sub);
  margin-top: 4rpx;
}
