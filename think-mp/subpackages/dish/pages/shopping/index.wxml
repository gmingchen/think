<!-- 清单条目行：打孔勾选 + 名称/用量 + 来源与处理小字 -->
<template name="itemRow">
  <view
    class="shopping__item"
    data-group="{{ group }}"
    data-key="{{ item.key }}"
    bind:tap="onToggle"
  >
    <view class="shopping__punch {{ item.checked ? 'shopping__punch--on' : '' }}">
      <text wx:if="{{ item.checked }}">✔</text>
    </view>
    <view class="shopping__item-info">
      <view class="shopping__item-main">
        <text class="shopping__item-name {{ item.checked ? 'shopping__item-name--done' : '' }}">{{ item.name }}</text>
        <text
          wx:if="{{ item.amountDisplay }}"
          class="shopping__item-amount {{ item.summable ? 'shopping__item-amount--sum' : '' }} {{ group === 'seasoning' ? 'shopping__item-amount--sea' : '' }} {{ item.checked ? 'shopping__item-amount--done' : '' }}"
        >{{ item.amountDisplay }}</text>
      </view>
      <view wx:if="{{ item.sources.length || item.process || item.amountSegs.length }}" class="shopping__item-meta">
        <text wx:for="{{ item.amountSegs }}" wx:for-item="seg" wx:key="*this" class="shopping__item-seg {{ item.checked ? 'shopping__item-seg--done' : '' }}">{{ seg }}</text>
        <text wx:for="{{ item.sources }}" wx:for-item="src" wx:key="*this" class="shopping__item-source">· {{ src }}</text>
        <text wx:if="{{ item.process }}" class="shopping__item-process">↳ 处理：{{ item.process }}</text>
      </view>
    </view>
  </view>
</template>

<container use-scroll use-footer use-back title="采购清单">
  <!-- 骨架屏 -->
  <skeleton wx:if="{{ loading }}" />

  <!-- 加载失败：service 已 toast，保留重试 -->
  <view wx:elif="{{ loadFailed }}" class="shopping__empty">
    <empty title="加载失败" desc="网络不太顺畅，稍后再试试">
      <view class="shopping__empty-btn" bind:tap="onRetry">重试</view>
    </empty>
  </view>

  <!-- 接口返回全部无效菜谱（已删/已移出厨房） -->
  <view wx:elif="{{ notFound }}" class="shopping__empty">
    <empty title="没有可汇总的菜谱" desc="菜谱已被删除，回篮子里重新选一下吧">
      <view class="shopping__empty-btn" bind:tap="onBack">返回</view>
    </empty>
  </view>

  <!-- 极端数据：有菜但没录食材 -->
  <view wx:elif="{{ noItems }}" class="shopping__empty">
    <empty title="清单是空的" desc="这几道菜没录入食材，去菜谱里补一下吧">
      <view class="shopping__empty-btn" bind:tap="onBack">返回</view>
    </empty>
  </view>

  <view wx:else class="shopping__body">
    <!-- 采买进度胶囊（navbar 右侧会被微信胶囊遮挡，收在正文顶部） -->
    <view class="shopping__progress">
      <text class="shopping__progress-label">已买</text>
      <text class="shopping__progress-num">{{ itemChecked }}/{{ itemTotal }}</text>
      <view class="shopping__progress-track">
        <view
          class="shopping__progress-fill {{ allChecked ? 'shopping__progress-fill--full' : '' }}"
          style="width: {{ progressPct }}%;"
        ></view>
      </view>
    </view>

    <!-- 采买便签小票 -->
    <view class="shopping__receipt">
      <view class="shopping__receipt-tape">★ SHOPPING LIST ★</view>
      <view class="shopping__receipt-perf"></view>

      <view class="shopping__receipt-head">
        <text class="shopping__receipt-title">🧾 今日采买便签</text>
        <text class="shopping__receipt-sub {{ allChecked ? 'shopping__receipt-sub--done' : '' }}">
          {{ allChecked ? '采买全部完成 🎉 大厨可以准备开火啦！' : '对着买 · 买完打勾 ✔（已买项自动沉底）' }}
        </text>
      </view>

      <!-- 来源菜订单区：收起态不重复菜名（展开列表里已有），只留汇总句；点击展开「封面+名称+数量」菜列表 -->
      <view class="shopping__source" data-flag="dishListExpanded" bind:tap="onToggleArea">
        <text class="shopping__source-icon">🍲</text>
        <text class="shopping__source-label">共 {{ dishCount }} 道菜</text>
        <iconfont class="shopping__source-arrow" name="{{ dishListExpanded ? 'arrow-top' : 'arrow-bottom' }}" size="20" color="#C86D51" />
      </view>
      <view class="shopping__collapse" style="height: {{ dishListExpanded ? dishListH : 0 }}px">
        <view class="shopping__dish-list" id="dishListInner">
          <view class="shopping__dish-row" wx:for="{{ dishList }}" wx:key="dishId">
            <image class="shopping__dish-cover" src="{{ item.dishCover || DEFAULT_DISH_COVER }}" mode="aspectFill" />
            <text class="shopping__dish-name">{{ item.dishName }}</text>
            <text class="shopping__dish-qty">×{{ item.quantity }}</text>
          </view>
        </view>
      </view>

      <!-- 🥬 需要买：必买食材，默认展开 -->
      <view class="shopping__group">
        <view class="shopping__group-head" data-flag="requiredExpanded" bind:tap="onToggleArea">
          <view class="shopping__group-title">🥬 需要买</view>
          <view class="shopping__group-toggle">
            <text class="shopping__group-status shopping__group-status--pri">已买 {{ reqChecked }}/{{ required.length }}</text>
            <iconfont name="{{ requiredExpanded ? 'arrow-top' : 'arrow-bottom' }}" size="20" color="#8C7E72" />
          </view>
        </view>
        <view class="shopping__collapse" style="height: {{ requiredExpanded ? reqH : 0 }}px">
          <view class="shopping__list" id="requiredInner">
            <block wx:for="{{ required }}" wx:key="key">
              <template is="itemRow" data="{{ item: item, group: 'required' }}" />
            </block>
          </view>
        </view>
      </view>

      <!-- 🌿 可不买：isOptional 食材，默认折叠，与需要买、调料一并计入顶部主进度 -->
      <view wx:if="{{ optional.length }}" class="shopping__group shopping__group--opt">
        <view class="shopping__group-head" data-flag="optionalExpanded" bind:tap="onToggleArea">
          <view class="shopping__group-title">🌿 可不买</view>
          <view class="shopping__group-toggle">
            <text class="shopping__group-status">已买 {{ optChecked }}/{{ optional.length }}</text>
            <iconfont name="{{ optionalExpanded ? 'arrow-top' : 'arrow-bottom' }}" size="20" color="#8C7E72" />
          </view>
        </view>
        <view class="shopping__collapse" style="height: {{ optionalExpanded ? optH : 0 }}px">
          <view class="shopping__list" id="optionalInner">
            <block wx:for="{{ optional }}" wx:key="key">
              <template is="itemRow" data="{{ item: item, group: 'optional' }}" />
            </block>
          </view>
        </view>
      </view>

      <!-- 🧂 调料：默认折叠，与食材一并计入顶部主进度 -->
      <view wx:if="{{ seasonings.length }}" class="shopping__group shopping__group--sea">
        <view class="shopping__group-head" data-flag="seasoningExpanded" bind:tap="onToggleArea">
          <view class="shopping__group-title">🧂 调料</view>
          <view class="shopping__group-toggle">
            <text class="shopping__group-status shopping__group-status--sea">已买 {{ seaChecked }}/{{ seasonings.length }}</text>
            <iconfont name="{{ seasoningExpanded ? 'arrow-top' : 'arrow-bottom' }}" size="20" color="#8C7E72" />
          </view>
        </view>
        <view class="shopping__collapse" style="height: {{ seasoningExpanded ? seaH : 0 }}px">
          <view class="shopping__list" id="seasoningInner">
            <block wx:for="{{ seasonings }}" wx:key="key">
              <template is="itemRow" data="{{ item: item, group: 'seasoning' }}" />
            </block>
          </view>
        </view>
      </view>

      <!-- 全部勾完盖朱红印章 -->
      <view class="shopping__seal {{ allChecked ? 'shopping__seal--hit' : '' }}">
        <text class="shopping__seal-main">采买完成</text>
        <text class="shopping__seal-sub">厨菜记 · 准奏</text>
      </view>

      <view class="shopping__receipt-tear"></view>
    </view>
  </view>

  <!-- Banner 广告（内容末尾；加载完成即展示，列表/空态/失败态均曝光，加载中不展示；本页正文用 28rpx 内边距，故用 p_h-28 包裹对齐；原生 ad 只加上下 margin；受 store.ad.enabled 总开关控制，无填充自动隐藏） -->
  <view wx:if="{{ !loading }}" class="p_h-28">
    <ad-unit ad-unit-id="{{ AD_UNIT_SHOPPING_LIST_CUSTOM }}" cls="page__ad" />
  </view>

  <!-- 底部操作栏：篮子/抽菜/帮我选来源附「入篮」，订单来源不附 -->
  <view
    wx:if="{{ !loading && !loadFailed && !notFound && !noItems }}"
    class="shopping__footer"
    slot="footer"
  >
    <view class="shopping__dock-sub" bind:tap="onClearChecked">🧹 清空勾选</view>
    <view wx:if="{{ canAddToCart }}" class="shopping__dock-main" bind:tap="onAddToCart">🧺 把这几道入点菜篮</view>
  </view>
</container>
