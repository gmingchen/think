<!-- 木质机箱容器 -->
<view class="slot__cabinet-container">
  <view class="slot__cabinet">
    <!-- 和纸胶带 -->
    <view class="slot__tape">★ 今日良方轮盘 ★</view>

    <!-- 拉杆组件 -->
    <view class="slot__lever {{ leverPulled ? 'slot__lever--pulled' : '' }}" catch:tap="onDraw">
      <view class="slot__lever-pivot"></view>
      <view class="slot__lever-shaft">
        <view class="slot__lever-knob"></view>
      </view>
    </view>

    <!-- 铜质铭牌 + 数量选择 -->
    <view class="slot__brass-bar">
      <text class="slot__brass-tag">🎲 抽取数量</text>
      <stepper value="{{ drawCount }}" min="{{ 1 }}" max="{{ maxCount }}" bind:change="onCountChange" />
    </view>

    <!-- 玻璃视窗 & 滚轮：列数 = 抽取数量，每列独立滚动 -->
    <view class="slot__viewport">
      <!-- 中间基准红虚线 -->
      <view class="slot__target-line"></view>
      <view
        wx:for="{{ cols }}"
        wx:key="index"
        class="slot__column"
      >
        <!-- 滚轮条：transition 和 transform 全部由 inline style 控制（同 HTML setReelPosition） -->
        <view
          class="slot__reel {{ item.blur ? 'slot__reel--blur' : '' }}"
          data-index="{{ index }}"
          bind:transitionend="onReelEnd"
          style="transform: translateY({{ item.offset }}px); transition: {{ item.anim ? 'transform ' + item.duration + 'ms cubic-bezier(0.15, 0.9, 0.22, 1)' : 'none' }};"
        >
          <view
            wx:for="{{ reelList }}"
            wx:for-item="dish"
            wx:key="_key"
            class="slot__item"
          >
            <image
              class="slot__item-photo"
              src="{{ dish.photo || DEFAULT_DISH_COVER }}"
              mode="aspectFill"
            />
            <text class="slot__item-name">{{ dish.name }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 开火按钮 -->
    <button
      class="slot__spin-btn"
      catch:tap="onDraw"
      disabled="{{ spinning }}"
    >
      <text>🔥</text>
      <text>{{ spinning ? '摇奖飞转中…' : '启动拉杆 · 摇出今日美味' }}</text>
    </button>
  </view>
</view>
