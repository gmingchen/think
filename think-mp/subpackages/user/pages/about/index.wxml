<container title="关于众三思" use-back>
  <!-- Logo 区域 -->
  <view class="about__top">
    <view class="about__logo-box"><image src="/common/images/logo.png" mode="aspectFit" class="about__logo-img" /></view>
    <text class="about__name font-serif">众三思</text>
    <text class="about__version">v{{ system.version }}</text>
    <text class="about__slogan">集众人所见，众三思而后抉择</text>
  </view>

  <!-- 协议列表 -->
  <view class="about__list">
    <view class="about__item" bind:tap="onAgreement">
      <view class="about__item-main">
        <iconfont name="file" size="40" color="#9AA0AA" />
        <text>用户协议</text>
      </view>
      <iconfont name="right" size="28" color="#9AA0AA" />
    </view>
    <view class="about__item about__item--last" bind:tap="onPrivacy">
      <view class="about__item-main">
        <iconfont name="lock" size="40" color="#9AA0AA" />
        <text>隐私政策</text>
      </view>
      <iconfont name="right" size="28" color="#9AA0AA" />
    </view>
  </view>
</container>
