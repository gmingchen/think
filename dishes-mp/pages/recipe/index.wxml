<wxs src="../../wxs/index.wxs" module="utils" />
<container use-scroll="{{ false }}" use-footer use-navbar-left>
  <!-- 骨架屏 -->
  <skeleton wx:if="{{ loading }}" />

  <!-- 厨房切换头部 -->
  <kitchen-header slot="navbar-left" bind:tap="onOpenKitchenSwitch" />
  <!-- 主体：左侧分类 + 右侧菜谱列表 -->
  <view class="recipe__menu-body">
    <!-- 左侧分类栏 -->
    <scroll-view class="recipe__sidebar" scroll-y enhanced show-scrollbar="{{ false }}" scroll-into-view="{{ sidebarScrollIntoView }}" scroll-with-animation>
      <view
        id="tab-{{ item.id === null ? 'other' : item.id }}"
        class="recipe__tab-item {{ activeCategory === item.id ? 'recipe__tab-item--active' : '' }}"
        wx:for="{{ categoryList }}"
        wx:key="id"
        data-id="{{ item.id }}"
        catch:tap="onSelectCategory">
        {{ item.name }}
      </view>
    </scroll-view>

    <!-- 右侧菜谱列表 -->
    <scroll-view class="recipe__dish-list" scroll-y enhanced show-scrollbar="{{ false }}" scroll-into-view="{{ scrollIntoView }}" scroll-with-animation bindscroll="onDishListScroll">
      <!-- 空状态：加载完成后才判定，避免骨架屏期间闪现 -->
      <view wx:if="{{ !loading && allDishes.length === 0 }}" class="recipe__empty-wrap">
        <empty title="还没有菜谱" desc="快去添加第一道菜谱吧">
          <view wx:if="{{ kitchen.active.role === KITCHEN_ROLE_ENUM.OWNER || kitchen.active.role === KITCHEN_ROLE_ENUM.MANAGER }}" class="btn--primary recipe__add-btn-empty" catch:tap="onAddNewDish">+ 新增菜谱</view>
        </empty>
        <!-- Banner 广告：空态同样曝光，置于「新增菜谱」按钮下方；左右 24rpx 内边距与菜谱卡片对齐；总开关与无填充隐藏由 ad-unit 内部处理 -->
        <view class="recipe__empty-ad">
          <ad-unit ad-unit-id="{{ AD_UNIT_RECIPE_BANNER }}" cls="recipe__ad" />
        </view>
      </view>

      <!-- 普通模式 -->
      <block wx:elif="{{ !isManageMode }}">
        <block wx:for="{{ groupedDishList }}" wx:key="categoryId" wx:for-item="group">
          <view id="{{ group.categoryId === null ? 'cat-other' : 'cat-' + group.categoryId }}">
            <view class="recipe__group-title">{{ group.categoryName }}</view>
            <view
              class="recipe__dish-card"
              wx:for="{{ group.dishes }}"
              wx:key="id"
              data-id="{{ item.id }}"
              catch:tap="onDishTap">
              <view class="recipe__dish-pic">
                <image wx:if="{{ item.photo }}" src="{{ item.photo }}" mode="aspectFill" class="recipe__dish-img" />
                <image wx:else src="{{ DEFAULT_DISH_COVER }}" mode="aspectFit" class="recipe__dish-default-img" />
              </view>
              <view class="recipe__dish-text">
                <view>
                  <text class="recipe__dish-name">{{ item.name }}</text>
                  <view class="recipe__dish-desc">
                    <text>{{ item.cookCount }}次 · </text>
                    <van-rate value="{{ item.rating }}" color="#E8A87C" void-color="#D8CCBE" size="10px" readonly />
                  </view>
                </view>
                <text class="recipe__tag-label" wx:if="{{ item.tag }}">{{ item.tag }}</text>
              </view>
              <block wx:if="{{ utils.getCartQuantity(item.id, cart.list) > 0 }}">
                <stepper value="{{ utils.getCartQuantity(item.id, cart.list) }}" min="0" bind:change="onStepperChange" data-id="{{ item.id }}" />
              </block>
              <block wx:else>
                <view class="recipe__add-btn" catch:tap="onAddDish" data-id="{{ item.id }}">+点这道</view>
              </block>
            </view>
          </view>
        </block>
      </block>

      <!-- 编辑模式 -->
      <block wx:else>
        <block wx:for="{{ groupedDishList }}" wx:key="categoryId" wx:for-item="group">
          <view id="{{ group.categoryId === null ? 'cat-other' : 'cat-' + group.categoryId }}">
            <view class="recipe__group-title">
              <text class="recipe__group-name">{{ group.categoryName }}</text>
              <text
                class="recipe__group-sort"
                data-category-id="{{ group.categoryId }}"
                data-category-name="{{ group.categoryName }}"
                catch:tap="onSortCategory">排序</text>
            </view>
            <view
              class="recipe__dish-card {{ item.selected ? 'recipe__dish-card--selected' : '' }}"
              wx:for="{{ group.dishes }}"
              wx:key="id"
              catch:tap="onToggleSelect"
              data-id="{{ item.id }}">
              <view class="recipe__dish-check">
                <view class="recipe__checkbox {{ item.selected ? 'recipe__checkbox--checked' : '' }}"></view>
              </view>
              <view class="recipe__dish-pic">
                <image wx:if="{{ item.photo }}" src="{{ item.photo }}" mode="aspectFill" class="recipe__dish-img" />
                <image wx:else src="{{ DEFAULT_DISH_COVER }}" mode="aspectFit" class="recipe__dish-default-img" />
              </view>
              <view class="recipe__dish-text">
                <text class="recipe__dish-name">{{ item.name }}</text>
                <text class="recipe__dish-desc">{{ item.cookCount }}次</text>
              </view>
              <view class="recipe__dish-edit" catch:tap="onEditDish" data-id="{{ item.id }}">
                <text>编辑</text>
              </view>
            </view>
          </view>
        </block>
      </block>

      <!-- Banner 广告：右列末尾，滑到列表底自然露出；左右 24rpx 内边距与菜谱卡片对齐；仅列表非空时展示——空态 Banner 见上方 recipe__empty-wrap；编辑模式不显示 -->
      <view class="recipe__list-ad">
        <ad-unit wx:if="{{ !loading && !isManageMode && allDishes.length > 0 }}" ad-unit-id="{{ AD_UNIT_RECIPE_BANNER }}" cls="recipe__ad" />
      </view>

      <!-- 列表底部占位（避让悬浮购物车栏） -->
      <view class="recipe__list-bottom"></view>
    </scroll-view>
  </view>

  <!-- 底部购物车栏（小黑板风格） -->
  <view class="recipe__cart-bar" wx:if="{{ !isManageMode && allDishes.length > 0 }}">
    <view class="recipe__cart-badge {{ cartShake ? 'recipe__cart-badge--shake' : '' }}" catch:tap="onOpenCartPopup">
      <text class="recipe__cart-icon">🧺</text>
      <text class="recipe__badge" wx:if="{{ cart.quantity > 0 }}">{{ cart.quantity }}</text>
    </view>
    <view class="recipe__cart-actions">
      <button class="recipe__cart-btn recipe__cart-btn--outline" wx:if="{{ kitchen.active.role === KITCHEN_ROLE_ENUM.OWNER || kitchen.active.role === KITCHEN_ROLE_ENUM.MANAGER }}" open-type="share" data-type="invite" data-id="{{ kitchen.active.id }}" data-name="{{ kitchen.active.name }}" data-role="{{ KITCHEN_ROLE_ENUM.GUEST }}">邀请下单</button>
      <view class="recipe__cart-btn recipe__cart-btn--pick" catch:tap="onPickDish">🎲 帮我选</view>
      <view class="recipe__cart-btn recipe__cart-btn--primary" catch:tap="onGoOrder"><view class="recipe__cart-btn-inner">敲定菜单<iconfont name="arrow-right" size="{{24}}" color="#FFF" /></view></view>
    </view>
  </view>

  <tabbar slot="footer"></tabbar>

  <!-- 悬浮菜单（仅厨师长/管厨可见）；⚠️ 加载中不渲染：骨架屏是 absolute 遮罩，而 fab 是 fixed（z-index 99），
       跳出了遮罩的层叠上下文盖不住，不拼闸门就会在首屏骨架期间先看到一个可点的按钮（loading 只在首次 onShow 加载完成前置 true，不会中途翻回） -->
  <fab
    wx:if="{{ !loading && (kitchen.active.role === KITCHEN_ROLE_ENUM.OWNER || kitchen.active.role === KITCHEN_ROLE_ENUM.MANAGER) }}"
    side="left"
    items="{{ floatItems }}"
    badge="{{ selectedCount }}"
    hint="点击管理"
    bind:action="onFloatAction"
    bind:change="onFabChange"
  />
</container>

<!-- 切换厨房弹窗 -->
<kitchen-picker
  visible="{{ showKitchenSwitch }}"
  bind:close="onCloseKitchenSwitch"
  bind:switch="onSwitchKitchenConfirm" />

<!-- 菜谱详情弹窗 -->
<dish-popup
  id="dishPopup"
  bind:add="onAddDishFromPopup"
  bind:detail="onDetailDish" />

<!-- 购物车弹窗 -->
<cart-popup
  id="cartPopup"
  bind:confirm="onGoOrder" />

<!-- 删除确认弹窗 -->
<confirm-popup
  id="deleteConfirmPopup"
  bind:confirm="onConfirmDelete" />

<!-- 修改分类弹窗 -->
<category-picker
  visible="{{ showCategoryPicker }}"
  bind:close="onCloseCategoryPicker"
  bind:confirm="onConfirmCategory" />

<!-- 帮我选抽菜弹窗 -->
<pick-popup
  show="{{ showPickPopup }}"
  dishes="{{ allDishes }}"
  bind:close="onClosePickPopup"
  bind:add="onPickAddToCart"
  bind:shopping="onPickShopping" />
