<!-- 日历弹窗 -->
<view class="dp__mask {{ show ? 'dp__mask--visible' : '' }}" catch:tap="onClose" catchtouchmove="true">
  <view class="dp__panel" catch:tap="stopPropagation">
    <!-- 月份导航 -->
    <view class="dp__month-nav">
      <view class="dp__arrow {{ !canPrev ? 'dp__arrow--disabled' : '' }}" catch:tap="onPrevMonth">
        <text class="dp__arrow-icon">‹</text>
      </view>
      <text class="dp__month-label">{{ calLabel }}</text>
      <view class="dp__arrow {{ !canNext ? 'dp__arrow--disabled' : '' }}" catch:tap="onNextMonth">
        <text class="dp__arrow-icon">›</text>
      </view>
    </view>

    <!-- 星期表头 -->
    <view class="dp__week-header">
      <text class="dp__week-day" wx:for="{{ weekDays }}" wx:key="*this">{{ item }}</text>
    </view>

    <!-- 日期网格 -->
    <view class="dp__grid">
      <view class="dp__week-row" wx:for="{{ weeks }}" wx:key="index" wx:for-item="week">
        <view
          wx:for="{{ week }}"
          wx:key="dateStr"
          wx:for-item="cell"
          class="dp__cell {{ cell.isToday ? 'dp__cell--today' : '' }} {{ cell.isSelected ? 'dp__cell--selected' : '' }} {{ cell.isDisabled ? 'dp__cell--disabled' : '' }} {{ !cell.day ? 'dp__cell--empty' : '' }}"
          data-day="{{ cell.dateStr }}"
          catch:tap="onPickDay"
        >
          <text class="dp__cell-text" wx:if="{{ cell.day }}">{{ cell.day }}</text>
        </view>
      </view>
    </view>
  </view>
</view>
