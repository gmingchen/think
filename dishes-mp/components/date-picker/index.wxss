/* ===== 日历弹窗 ===== */
.dp__mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(45, 39, 36, 0.6);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}
.dp__mask--visible {
  opacity: 1;
  visibility: visible;
}
.dp__panel {
  position: relative;
  width: 100%;
  padding: 0 0 72rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: var(--bg-base);
  border-top: 4rpx solid var(--color-primary);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.dp__mask--visible .dp__panel {
  transform: translateY(0);
}

/* 月份导航 */
.dp__month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 28rpx 24rpx 16rpx;
}
.dp__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
}
.dp__arrow-icon {
  font-size: 40rpx;
  color: var(--font-color-sub);
  font-weight: 300;
  line-height: 1;
}
.dp__arrow--disabled {
  opacity: 0.25;
  pointer-events: none;
}
.dp__month-label {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--font-color);
  min-width: 200rpx;
  text-align: center;
}

/* 星期表头 */
.dp__week-header {
  display: flex;
  padding: 12rpx 24rpx;
  border-bottom: 1rpx dotted var(--border-color);
}
.dp__week-day {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--font-color-weak);
  font-weight: 500;
}

/* 日期网格 */
.dp__grid {
  padding: 12rpx 24rpx;
}
.dp__week-row {
  display: flex;
}
.dp__cell {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
}
.dp__cell-text {
  font-size: 28rpx;
  color: var(--font-color);
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
}

/* 今日 */
.dp__cell--today .dp__cell-text {
  color: var(--color-primary);
  font-weight: 700;
  border: 2rpx dashed var(--color-primary);
}

/* 选中 */
.dp__cell--selected .dp__cell-text {
  background: var(--color-primary);
  color: #FFF;
  font-weight: 700;
  border: none;
}

/* 超出范围 */
.dp__cell--disabled .dp__cell-text {
  color: var(--font-color-weak);
  opacity: 0.4;
  pointer-events: none;
}

/* 空位 */
.dp__cell--empty {
  pointer-events: none;
}
