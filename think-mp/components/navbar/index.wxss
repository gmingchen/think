.navbar {
  box-sizing: border-box;
  z-index: 1;
  background: rgba(245, 239, 235, 0.92);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}
.navbar__left > view {
  width: fit-content;
}
.navbar__back {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  flex-shrink: 0;
}
.navbar__back-icon {
  font-size: 28rpx;
  color: var(--font-color);
  line-height: 1;
}
.navbar__middle {
  font-weight: 700;
  color: var(--font-color);
  font-size: var(--font-size-large-3);
  letter-spacing: 1rpx;
}
.navbar.is-fixed {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
}
