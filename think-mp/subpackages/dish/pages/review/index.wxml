<container use-scroll use-back title="评价列表" finished="{{ finished }}" bind:on-scroll-lower="loadPageData">
  <!-- 骨架屏 -->
  <skeleton wx:if="{{ loading && !list.length }}" />

  <!-- 评价列表 -->
  <view class="review-list__content" wx:if="{{ list.length }}">
    <view class="zk__card review-list__item" wx:for="{{ list }}" wx:key="index">
      <review-card data="{{ item }}" />
    </view>
  </view>

  <!-- 加载状态（已有数据时追加加载） -->
  <view class="review-list__status" wx:if="{{ loading && list.length }}">
    <text>加载中...</text>
  </view>
  <view class="review-list__status" wx:elif="{{ finished && list.length }}">
    <text>— 没有更多评价了 —</text>
  </view>

  <!-- 空状态 -->
  <empty wx:if="{{ !loading && !list.length }}" text="暂无评价" />
</container>
