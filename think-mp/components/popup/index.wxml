<van-popup
  show="{{ show }}"
  position="{{ position }}"
  close-on-overlay-click
  lock-scroll="{{ lockScroll }}"
  safe-area-inset-bottom="{{ false }}"
  overlay-style="background: rgba(34, 38, 46, 0.55); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);"
  custom-style="background: transparent;"
  custom-class="popup__van {{ position === 'center' ? 'popup__van--center' : '' }}"
  bind:close="onClose"
>
  <view class="popup__panel {{ position === 'center' ? 'popup__panel--center' : '' }}" style="{{ panelWidth ? 'width:' + panelWidth + ';max-width:' + panelWidth + ';' : '' }}" catch:touchmove="{{ lockScroll ? 'onLockTouchMove' : '' }}">
    <!-- 标题栏（含关闭按钮） -->
    <view class="popup__header">
      <view class="popup__header-text" wx:if="{{ title || subtitle }}">
        <view class="popup__title">{{ title }}</view>
        <view class="popup__subtitle" wx:if="{{ subtitle }}">{{ subtitle }}</view>
      </view>
      <view class="popup__header-actions">
        <slot name="header-right" />
        <view class="popup__close" bind:tap="onClose">
          <iconfont name="fork" size="{{ 30 }}" color="#9AA0AA" />
        </view>
      </view>
    </view>
    <!-- 内容插槽：用 scroll-view 承载，自身消费手势，不受面板 catch:touchmove 影响 -->
    <scroll-view scroll-y class="popup__body">
      <slot />
    </scroll-view>
    <!-- 底部固定区：在滚动区之外，不随内容滚动 -->
    <slot name="footer" />
  </view>
</van-popup>
