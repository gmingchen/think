<view class="skeleton">
  <!-- 用户区骨架（与真实 .user 同构：不做卡片，昵称行内含编辑入口 + 下方加入天数纸片） -->
  <view class="skeleton__user">
    <view class="skeleton__block skeleton__block--avatar"></view>
    <view class="skeleton__user-info">
      <view class="skeleton__name-row">
        <view class="skeleton__block skeleton__block--name"></view>
        <view class="skeleton__block skeleton__block--tip"></view>
      </view>
      <view class="skeleton__block skeleton__block--join"></view>
    </view>
  </view>

  <!-- 会员卡骨架：必须与 member 组件自己的骨架态逐块对齐（208rpx 定高 + 左三行 + 右按钮 + 纸胶带）。
       页面骨架只撑 300ms，撤掉后 mineCard 还没到时这一段会由 member 组件接管续演同一版式；
       少一行或间距不同，交接那一刻卡内内容就会错位一次 -->
  <view class="skeleton__member zk__card">
    <view class="skeleton__member-tape"></view>
    <view class="skeleton__member-left">
      <view class="skeleton__block skeleton__block--vip-title"></view>
      <view class="skeleton__block skeleton__block--vip-desc"></view>
      <view class="skeleton__block skeleton__block--vip-note"></view>
    </view>
    <view class="skeleton__block skeleton__block--vip-btn"></view>
  </view>

  <!-- 菜单骨架（4 列宫格：图标底框 + 文字行）。⚠️ 画的是厨师长/管厨的 8 项：menu 组件按角色过滤，
       食客只有 4 项（一行），loaded 后这里会收缩一行——骨架屏全站都是静态数组（不读 store），
       要消掉这一处跳变得先把菜单常量提到 common/constants 让两处同源 -->
  <view class="skeleton__menu zk__card">
    <view class="skeleton__menu-item" wx:for="{{ [1,2,3,4,5,6,7,8] }}" wx:key="*this">
      <view class="skeleton__block skeleton__block--icon"></view>
      <view class="skeleton__block skeleton__block--label"></view>
    </view>
  </view>

  <!-- 链接骨架（真实 list 现为 2 项：推荐给朋友 / 关于厨菜记，行右侧还有一个图标） -->
  <view class="skeleton__link zk__card">
    <view class="skeleton__link-item" wx:for="{{ [1,2] }}" wx:key="*this">
      <view class="skeleton__block skeleton__block--link"></view>
      <view class="skeleton__block skeleton__block--link-icon"></view>
    </view>
  </view>
</view>
