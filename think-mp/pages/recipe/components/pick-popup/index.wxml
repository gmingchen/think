<popup
  show="{{ show }}"
  position="center"
  title="🎲 今天吃什么 · 帮你选"
  bind:close="onClose"
>
  <!-- 内容区：左右内边距 + 标题栏下虚线分割（对齐设计图 .zakka-center-popup） -->
  <view class="pick-popup__content">
    <!-- 副标题 -->
    <view class="pick-popup__tip">
      <text>~ 点餐犹豫不决？大厨加权为你抽取当家美味 ~</text>
    </view>

    <!-- 抽取的菜品列表 -->
    <view class="pick-popup__list">
      <view
        wx:for="{{ pickedList }}"
        wx:key="id"
        class="pick-popup__item"
      >
        <view class="pick-popup__item-left">
          <view class="pick-popup__item-pic">
            <image wx:if="{{ item.photo }}" src="{{ item.photo }}" mode="aspectFill" class="pick-popup__item-img" />
            <image wx:else src="{{ DEFAULT_DISH_COVER }}" mode="aspectFit" class="pick-popup__item-img" />
          </view>
          <view class="pick-popup__item-info">
            <text class="pick-popup__item-name">{{ item.name }}</text>
            <view class="pick-popup__item-meta">
              <text>做过 {{ item.cookCount }} 次 · </text>
              <van-rate value="{{ item.rating }}" color="#E8A87C" void-color="#D8CCBE" size="10px" readonly />
            </view>
          </view>
        </view>
        <button class="btn--primary pick-popup__item-btn" catch:tap="onAddSingle" data-id="{{ item.id }}">+ 加购</button>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="pick-popup__actions" slot="footer">
    <button class="pick-popup__btn pick-popup__btn--sub" catch:tap="onRefresh">🎲 换一批</button>
    <button class="pick-popup__btn pick-popup__btn--sub" catch:tap="onShopping">🛒 采购清单</button>
    <button class="pick-popup__btn pick-popup__btn--primary" catch:tap="onAddAll">🧺 加入竹篮</button>
  </view>
</popup>
