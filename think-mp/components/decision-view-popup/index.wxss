/* ===== decision-view-popup：「去看看」内容浏览弹窗（固定头 + 可滚动主体 + 选项按钮，点选项弹评议表单） ===== */
.decision-view__mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(34, 38, 46, 0.55);
  animation: dvMaskIn 0.24s ease;
}

/* 关闭时遮罩同步淡出 */
.decision-view__mask--closing {
  animation: dvMaskOut 0.24s ease forwards;
}

.decision-view {
  position: relative;
  width: 640rpx;
  max-width: 90vw;
  height: 64vh;
  max-height: 64vh;
  display: flex;
  flex-direction: column;
  background: var(--ts-card);
  border-radius: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  animation: dvPopupIn 0.24s ease;
}

/* 关闭动画：淡出 + 轻微缩小，forwards 保持终态直到卸载 */
.decision-view--closing {
  animation: dvPopupOut 0.24s ease forwards;
}

@keyframes dvPopupIn {
  from { opacity: 0; transform: scale(0.94); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes dvPopupOut {
  from { opacity: 1; transform: scale(1); }
  to { opacity: 0; transform: scale(0.94); }
}

@keyframes dvMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes dvMaskOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* 关闭叉（右上角，浮于头部之上） */
.decision-view__close {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* ── 固定头部 ── */
.decision-view__header {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 36rpx 20rpx;
}

.decision-view__title {
  font-size: 34rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
}

/* ── 可滚动主体：决策内容 ──
   必须 border-box + width:100%，且面板给确定高度，否则内容溢出压底、无法滚动 */
.decision-view__body {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 4rpx 36rpx;
}

.decision-view__author {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.decision-view__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--ts-fill-thumb);
  margin-right: 14rpx;
  flex-shrink: 0;
}

/* 无头像回退：昵称首字圆形徒章 */
.decision-view__avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ts-tag-bg);
  color: var(--ts-brand);
  font-size: 26rpx;
  font-weight: var(--font-weight-6);
  line-height: 1;
}

.decision-view__author-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.decision-view__name {
  font-size: 24rpx;
  color: var(--ts-text);
  font-weight: var(--font-weight-6);
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.decision-view__time {
  font-size: 20rpx;
  color: var(--ts-text-sub);
  margin-top: 2rpx;
}

.decision-view__c-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ts-text);
  line-height: 1.4;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.decision-view__c-content {
  font-size: 26rpx;
  color: var(--ts-text);
  opacity: 0.85;
  line-height: 1.6;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.decision-view__images {
  display: flex;
  flex-wrap: wrap;
  grid-gap: 12rpx;
  margin-bottom: 20rpx;
}

.decision-view__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--ts-fill-thumb);
}

.decision-view__foot {
  padding-bottom: 8rpx;
}

.decision-view__progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--ts-text-sub);
  margin-bottom: 8rpx;
}

.decision-view__track {
  height: 8rpx;
  background: var(--ts-tag-bg);
  border-radius: 999rpx;
  overflow: hidden;
}

.decision-view__fill {
  height: 100%;
  background: var(--ts-primary);
  border-radius: 999rpx;
}

/* ── 固定底部：仅选项按钮（点选项弹评议表单） ── */
.decision-view__footer {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 36rpx 36rpx;
  border-top: 1rpx solid var(--ts-line);
}

.decision-view__options {
  display: flex;
  flex-wrap: wrap;
  grid-gap: 16rpx;
}

.decision-view__option {
  flex: 1;
  min-width: 200rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--ts-line);
  font-size: 24rpx;
  text-align: center;
  color: var(--ts-brand);
  background: var(--ts-tag-bg);
  box-sizing: border-box;
}

.decision-view__option:active {
  opacity: 0.85;
}
