/* 列表卡片 */
.member__list-card {
  margin: 24rpx 32rpx;
  padding: 8rpx 32rpx;
}
.member__member-item {
  padding: 28rpx 0;
  border-bottom: var(--border-dashed);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.member__member-item--last {
  border-bottom: none;
}
.member__member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F2E8DC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.member__member-avatar-img {
  width: 100%;
  height: 100%;
}
.member__member-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.member__member-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.member__member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--font-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member__member-me {
  font-size: 20rpx;
  color: #fff;
  background: #b79466;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.member__member-role {
  font-size: 20rpx;
  color: var(--color-secondary);
  background: #EAF0E8;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.member__member-time {
  font-size: 20rpx;
  color: var(--font-color-weak);
}
.member__member-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}
.member__action-link {
  font-size: 22rpx;
  color: var(--color-primary);
}
.member__action-link--danger {
  color: var(--color-danger);
}

/* 邀请 */
.member__invite-section {
  padding: 24rpx 32rpx;
  text-align: center;
}
.member__invite-btns {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}
.member__invite-btn {
  flex: 1;
  max-width: 300rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  margin: 0;
  line-height: 1.5;
}
.member__invite-tip {
  font-size: 22rpx;
  color: var(--font-color-weak);
  margin-top: 16rpx;
}
/* Banner 广告：左右间距由外层 p_h-32 承担，原生 ad 只加上下 margin */
.page__ad {
  margin: 8rpx 0 32rpx;
}
