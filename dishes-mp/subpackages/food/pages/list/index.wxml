<container use-scroll title="食材库" use-back>

  <!-- 骨架屏 -->
  <skeleton wx:if="{{ loading }}" />

  <!-- 食材列表 -->
  <view class="zk__card food__list-card" wx:if="{{ list.length }}">
    <view
      class="food__item {{ index === list.length - 1 ? 'food__item--last' : '' }}"
      wx:for="{{ list }}"
      wx:key="id">
      <view class="food__info" data-item="{{ item }}" bindlongpress="onDelete">
        <text class="food__name">{{ item.name }}</text>
        <text class="food__count">用过{{ item.usageCount || 0 }}次</text>
      </view>
      <text class="food__edit" data-item="{{ item }}" bind:tap="onEdit">编辑</text>
    </view>
  </view>
  <empty wx:elif="{{ !loading }}" />

  <!-- 新增按钮 -->
  <view class="food__add-btn-wrap">
    <view class="btn--primary food__add-btn" bind:tap="onAdd">+ 新增食材</view>
  </view>

  <view class="food__tip-text">提示：长按名称可删除</view>

  <!-- Banner 广告（页面末尾；加载完成即展示，无数据也展示、加载中不展示；受 store.ad.enabled 总开关控制，无填充自动隐藏） -->
  <view class="p_h-32">
    <ad-unit wx:if="{{ !loading }}" ad-unit-id="{{ AD_UNIT_FOOD_LIST_CUSTOM }}" cls="page__ad" />
  </view>
</container>

<food-popup id="foodPopup" bind:confirm="onConfirm" />
