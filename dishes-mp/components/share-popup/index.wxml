<popup id="popup" show="{{ show }}" position="center" title="🎲 分享今日抽签" subtitle="选一种方式晒出去" bind:close="onClose">
  <view class="share-popup__options">
    <!-- 转发好友：open-type=share 直接触发宿主页面 onShareAppMessage -->
    <button
      class="share-popup__option"
      open-type="share"
      hover-class="share-popup__option--hover"
      bind:tap="onClose"
    >
      <view class="share-popup__option-icon">📤</view>
      <view class="share-popup__option-label">转发给好友</view>
      <view class="share-popup__option-desc">小程序卡片</view>
    </button>

    <!-- 生成海报：通知调用页跳转海报页 -->
    <view
      class="share-popup__option"
      hover-class="share-popup__option--hover"
      bind:tap="onPosterSelect"
    >
      <view class="share-popup__option-badge">手账风</view>
      <view class="share-popup__option-icon">🖼️</view>
      <view class="share-popup__option-label">生成今日海报</view>
      <view class="share-popup__option-desc">带参码发圈</view>
    </view>
  </view>

  <view class="share-popup__tip">✨ 海报自带专属小程序码，好友扫码即可来摇一把</view>
</popup>
