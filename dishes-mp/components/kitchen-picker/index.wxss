
.kitchen__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid #ECE3D9;
}
.kitchen__item:last-child {
  border-bottom: none;
}
.kitchen__item--active {
  background: #F9F4ED;
  border-radius: 12rpx;
}
.kitchen__name {
  font-size: 28rpx;
  color: var(--font-color);
}
.kitchen__badge {
  font-size: 22rpx;
  color: var(--color-secondary);
}
