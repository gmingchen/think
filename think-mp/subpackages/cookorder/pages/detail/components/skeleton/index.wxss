.skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  overflow: hidden;
  padding-bottom: 32rpx;
}

.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}

/* 状态卡片 */
.skeleton__status-card {
  margin: 24rpx 32rpx 0;
  padding: 40rpx 32rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  border: 1rpx solid #E5DBD0;
  text-align: center;
}
.skeleton__block--status {
  width: 160rpx;
  height: 40rpx;
  margin: 0 auto 16rpx;
}
.skeleton__block--meta {
  width: 280rpx;
  height: 22rpx;
  margin: 0 auto;
}

/* 小节标题 */
.skeleton__section {
  margin: 32rpx 40rpx 16rpx;
}
.skeleton__block--label {
  width: 140rpx;
  height: 26rpx;
}

/* 菜谱卡片 */
.skeleton__dish-card {
  margin: 0 32rpx;
  padding: 8rpx 32rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  border: 1rpx solid #E5DBD0;
}
.skeleton__dish-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #EDE4D8;
}
.skeleton__dish-item:last-child {
  border-bottom: none;
}
.skeleton__block--cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.skeleton__dish-text {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.skeleton__block--name {
  width: 180rpx;
  height: 26rpx;
}
.skeleton__block--qty {
  width: 60rpx;
  height: 22rpx;
}

/* 订单信息卡片 */
.skeleton__info-card {
  margin: 0 32rpx;
  padding: 8rpx 32rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  border: 1rpx solid #E5DBD0;
}
.skeleton__info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #EDE4D8;
}
.skeleton__info-row:last-child {
  border-bottom: none;
}
.skeleton__block--info-label {
  width: 120rpx;
  height: 22rpx;
}
.skeleton__block--info-value {
  width: 200rpx;
  height: 22rpx;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
