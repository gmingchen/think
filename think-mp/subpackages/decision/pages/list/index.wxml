<container title="{{ scene === DECISION_SCENE_ENUM.GROUP ? '群内决策单' : '我的决策单' }}" use-back use-scroll>
  <!-- 一级宋体 Tab：mine（我发起的 / 我评议过的）、group（按状态） -->
  <view class="dl__tabs font-serif" slot="header">
    <view
      class="dl__tab {{ tab === item.value ? 'dl__tab--active' : '' }}"
      wx:for="{{ tabs }}"
      wx:key="value"
      data-tab="{{ item.value }}"
      bindtap="onSwitchTab"
    >{{ item.label }}</view>
  </view>

  <!-- 二级分段控制器（仅「我发起的」） -->
  <view wx:if="{{ tab === DECISION_MINE_TAB_ENUM.CREATED }}" class="dl__segment">
    <view
      class="dl__segment-pill {{ activeStatus === item.value ? 'dl__segment-pill--active' : '' }}"
      wx:for="{{ statusChips }}"
      wx:key="index"
      data-value="{{ item.value }}"
      bindtap="onSwitchStatus"
    >{{ item.label }}</view>
  </view>

  <view wx:if="{{ loading }}" class="dl__loading">加载中...</view>

  <view wx:elif="{{ list.length }}">
    <view class="dl__item" wx:for="{{ list }}" wx:key="id">
      <decision-card item="{{ item }}" bind:click="onCardTap" />
    </view>
    <view wx:if="{{ list.length < page.total }}" class="dl__more" bindtap="loadPageData">加载更多</view>
    <view wx:else class="dl__nomore">—— 三思笃行 ——</view>
  </view>

  <view wx:else class="dl__empty">
    <view class="dl__empty-card">
      <view class="dl__empty-icon font-serif">卷</view>
      <view class="dl__empty-lead font-serif">暂无决策记录</view>
      <block wx:if="{{ scene === DECISION_SCENE_ENUM.GROUP }}">
        <view class="dl__empty-sub">群内该状态下还没有决策单</view>
      </block>
      <block wx:else>
        <view class="dl__empty-sub">三思而后行，旁观者清。前往众思广场，为他人的两难留下你的三思洞见。</view>
        <view class="dl__empty-btn" bindtap="onGoSquare">
          <text>前往众思广场</text>
          <text class="dl__empty-seal"></text>
        </view>
      </block>
    </view>
  </view>
</container>
