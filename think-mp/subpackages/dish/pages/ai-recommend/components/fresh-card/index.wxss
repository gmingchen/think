.fresh-card {
  background: #FFFDF9;
  border: 3rpx dashed #688B58;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  position: relative;
  box-shadow: 4rpx 6rpx 16rpx rgba(0, 0, 0, 0.04);
}

.fresh-card__stamp {
  position: absolute;
  right: 28rpx;
  top: 24rpx;
  border: 3rpx solid #688B58;
  color: #688B58;
  border-radius: 8rpx;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  transform: rotate(3deg);
  font-weight: bold;
}

.fresh-card__name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #3D352E;
}

.fresh-card__hint {
  display: block;
  font-size: 22rpx;
  color: #8C7E72;
  margin-top: 6rpx;
}

.fresh-card__meta {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed #DFD4C4;
}

.fresh-card__meta-row {
  font-size: 22rpx;
  line-height: 1.6;
  color: #3D352E;
}

.fresh-card__meta-key {
  font-weight: bold;
}

.fresh-card__meta-val {
  color: #6A5B4F;
}

.fresh-card__steps {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8C7E72;
  line-height: 1.6;
  background: #F7F5EE;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.fresh-card__steps-title {
  font-weight: bold;
  color: #6A5B4F;
}

.fresh-card__step {
  margin-top: 6rpx;
}

.fresh-card__step-toggle {
  display: inline-flex;
  align-items: center;
  color: #C86D51;
  font-weight: bold;
  margin-top: 8rpx;
}

.fresh-card__step-toggle-icon {
  margin-left: 4rpx;
}

.fresh-card__foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.fresh-card__foot-tip {
  font-size: 20rpx;
  color: #8C7E72;
}

.fresh-card__adopt {
  padding: 10rpx 24rpx;
  background: #C86D51;
  color: #FFF;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.fresh-card__adopt--done {
  background: #688B58;
}

.fresh-card__adopt:active {
  transform: scale(0.96);
}
