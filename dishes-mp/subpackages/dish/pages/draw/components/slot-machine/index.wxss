/* ═══════════════════════════════════════
   木质机箱
   （--zakka-* 色板变量由页面 page 选择器定义，CSS 变量可穿透继承进组件）
   ═══════════════════════════════════════ */
.slot__cabinet-container {
  padding: 12rpx 60rpx 20rpx 32rpx;
  position: relative;
}

.slot__cabinet {
  background: linear-gradient(145deg, var(--zakka-wood-light), var(--zakka-wood));
  border: 6rpx solid var(--zakka-wood-dark);
  border-radius: 40rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow:
    0 24rpx 56rpx rgba(50, 35, 20, 0.28),
    inset 0 4rpx 8rpx rgba(255,255,255,0.3),
    inset 0 -6rpx 12rpx rgba(0,0,0,0.4);
  position: relative;
}

/* 和纸胶带 */
.slot__tape {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-1deg);
  width: 280rpx;
  height: 40rpx;
  background: var(--zakka-tape);
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
  clip-path: polygon(3% 0%, 97% 0%, 100% 100%, 0% 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  color: #4A3416;
  letter-spacing: 2rpx;
  z-index: 20;
}

/* ── 3D 拉杆 ── */
.slot__lever {
  position: absolute;
  right: -48rpx;
  top: 104rpx;
  width: 64rpx;
  height: 240rpx;
  z-index: 40;
}

.slot__lever-pivot {
  position: absolute;
  left: 0;
  top: 72rpx;
  width: 28rpx;
  height: 56rpx;
  background: #463121;
  border-radius: 8rpx 0 0 8rpx;
  box-shadow: inset 2rpx 2rpx 4rpx rgba(255,255,255,0.2), 4rpx 4rpx 10rpx rgba(0,0,0,0.4);
}

.slot__lever-shaft {
  position: absolute;
  left: 16rpx;
  top: 100rpx;
  width: 12rpx;
  height: 120rpx;
  background: linear-gradient(to right, #B0947E, #ECE2D8, #866A55);
  border-radius: 6rpx;
  transform-origin: top center;
  transform: rotate(0deg);
  transition: transform 0.15s ease-out;
  box-shadow: 4rpx 6rpx 12rpx rgba(0,0,0,0.35);
}

.slot__lever-knob {
  position: absolute;
  bottom: -28rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 48rpx;
  background: radial-gradient(circle at 35% 35%, #E2886E, var(--zakka-terracotta) 60%, var(--zakka-terracotta-dark));
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.4), inset 0 4rpx 6rpx rgba(255,255,255,0.4);
  transition: transform 0.15s ease-out;
}

/* 拉杆下拉 */
.slot__lever--pulled .slot__lever-shaft {
  transform: rotate(44deg) scaleY(0.85);
}

.slot__lever--pulled .slot__lever-knob {
  transform: translateX(-50%) translateY(48rpx) scale(0.92);
}

/* ── 铜质铭牌行 ── */
.slot__brass-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 8rpx 12rpx;
}

.slot__brass-tag {
  font-size: 20rpx;
  font-weight: bold;
  color: #F8EFE4;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.6);
}

/* ═══════════════════════════════════════
   玻璃视窗
   ═══════════════════════════════════════ */
.slot__viewport {
  /* 固定内部高度为 168rpx，使用 content-box 让 border 往外扩，保证内容可视区域与 item 严格等高 */
  height: 168rpx !important;
  box-sizing: content-box;
  padding: 0 !important;
  border-top: 6rpx solid #4D3421;
  border-bottom: 6rpx solid #4D3421;
  background-color: #FFFDF9;
  background-image:
    radial-gradient(#F5EADB 2rpx, transparent 2rpx),
    linear-gradient(to bottom, rgba(60,40,25,0.18) 0%, transparent 20%, transparent 80%, rgba(60,40,25,0.22) 100%);
  background-size: 28rpx 28rpx, 100% 100%;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  box-shadow: inset 0 16rpx 28rpx rgba(0,0,0,0.25), inset 0 -16rpx 28rpx rgba(0,0,0,0.25);
}

/* 玻璃反光（::after 等价） */
.slot__viewport::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 45%;
  background: linear-gradient(to bottom, rgba(255,255,255,0.45), rgba(255,255,255,0.05));
  pointer-events: none;
  border-radius: 16rpx 16rpx 0 0;
  z-index: 15;
}

/* 中间基准红虚线 */
.slot__target-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 4rpx;
  background: repeating-linear-gradient(90deg, rgba(200,109,81,0.7), rgba(200,109,81,0.7) 12rpx, transparent 12rpx, transparent 24rpx);
  transform: translateY(-50%);
  pointer-events: none;
  z-index: 10;
}

/* ── 单列视窗：一列对应一道抽取结果，overflow 裁剪各自滚轮 ── */
.slot__column {
  flex: 1;
  min-width: 0;
  height: 168rpx !important;
  overflow: hidden;
  display: flex;
  position: relative;
}

/* 列间分隔线（多列时的老虎机格挡感） */
.slot__column + .slot__column {
  border-left: 2rpx dashed rgba(77, 52, 33, 0.35);
}

/* ── 滚轮条 ──
   transition 和 transform 均由 inline style 控制（与 HTML 原型 setReelPosition 一致），
   CSS class 不写 transition / transform，避免层叠冲突 */
.slot__reel {
  flex: 1;
  display: flex;
  flex-direction: column;
  will-change: transform;
  flex-shrink: 0;
}

.slot__reel--blur {
  filter: blur(6rpx);
}

/* 单个滚轮项 */
.slot__item {
  height: 168rpx !important;
  min-height: 168rpx !important;
  max-height: 168rpx !important;
  margin: 0 !important;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  flex-shrink: 0;
}

.slot__item-emoji {
  width: 84rpx;
  height: 84rpx;
  font-size: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.1));
  line-height: 1;
}

.slot__item-photo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: #F5EADB;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.12);
  display: block;
}

.slot__item-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--zakka-ink);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 96%;
  text-align: center;
}

/* ═══════════════════════════════════════
   开火按钮
   ═══════════════════════════════════════ */
.slot__spin-btn {
  width: 100% !important;
  margin-top: 20rpx;
  background: linear-gradient(180deg, #D4795E, var(--zakka-terracotta));
  border: 4rpx solid var(--zakka-terracotta-dark);
  color: #FFF;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 8rpx 16rpx rgba(180, 70, 40, 0.35), inset 0 2rpx 4rpx rgba(255,255,255,0.3);
  transition: all 0.15s;
  line-height: normal;
}

.slot__spin-btn::after {
  display: none;
}

.slot__spin-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 8rpx rgba(180, 70, 40, 0.35);
}

.slot__spin-btn[disabled] {
  opacity: 0.6;
}
