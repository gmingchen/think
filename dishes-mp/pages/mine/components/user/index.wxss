/* 用户区按设计稿不做卡片：让它成为页面顶部一记轻开场，第一张卡留给下面的内容 */
.user {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 28rpx 32rpx 24rpx;
  padding: 8rpx 12rpx;
}
.user__avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  border: 4rpx dashed var(--color-primary);
  background: var(--color-white);
  box-shadow: 0 4rpx 12rpx rgba(100, 80, 60, 0.08);
  flex-shrink: 0;
}
.user__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.user__name-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  min-width: 0;
}
.user__name {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--font-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 会员角标（§4 入口 2）：昵称后一枚琥珀色小胶囊，与会员卡的价格胶囊同族（rgba(224,169,79,.28)）。
   这一行是 baseline 对齐，胶囊带 padding 会坐偏，所以单独拉成居中 */
.user__badge {
  flex-shrink: 0;
  align-self: center;
  font-size: 20rpx;
  font-weight: bold;
  color: var(--color-primary-deep);
  background: rgba(224, 169, 79, 0.28);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-tag);
}
/* 编辑入口：从「一行说明」改成「昵称旁的可点小链接」，语义不变但不再占满一整行 */
.user__tip {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary);
  text-decoration: underline;
  text-decoration-color: rgba(200, 109, 81, 0.4);
}
/* 便签纸片：手账味的关系数据（加入日期 · 第 N 天） */
.user__join {
  align-self: flex-start;
  font-size: 22rpx;
  color: var(--font-color-sub);
  background: rgba(230, 220, 210, 0.5);
  padding: 4rpx 16rpx;
  border-radius: var(--border-radius-smaller);
}
