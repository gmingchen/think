<popup
  show="{{ visible }}"
  title="{{ mode === 'preview' ? '识别结果' : 'AI 识别文案' }}"
  subtitle="{{ mode === 'preview' ? ('⚠️ ' + AI_DISCLAIMER_TEXT) : ('今日剩余 ' + remainCount + ' 次｜粘贴一段做法文字，AI 帮你拆分') }}"
  bind:close="onClose">

  <!-- 输入态 -->
  <block wx:if="{{ mode === 'input' }}">
    <view class="ai-parse__form">
      <textarea
        class="ai-parse__textarea"
        placeholder="从菜谱网站复制、口述记录或长辈手抄的做法文案都可粘贴到这里，AI 会自动拆分菜名、食材、调料与步骤..."
        placeholder-style="color: #B8A99A; line-height: 1.6;"
        value="{{ text }}"
        bindinput="onInput"
        maxlength="{{ maxLen }}" />
      <view class="ai-parse__count">{{ text.length }}/{{ maxLen }}</view>
    </view>
  </block>

  <!-- 预览态（预览即确认） -->
  <block wx:else>
    <view class="ai-parse__preview">
      <view class="ai-parse__row">
        <text class="ai-parse__label">菜名</text>
        <text class="ai-parse__value">{{ result.name || '—' }}</text>
      </view>
      <view class="ai-parse__row">
        <text class="ai-parse__label">分类</text>
        <text class="ai-parse__value">{{ result.categoryHint || '—' }}</text>
      </view>

      <view class="ai-parse__group">
        <text class="ai-parse__label">食材</text>
        <view class="ai-parse__chips" wx:if="{{ result.foods.length }}">
          <text class="ai-parse__chip" wx:for="{{ result.foods }}" wx:key="index">{{ item.name }}{{ item.amount ? ' ' + item.amount : '' }}</text>
        </view>
        <text class="ai-parse__value ai-parse__value--empty" wx:else>—</text>
      </view>

      <view class="ai-parse__group">
        <text class="ai-parse__label">调料</text>
        <view class="ai-parse__chips" wx:if="{{ result.seasonings.length }}">
          <text class="ai-parse__chip" wx:for="{{ result.seasonings }}" wx:key="index">{{ item.name }}{{ item.amount ? ' ' + item.amount : '' }}</text>
        </view>
        <text class="ai-parse__value ai-parse__value--empty" wx:else>—</text>
      </view>

      <view class="ai-parse__group">
        <text class="ai-parse__label">步骤</text>
        <view class="ai-parse__steps" wx:if="{{ result.steps.length }}">
          <view class="ai-parse__step" wx:for="{{ result.steps }}" wx:key="index">{{ index + 1 }}. {{ item }}</view>
        </view>
        <text class="ai-parse__value ai-parse__value--empty" wx:else>—</text>
      </view>

      <view class="ai-parse__row" wx:if="{{ result.remark }}">
        <text class="ai-parse__label">备注</text>
        <text class="ai-parse__value">{{ result.remark }}</text>
      </view>
    </view>
  </block>

  <!-- 底部操作区：放 footer 插槽，固定在弹窗底部不随内容滚动 -->
  <view class="ai-parse__actions" slot="footer" wx:if="{{ mode === 'input' }}">
    <view class="ai-parse__cancel" catch:tap="onClose">取消</view>
    <view class="ai-parse__confirm {{ text ? '' : 'ai-parse__confirm--disabled' }}" catch:tap="onStart">开始识别</view>
  </view>
  <view class="ai-parse__actions" slot="footer" wx:else>
    <view class="ai-parse__cancel" catch:tap="onReInput">重新输入</view>
    <view class="ai-parse__confirm" catch:tap="onConfirm">确认使用</view>
  </view>
</popup>
