.cart__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.cart__empty-emoji {
  font-size: 88rpx;
}
.cart__empty-text {
  font-size: 26rpx;
  color: var(--font-color-sub);
  margin-top: 16rpx;
}
.cart__list {
  max-height: 600rpx;
  overflow-y: auto;
}
.cart__item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx dashed #E0D4C5;
}
.cart__item:last-child {
  border-bottom: none;
}
.cart__item-photo {
  width: 80rpx;
  height: 80rpx;
  background: #FFF;
  border: 2rpx solid #E5DBD0;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.cart__item-img {
  width: 100%;
  height: 100%;
}
.cart__item-info {
  flex: 1;
  margin: 0 20rpx;
}
.cart__item-name {
  font-size: 28rpx;
  color: var(--font-color);
  font-weight: 500;
}
.cart__item-actions {
  flex-shrink: 0;
}
.cart__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx 40rpx;
  margin-top: 16rpx;
  border-top: 1rpx dashed #E0D4C5;
}
.cart__total {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--font-color-sub);
  gap: 8rpx;
}
.cart__total-num {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-primary);
}
.cart__footer-btns {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
/* 采购清单描边小按钮：主色框透明底，与实底主按钮轻重配对 */
.cart__shopping-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: transparent;
  border: 1rpx solid var(--color-primary);
  border-radius: 10rpx;
}
.cart__shopping-btn:active {
  background: rgba(200, 109, 81, 0.12);
}
.cart__confirm-btn {
  margin: 0;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  background: var(--color-primary);
  color: #FFF;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart__confirm-btn-inner {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
