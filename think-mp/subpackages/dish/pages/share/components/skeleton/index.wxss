/* 骨架屏（滚动页内文档流渲染，参照 review 页骨架写法） */
.skeleton {
  padding: 32rpx 28rpx 0;
}

/* 骨架块基础 */
.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}

/* 拍立得相框 */
.skeleton__frame {
  padding: 24rpx;
  background: #FFFDF9;
  border: 1rpx solid #E3D9CC;
  border-radius: 8rpx;
}
.skeleton__block--cover {
  width: 100%;
  height: 392rpx;
  border-radius: 6rpx;
}
.skeleton__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 28rpx;
}
.skeleton__block--title {
  width: 55%;
  height: 44rpx;
}
.skeleton__block--stamp {
  width: 104rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
}

/* 分享者信笺 */
.skeleton__sharer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: #F7EFE6;
  border: 1rpx dashed #DDD0C1;
  border-radius: 16rpx;
}
.skeleton__block--avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.skeleton__sharer-info {
  flex: 1;
  min-width: 0;
}
.skeleton__block--name {
  width: 40%;
  height: 26rpx;
  margin-bottom: 10rpx;
}
.skeleton__block--sub {
  width: 70%;
  height: 22rpx;
}

/* 评分与统计 */
.skeleton__stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #E5DBD0;
}
.skeleton__block--stars {
  width: 170rpx;
  height: 26rpx;
}
.skeleton__block--badge {
  width: 200rpx;
  height: 32rpx;
  border-radius: 8rpx;
}

/* 便签卡片 */
.skeleton__card {
  margin-top: 36rpx;
  padding: 32rpx 28rpx;
  background: var(--bg-card);
  border: 1rpx solid #E5DBD0;
  border-radius: 24rpx;
}
.skeleton__block--label {
  width: 220rpx;
  height: 28rpx;
  margin-bottom: 24rpx;
}

/* 紧凑标签流（食材 / 调料共用，宽度由行内 style 给出） */
.skeleton__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.skeleton__block--chip {
  height: 56rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
}

/* 步骤 */
.skeleton__step {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 28rpx;
}
.skeleton__step:last-child {
  margin-bottom: 0;
}
.skeleton__block--num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.skeleton__step-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 8rpx;
}
.skeleton__block--line {
  width: 100%;
  height: 24rpx;
}
.skeleton__block--line-short {
  width: 60%;
}

/* 小贴士便签 */
.skeleton__memo {
  margin-top: 36rpx;
  padding: 32rpx 28rpx;
  background: #FEF9EB;
  border: 1rpx dashed #E0C895;
  border-radius: 16rpx;
}
.skeleton__memo .skeleton__block--line {
  margin-bottom: 16rpx;
}
.skeleton__memo .skeleton__block--line:last-child {
  margin-bottom: 0;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
