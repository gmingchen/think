/* 排序列表卡片 */
.sort__card {
  margin: 24rpx 32rpx;
  padding: 8rpx 32rpx;
}
/* 顶部说明行 */
.sort__tip {
  font-size: 22rpx;
  color: var(--font-color-weak);
  padding: 20rpx 0 8rpx;
}
/* 列表行 */
.sort__item {
  padding: 20rpx 0;
  border-bottom: var(--border-dashed);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.sort__item--last {
  border-bottom: none;
}
.sort__item--dragging {
  background: var(--bg-section);
  border-radius: 12rpx;
  opacity: 0.95;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
/* 拖拽手柄 */
.sort__drag {
  font-size: 34rpx;
  color: var(--font-color-weak);
  flex-shrink: 0;
}
/* 封面小图 */
.sort__pic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-section);
}
.sort__img {
  width: 100%;
  height: 100%;
}
/* 菜名 */
.sort__info {
  flex: 1;
}
.sort__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--font-color);
}

/* Banner 广告：左右间距由页面侧 p_h-32 包裹承担，原生 ad 只加上下 margin */
.page__ad {
  margin: 8rpx 0 24rpx;
}
