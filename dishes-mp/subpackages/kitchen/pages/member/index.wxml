<wxs src="../../../../wxs/index.wxs" module="utils" />

<container use-scroll title="成员管理" use-back>
  <!-- 骨架屏 -->
  <skeleton wx:if="{{ loading }}" />

  <!-- 成员列表 -->
  <view class="zk__card member__list-card">
    <view class="member__member-item {{ index === list.length - 1 ? 'member__member-item--last' : '' }}" wx:for="{{ list }}" wx:key="userId">
      <view class="member__member-avatar">
        <image class="member__member-avatar-img" src="{{ item.avatar || DEFAULT_AVATAR }}" />
      </view>
      <view class="member__member-info">
        <view class="member__member-top">
          <text class="member__member-name">{{ item.nickname }}</text>
          <text wx:if="{{ item.userId === me.userId }}" class="member__member-me">我</text>
          <text class="member__member-role">{{ utils.findEnumLabel(item.role, KITCHEN_ROLE_LIST) }}</text>
        </view>
        <text class="member__member-time">{{ item.createdAt }}</text>
      </view>
      <view wx:if="{{ item.userId !== me.userId }}" class="member__member-actions">
        <text wx:if="{{ me.role === KITCHEN_ROLE_ENUM.OWNER && item.role !== KITCHEN_ROLE_ENUM.OWNER }}" class="member__action-link" bindtap="onUpdateRole" data-user-id="{{ item.userId }}" data-role="{{ item.role }}">{{ item.role === KITCHEN_ROLE_ENUM.MANAGER ? '取消管厨' : '设为管厨' }}</text>
        <text wx:if="{{ me.role === KITCHEN_ROLE_ENUM.OWNER && item.role !== KITCHEN_ROLE_ENUM.OWNER }}" class="member__action-link member__action-link--danger" bindtap="onDeleteMember" data-user-id="{{ item.userId }}">移除</text>
      </view>
    </view>
  </view>

  <!-- 邀请成员 -->
  <view wx:if="{{ me.role !== KITCHEN_ROLE_ENUM.GUEST }}" class="member__invite-section">
    <view class="member__invite-btns">
      <button wx:if="{{ me.role === KITCHEN_ROLE_ENUM.OWNER }}" class="btn--matcha member__invite-btn" open-type="share" data-type="invite" data-id="{{ id }}" data-name="{{ name }}" data-role="{{ KITCHEN_ROLE_ENUM.MANAGER }}">+ 邀请帮厨</button>
      <button wx:if="{{ me.role === KITCHEN_ROLE_ENUM.OWNER || me.role === KITCHEN_ROLE_ENUM.MANAGER }}" class="btn--matcha member__invite-btn" open-type="share" data-type="invite" data-id="{{ id }}" data-name="{{ name }}" data-role="{{ KITCHEN_ROLE_ENUM.GUEST }}">+ 邀请食客</button>
    </view>
    <view class="member__invite-tip">邀请方式：分享微信卡片，对方点开即加入</view>
  </view>

  <!-- Banner 广告（内容末尾；本页卡片用 margin 0 32rpx，故用 p_h-32 包裹对齐；受 store.ad.enabled 总开关控制，无填充自动隐藏） -->
  <view class="p_h-32">
    <ad-unit wx:if="{{ !loading }}" ad-unit-id="{{ AD_UNIT_KITCHEN_MEMBER_BANNER }}" cls="page__ad" />
  </view>
</container>
