@import '../../../../common/style/index.wxss';

.kitchen-list {
  padding: 24rpx 32rpx;
}
/* Banner 广告：左右由 .kitchen-list 自带 32rpx 内边距承担，原生 ad 只加上下 margin */
.page__ad {
  margin: 24rpx 0 0;
}
.kitchen-list__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.kitchen-list__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.kitchen-list__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.kitchen-list__name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--font-color);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.kitchen-list__tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.kitchen-list__tag--current {
  color: var(--color-primary);
  background: rgba(183, 148, 102, 0.1);
}
.kitchen-list__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.kitchen-list__role {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.kitchen-list__role--1 {
  color: #b79466;
  background: rgba(183, 148, 102, 0.12);
}
.kitchen-list__role--2 {
  color: #5b8c6e;
  background: rgba(91, 140, 110, 0.12);
}
.kitchen-list__role--3 {
  color: #8c7e72;
  background: rgba(140, 126, 114, 0.12);
}
.kitchen-list__stat {
  font-size: 22rpx;
  color: var(--font-color-sub);
}
