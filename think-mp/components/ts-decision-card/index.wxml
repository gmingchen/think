<view class="ts-decision-card" bindtap="onTap">
  <!-- 头部：状态徽章（左） + 可见范围/发起人（右） -->
  <view class="ts-decision-card__head f f_a_i-c f_j_c-sb">
    <view class="f f_a_i-c">
      <ts-status-badge status="{{ item.status }}"></ts-status-badge>
    </view>
    <text wx:if="{{ item.visibility === 2 }}" class="ts-decision-card__vis">🔒 群内专属</text>
    <text wx:elif="{{ item.initiator && item.initiator.nickname }}" class="ts-decision-card__author e">{{ item.initiator.nickname }} 发起</text>
  </view>

  <!-- 标题（宋体品牌层） -->
  <view class="ts-decision-card__title font-serif">{{ item.title }}</view>

  <!-- 内容摘要（后端如返回 digest/content 则展示） -->
  <view wx:if="{{ item.digest || item.content }}" class="ts-decision-card__digest e-2">{{ item.digest || item.content }}</view>

  <!-- 图片缩略图（最多3张，后端如返回 images 则展示） -->
  <view wx:if="{{ item.images && item.images.length }}" class="ts-decision-card__images f">
    <image
      wx:for="{{ item.images }}"
      wx:for-item="img"
      wx:key="index"
      wx:if="{{ index < 3 }}"
      class="ts-decision-card__img"
      src="{{ img }}"
      mode="aspectFill"
    />
  </view>

  <!-- 标签（后端如返回 tags 则展示） -->
  <view wx:if="{{ item.tags && item.tags.length }}" class="ts-decision-card__tags f f_w-wrap">
    <text wx:for="{{ item.tags }}" wx:for-item="tag" wx:key="index" class="ts-decision-card__tag">{{ tag }}</text>
  </view>

  <!-- 评议进度（标签行 + 通栏进度条） -->
  <view class="ts-decision-card__foot">
    <view class="ts-decision-card__progress-label f f_j_c-sb">
      <text>评议进度</text>
      <text>{{ item.reviewCount || 0 }} / {{ item.reviewLimit || 0 }} 人已评</text>
    </view>
    <view class="ts-decision-card__track">
      <view class="ts-decision-card__fill" style="width: {{ percent }}%;"></view>
    </view>
  </view>
</view>
