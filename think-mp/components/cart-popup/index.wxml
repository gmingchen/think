<popup show="{{ visible }}" title="🧺 点菜篮" bind:close="onClose">
  <view class="cart__empty" wx:if="{{ !cart.list.length }}">
    <text class="cart__empty-emoji">🍽️</text>
    <text class="cart__empty-text">还没有选择菜谱哦</text>
  </view>
  <scroll-view scroll-y class="cart__list" wx:else>
    <view class="cart__item" wx:for="{{ cart.list }}" wx:key="dishId">
      <view class="cart__item-photo">
        <image wx:if="{{ item.photo }}" src="{{ item.photo }}" mode="aspectFill" class="cart__item-img" />
        <image wx:else src="{{ DEFAULT_DISH_COVER }}" mode="aspectFit" class="cart__item-img" />
      </view>
      <view class="cart__item-info">
        <text class="cart__item-name">{{ item.name }}</text>
      </view>
      <view class="cart__item-actions">
        <stepper value="{{ item.quantity }}" min="0" bind:change="onStepperChange" data-id="{{ item.dishId }}" />
      </view>
    </view>
  </scroll-view>
  <view class="cart__footer" wx:if="{{ cart.list.length }}">
    <view class="cart__total">
      <text>共</text>
      <text class="cart__total-num">{{ cart.quantity }}</text>
      <text>道菜</text>
    </view>
    <view class="cart__footer-btns">
      <view class="cart__shopping-btn" bind:tap="onGoShopping">🛒 采购清单</view>
      <view class="cart__confirm-btn" bind:tap="onConfirm"><view class="cart__confirm-btn-inner">敲定菜单<iconfont name="arrow-right" size="{{24}}" color="#FFF" /></view></view>
    </view>
  </view>
</popup>
