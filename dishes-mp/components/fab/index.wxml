<!-- 悬浮菜单 -->
<view class="fab" style="bottom: {{ bottom }}px; {{ anchor === 'left' ? 'left:' + left + 'px;' : 'right:' + right + 'px;' }}">
  <!-- 子菜单（垂直向上堆叠） -->
  <view
    class="fab__child {{ expanded ? 'fab__child--visible' : '' }}"
    wx:for="{{ positionedItems }}"
    wx:key="value"
    style="transform: translateY({{ expanded ? item.offsetY : 0 }}px) scale({{ expanded ? 1 : 0.6 }}); transition-delay: {{ expanded ? index * 45 : (positionedItems.length - 1 - index) * 30 }}ms;"
    data-value="{{ item.value }}"
    catch:tap="onTap">
    <view class="fab__child-btn">
      <text class="fab__child-icon">{{ item.icon }}</text>
    </view>
    <text class="fab__child-label">{{ item.label }}</text>
  </view>

  <!-- 主按钮 -->
  <view
    class="fab__main"
    catch:touchstart="onMainTouchStart"
    catch:touchmove="onMainTouchMove"
    catch:touchend="onMainTouchEnd">
    <view class="fab__main-icon {{ expanded ? 'fab__main-icon--rotate' : '' }}">
      <iconfont name="add" size="40" color="#fff" />
    </view>
    <text class="fab__badge" wx:if="{{ badge > 0 }}">{{ badge > 99 ? '99+' : badge }}</text>
    <view class="fab__hint {{ expanded ? 'fab__hint--hidden' : '' }}" wx:if="{{ hint }}">
      <text class="fab__hint-text">{{ hint }}</text>
    </view>
  </view>
</view>
