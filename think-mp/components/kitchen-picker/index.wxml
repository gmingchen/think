<popup show="{{ visible }}" title="切换厨房" bind:close="onClose">
  <view
    class="kitchen__item {{ item.id === kitchen.active.id ? 'kitchen__item--active' : '' }}"
    wx:for="{{ kitchen.list }}"
    wx:key="id"
    data-item="{{ item }}"
    bind:tap="onSelect">
    <text class="kitchen__name">{{ item.role === 1 ? '👨‍🍳' : '🏠' }} {{ item.name }}</text>
    <text class="kitchen__badge" wx:if="{{ item.id === kitchen.active.id }}">✅ 当前</text>
  </view>
</popup>
