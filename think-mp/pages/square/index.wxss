page {
  background: var(--ts-bg);
}

/* navbar 左侧品牌（与三思首页一致） */
.square__nav-brand {
  font-size: 40rpx;
  color: var(--ts-text);
  letter-spacing: 4rpx;
  font-weight: var(--font-weight-6);
}

/* 随机入口横幅 */
.square__banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background: var(--ts-tag-bg);
  border-radius: var(--ts-radius);
}

.square__banner:active {
  opacity: .9;
}

.square__banner-text {
  min-width: 0;
}

.square__banner-title {
  font-size: 30rpx;
  font-weight: var(--font-weight-6);
  color: var(--ts-text);
}

.square__banner-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ts-text-sub);
}

.square__banner-btn {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: var(--ts-primary);
  border-radius: var(--ts-radius-pill);
}

.square__item {
  margin: 24rpx 32rpx 0;
}

.square__loading,
.square__more {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--ts-text-sub);
}

.square__more {
  color: var(--ts-brand);
}

/* 底部留白（tabbar 上方透气） */
.square__spacer {
  height: 40rpx;
}
