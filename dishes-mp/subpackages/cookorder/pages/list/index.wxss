/* 顶部切换 */
.list__tab-bar {
  display: flex;
  padding: 20rpx 32rpx;
  gap: 20rpx;
}
.list__tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-radius: 12rpx;
  background: var(--bg-card);
  color: var(--font-color-sub);
  border: 1rpx solid var(--border-color);
}
.list__tab-btn--active {
  background: var(--color-primary);
  color: #FFF;
  border-color: var(--color-primary);
  font-weight: bold;
}

/* 订单卡片 */
.list__order-card {
  margin: 0 32rpx 20rpx;
  padding: 24rpx 32rpx;
}
.list__order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12rpx;
  border-bottom: var(--border-dashed);
}
.list__order-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--font-color);
}
.list__order-dishes {
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-bottom: var(--border-dashed);
}
/* 菜品行：封面 + 名称抢宽省略 + 数量居右 */
.list__dish-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.list__dish-cover {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: #F2E8DC;
  flex-shrink: 0;
}
.list__dish-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--font-color);
}
.list__dish-qty {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--font-color-sub);
}
.list__order-remark {
  font-size: 22rpx;
  color: var(--font-color-weak);
  padding: 4rpx 0;
}
/* 负 margin 抵消卡片左右内边距，与正文的分隔线贯穿整卡 */
.list__order-foot {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 -32rpx;
  padding: 12rpx 32rpx 0;
}
/* 行1：时间左、评星右；锁行高防评星出现/消失时卡片高度跳变 */
.list__foot-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 32rpx;
}
.list__order-time {
  font-size: 22rpx;
  color: var(--font-color-sub);
}
/* 行2：左仅取消，右采购清单+状态主操作（同详情页左右分组）；负 margin 使与行1间的分隔线贯穿整卡 */
.list__order-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0 -32rpx;
  padding: 12rpx 32rpx 0;
  /* border-top: var(--border-dashed); */
}
.list__actions-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.list__actions-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.list__action {
  font-size: 24rpx;
  font-weight: 600;
}
.list__action--primary {
  color: var(--color-primary);
}
/* 采购清单：主色描边，与详情页 ghost 同 scale */
.list__ghost-btn {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: 10rpx;
}
.list__ghost-btn:active {
  background: rgba(200, 109, 81, 0.12);
}
/* 接单/上菜：实底主题色，与详情页主操作同 scale */
.list__main-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.list__action--cancel {
  color: var(--font-color-sub);
  font-weight: 400;
}
.list__rating-display {
  display: flex;
  align-items: center;
  line-height: 1;
}

/* 加载更多 */
.list__load-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--font-color-sub);
  padding: 24rpx 0 40rpx;
}

/* 空状态居中 */
.list__empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

/* 原生模板广告：左右间距由外层 p_h-32 承担，只加上下 margin */
.page__ad {
  margin: 16rpx 0 24rpx;
}
