.skeleton {
  padding: 24rpx 32rpx 0;
}

.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}

.skeleton__item {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
  background: #FFF;
  border: 1rpx solid #E8DDD0;
  border-radius: 16rpx;
}

.skeleton__block--avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.skeleton__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skeleton__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.skeleton__block--name {
  width: 100rpx;
  height: 24rpx;
}

.skeleton__block--time {
  width: 80rpx;
  height: 20rpx;
}

.skeleton__block--stars {
  width: 120rpx;
  height: 22rpx;
  margin-left: auto;
}

.skeleton__block--content {
  width: 100%;
  height: 22rpx;
}

.skeleton__block--content-short {
  width: 60%;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
