.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 96rpx;
  padding: 0 40rpx;
  background: var(--ts-primary);
  color: #FFFFFF;
  border-radius: var(--ts-radius-pill);
  box-shadow: var(--ts-shadow-fab);
}

.fab:active {
  opacity: 0.92;
}

.fab__plus {
  font-size: 34rpx;
  line-height: 1;
  margin-right: 4rpx;
}

.fab__text {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  white-space: nowrap;
}

.fab__seal {
  width: 10rpx;
  height: 10rpx;
  background: var(--ts-seal);
  border-radius: 50%;
  margin-left: 2rpx;
}
