<view class="dish-card" bind:tap="onDetail">
  <view class="dish-card__top">
    <image class="dish-card__thumb" src="{{ dish.dishCover || DEFAULT_DISH_COVER }}" mode="aspectFill" />
    <view class="dish-card__detail">
      <view class="dish-card__name-row">
        <text class="dish-card__name">{{ dish.dishName }}</text>
        <text wx:if="{{ dish.first }}" class="dish-card__badge">★ 首推首选</text>
      </view>
      <text wx:if="{{ dish.meta }}" class="dish-card__meta">{{ dish.meta }}</text>
      <view class="dish-card__diff">
        <text wx:if="{{ haveText }}" class="dish-card__diff-have">✔ 齐备：{{ haveText }}</text>
        <text wx:if="{{ lackText }}" class="dish-card__diff-lack">✖ 仅缺：{{ lackText }}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{ dish.reason }}" class="dish-card__reason">“{{ dish.reason }}”</view>

  <view class="dish-card__actions">
    <text class="dish-card__tip">点击查看菜谱详情</text>
    <view class="dish-card__btn dish-card__btn--solid" catch:tap="onCart">🧺 入篮</view>
  </view>
</view>
