@import '../../../../common/style/index.wxss';

/* ── 色板变量（与抽菜页小票同一套 Zakka 语言） ── */
page {
  --zakka-terracotta: #C86D51;
  --zakka-terracotta-dark: #A44F37;
  --zakka-matcha: #688B58;
  --zakka-mustard: #E0A94F;
  --zakka-paper: #F5EFEB;
  --zakka-card-white: #FFFDF9;
  --zakka-ink: #3D352E;
  --zakka-pencil: #8C7E72;
  --zakka-tape: rgba(224, 169, 79, 0.6);
  --zakka-stamp-red: #B84A39;
}

.shopping__body {
  padding: 16rpx 28rpx 40rpx;
}

/* ═══════════════════════════════════════
   顶部采买进度胶囊
   ═══════════════════════════════════════ */
.shopping__progress {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--zakka-card-white);
  border: 2rpx solid #DCD0C3;
  border-radius: 40rpx;
  padding: 10rpx 24rpx;
  width: fit-content;
  margin: 0 auto 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}
.shopping__progress-label {
  font-size: 22rpx;
  color: var(--zakka-pencil);
}
.shopping__progress-num {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--zakka-terracotta);
}
.shopping__progress-track {
  width: 140rpx;
  height: 12rpx;
  background: #ECE1D4;
  border-radius: 8rpx;
  overflow: hidden;
}
.shopping__progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #E2886E, var(--zakka-terracotta));
  border-radius: 8rpx;
  transition: width 0.35s ease, background 0.35s;
}
.shopping__progress-fill--full {
  background: var(--zakka-matcha);
}

/* ═══════════════════════════════════════
   来源菜订单区（小票顶部）+ 可折叠菜列表（封面+名称+数量）
   ═══════════════════════════════════════ */
/* 票内普通行：与便签头虚线拉开 24rpx，与小票纸面同色 */
.shopping__source {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 0 0;
  font-size: 24rpx;
  color: var(--zakka-pencil);
}
.shopping__source-icon {
  flex-shrink: 0;
}
.shopping__source-label {
  flex: 1;
  min-width: 0;
  color: var(--zakka-ink);
  font-weight: bold;
}
.shopping__source-arrow {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
/* 折叠容器：高度由 JS 量取内容真实高度后显式设置，height 过渡实现展开/收起动画 */
.shopping__collapse {
  overflow: hidden;
  transition: height 0.28s ease;
}
.shopping__dish-list {
  /* 与订单行同属一个区块，用留白分层不再叠线（双线夹行是之前错乱的主因） */
  padding: 16rpx 0 0;
}
.shopping__dish-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx dotted #E5DCD2;
}
.shopping__dish-row:last-child {
  border-bottom: none;
}
.shopping__dish-cover {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: #F2E8DC;
  flex-shrink: 0;
}
.shopping__dish-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--zakka-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.shopping__dish-qty {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--zakka-terracotta);
}

/* ═══════════════════════════════════════
   采买便签小票卡片
   ═══════════════════════════════════════ */
.shopping__receipt {
  background: var(--zakka-card-white);
  border: 2rpx solid #E4D9CE;
  border-radius: 28rpx 28rpx 4rpx 4rpx;
  padding: 32rpx 28rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(70, 50, 35, 0.08);
  position: relative;
  margin-top: 32rpx;
}

/* 顶部和纸胶带 */
.shopping__receipt-tape {
  position: absolute;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-1deg);
  width: 280rpx;
  height: 40rpx;
  background: var(--zakka-tape);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
  clip-path: polygon(3% 0%, 97% 0%, 100% 100%, 0% 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  color: #4B371B;
  letter-spacing: 3rpx;
  z-index: 20;
}

/* 顶部穿孔虚线 */
.shopping__receipt-perf {
  position: absolute;
  top: 12rpx;
  left: 24rpx;
  right: 24rpx;
  border-top: 2rpx dashed #D6C8B8;
}

.shopping__receipt-head {
  text-align: center;
  padding: 8rpx 0 24rpx;
  border-bottom: 2rpx dashed #D8CABE;
}
.shopping__receipt-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--zakka-ink);
  letter-spacing: 1rpx;
}
.shopping__receipt-sub {
  display: block;
  font-size: 22rpx;
  color: var(--zakka-pencil);
  margin-top: 6rpx;
}
.shopping__receipt-sub--done {
  color: var(--zakka-matcha);
  font-weight: bold;
}

/* 底部锯齿撕裂 */
.shopping__receipt-tear {
  position: absolute;
  bottom: -16rpx;
  left: 0;
  right: 0;
  height: 16rpx;
  background-image: radial-gradient(circle, transparent 8rpx, var(--zakka-card-white) 8rpx);
  background-size: 24rpx 16rpx;
  background-position: 0 -8rpx;
}

/* ═══════════════════════════════════════
   三档分组与折叠
   ═══════════════════════════════════════ */
.shopping__group {
  /* 分区块统一节奏：虚线上下各 24rpx */
  margin-top: 24rpx;
  border-top: 2rpx dashed #D8CABE;
}
.shopping__group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* 与 list 的上下缓冲都挂进可点的 head，扩大展开/收起命中区 */
  padding-top: 24rpx;
  padding-bottom: 8rpx;
}
.shopping__group-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--zakka-ink);
}
.shopping__group-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--zakka-pencil);
}
.shopping__group-status--pri {
  font-weight: 600;
  color: var(--zakka-terracotta);
}
.shopping__group-status--sea {
  font-weight: 600;
  color: var(--zakka-mustard);
}

.shopping__list {
  display: flex;
  flex-direction: column;
}

/* ═══════════════════════════════════════
   清单条目（整行可点，紧凑小票节奏：纯文本行 72rpx）
   ═══════════════════════════════════════ */
.shopping__item {
  min-height: 48rpx;
  /* 上留白用 margin（不吃点击，收起时防误勾），下留白用 padding（ dotted 线与文字拉开且随命中区走） */
  padding: 0 16rpx 12rpx 8rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  border-bottom: 2rpx dotted #E5DCD2;
  border-radius: 16rpx;
  transition: background 0.15s, opacity 0.25s;
}
.shopping__item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.shopping__item:active {
  background: #F6EDE4;
}

/* 打孔圆圈勾选框：32rpx 与紧凑行高匹配，垂直对齐主行文字 */
.shopping__punch {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #B4A496;
  border-radius: 50%;
  margin-top: 4rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
  font-size: 18rpx;
  font-weight: 900;
  color: #FFF;
}
.shopping__punch--on {
  background: var(--zakka-matcha);
  border-color: var(--zakka-matcha);
  box-shadow: 0 2rpx 6rpx rgba(104, 139, 88, 0.4);
}

.shopping__item-info {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}
.shopping__item-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
}
.shopping__item-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--zakka-ink);
}
/* 形态①/④ 可求和：醒目"共X" */
.shopping__item-amount {
  font-size: 22rpx;
  color: #6E5C50;
  text-align: right;
  flex-shrink: 0;
}
.shopping__item-amount--sum {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--zakka-terracotta);
}
/* 调料用量：芥末黄 */
.shopping__item-amount--sea {
  font-weight: 600;
  color: var(--zakka-mustard);
}
/* 已买：划线置灰 */
.shopping__item-name--done {
  text-decoration: line-through;
  color: var(--zakka-pencil);
}
.shopping__item-amount--done {
  text-decoration: line-through;
  color: var(--zakka-pencil) !important;
}

/* 次要信息：来源菜锚点 + 处理批注 */
.shopping__item-meta {
  font-size: 20rpx;
  color: var(--zakka-pencil);
  margin-top: 4rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}
.shopping__item-source {
  background: #F4ECE3;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  color: #7A695B;
}
/* 不可求和的分段用量：独占整行，不再挤在主行右侧折行 */
.shopping__item-seg {
  flex-basis: 100%;
  font-size: 22rpx;
  color: #6E5C50;
  line-height: 1.7;
}
.shopping__item-seg--done {
  text-decoration: line-through;
  color: var(--zakka-pencil);
}
.shopping__item-process {
  color: #936B46;
}

/* ═══════════════════════════════════════
   朱红刻铜印章（全部采买完成盖下）
   ═══════════════════════════════════════ */
.shopping__seal {
  position: absolute;
  bottom: 40rpx;
  right: 32rpx;
  width: 140rpx;
  height: 140rpx;
  border: 4rpx solid var(--zakka-stamp-red);
  border-radius: 50%;
  color: var(--zakka-stamp-red);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  pointer-events: none;
  opacity: 0;
  transform: scale(2.2) rotate(22deg);
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  background: rgba(250, 240, 235, 0.45);
  box-shadow: inset 0 0 0 2rpx rgba(184, 74, 57, 0.35);
  z-index: 30;
}
.shopping__seal--hit {
  opacity: 0.9;
  transform: scale(1) rotate(-12deg);
}
.shopping__seal-main {
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.shopping__seal-sub {
  font-size: 16rpx;
  margin-top: 2rpx;
  font-weight: normal;
}

/* ═══════════════════════════════════════
   底部固定操作栏
   ═══════════════════════════════════════ */
.shopping__footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(245, 239, 235, 0.97);
  border-top: 2rpx dashed #DDD1C4;
}
.shopping__dock-sub {
  flex: 1;
  background: var(--zakka-card-white);
  color: var(--zakka-pencil);
  border: 2rpx solid #D6C8BA;
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}
.shopping__dock-sub:active {
  background: #EFE4D6;
  transform: scale(0.97);
}
.shopping__dock-main {
  flex: 2;
  background: var(--zakka-terracotta);
  color: #FFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  font-weight: bold;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(200, 109, 81, 0.35);
}
.shopping__dock-main:active {
  transform: scale(0.97);
}

/* ═══════════════════════════════════════
   空态 / 失败态
   ═══════════════════════════════════════ */
.shopping__empty {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.shopping__empty-btn {
  margin-top: 32rpx;
  padding: 16rpx 44rpx;
  background: var(--zakka-terracotta);
  color: #FFF;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 12rpx;
  box-shadow: 2rpx 4rpx 8rpx rgba(200, 109, 81, 0.35);
}
.shopping__empty-btn:active {
  transform: scale(0.96);
}

/* Banner 广告：左右间距由页面侧 p_h-28 包裹承担，原生 ad 只加上下 margin */
.page__ad {
  margin: 8rpx 0 24rpx;
}
