<wxs module="l">
module.exports.n = function (v) {
  return v ? v.length : 0
}
module.exports.has = function (arr, id) {
  // WXML {{}} 不支持调用方法（indexOf 等），数组包含判定必须在 WXS 内执行
  return arr ? arr.indexOf(id) > -1 : false
}
</wxs>

<container title="发起决策单" use-back use-scroll use-footer>
  <view class="form">
    <!-- 强隐私引导条 -->
    <view class="form__privacy-lead">
      <text class="form__privacy-lead-icon">🛡️</text>
      <view>涉及薪酬、家事等私密抉择？建议使用「群内评议」，仅定向受邀亲友或顾问可见。</view>
    </view>

    <!-- 卡片 1：两难核心描述 -->
    <view class="form__card">
      <view class="form__title-row">
        <view class="form__card-title font-serif">决策标题<text class="form__req">*</text></view>
        <text class="form__counter">{{ l.n(form.title) }} / {{ TITLE_MAX }}</text>
      </view>
      <view class="form__input-box">
        <input
          class="form__input"
          placeholder="概括你的两难抉择"
          value="{{ form.title }}"
          maxlength="{{ TITLE_MAX }}"
          bindinput="onTitleInput"
        />
      </view>

      <view class="form__title-row form__title-row--gap">
        <view class="form__card-title font-serif">处境与诉求<text class="form__req">*</text></view>
        <text class="form__counter">{{ l.n(form.content) }} / {{ CONTENT_MAX }}</text>
      </view>
      <view class="form__textarea-box">
        <view class="form__warn-badge">⚠️ 严禁输入身份证、手机号、银行卡等个人敏感隐私</view>
        <textarea
          class="form__textarea"
          placeholder="详细陈述背景、顾虑以及希望众人重点侧重评议的角度…"
          value="{{ form.content }}"
          maxlength="{{ CONTENT_MAX }}"
          bindinput="onContentInput"
        />
      </view>

      <view class="form__title-row form__title-row--gap">
        <view class="form__card-title form__card-title--sm">凭证与背景图<text class="form__optional">(可选，最多 {{ IMAGE_MAX }} 张)</text></view>
        <text class="form__counter">{{ l.n(form.images) }} / {{ IMAGE_MAX }}</text>
      </view>
      <!-- 图片上传：通用 uploader 组件（内置 previewer），回抛事件由 fileBehavior 按 data-field 自动同步 -->
      <uploader
        class="form__img-upload"
        value="{{ form.images }}"
        count="{{ IMAGE_MAX }}"
        options="{{ uploadOptions }}"
        width="136rpx"
        height="136rpx"
        radius="20rpx"
        gap="20rpx"
        deletable
        preview
        placeholder="相册/拍摄"
        data-field="form.images"
        bind:on-complete="onFileComplete"
        bind:on-delete="onFileDelete"
      />
    </view>

    <!-- 卡片 2：你会怎么选 -->
    <view class="form__card">
      <view class="form__title-row">
        <view class="form__card-title font-serif">你会怎么选<text class="form__req">*</text></view>
        <text class="form__counter">至少 2 个选择</text>
      </view>
      <view class="form__option" wx:for="{{ form.options }}" wx:key="index">
        <view class="form__option-box">
          <input
            class="form__option-input"
            placeholder="选项 {{ index + 1 }}"
            value="{{ item }}"
            data-index="{{ index }}"
            bindinput="onOptionInput"
          />
        </view>
        <text
          wx:if="{{ form.options.length > 2 }}"
          class="form__option-del"
          data-index="{{ index }}"
          bindtap="onOptionDelete"
        >✕</text>
      </view>
      <view class="form__option-add" bindtap="onOptionAdd">＋ 添加一个选择</view>
    </view>

    <!-- 卡片 3：可见范围与分发 -->
    <view class="form__card">
      <view class="form__title-row">
        <view class="form__card-title font-serif">可见范围<text class="form__req">*</text></view>
      </view>
      <view class="form__scope">
        <view
          class="form__scope-card {{ form.visibility === VISIBILITY_ENUM.GRP ? 'form__scope-card--active' : '' }}"
          data-value="{{ VISIBILITY_ENUM.GRP }}"
          bindtap="onVisibilitySelect"
        >
          <view class="form__scope-name">群内评议</view>
          <view class="form__scope-sub">精准定向</view>
        </view>
        <view
          class="form__scope-card {{ form.visibility === VISIBILITY_ENUM.PUBLIC ? 'form__scope-card--active' : '' }}"
          data-value="{{ VISIBILITY_ENUM.PUBLIC }}"
          bindtap="onVisibilitySelect"
        >
          <view class="form__scope-name">公开发布</view>
          <view class="form__scope-sub">众思广场</view>
        </view>
      </view>

      <!-- 群内 → 选群 -->
      <block wx:if="{{ form.visibility === VISIBILITY_ENUM.GRP }}">
        <view class="form__sub-label">选择目标群聊</view>
        <view class="form__picker-box" bindtap="onOpenGrpPicker">
          <view class="form__picker-info">
            <text wx:if="{{ form.grpName }}" class="form__group-tag">已选</text>
            <text class="{{ form.grpName ? 'form__picker-name' : 'form__picker-ph' }}">{{ form.grpName || '请选择群组' }}</text>
          </view>
          <iconfont class="form__picker-change" name="right" size="24" color="#9AA0AA" />
        </view>
      </block>

      <!-- 公开 → 标签 -->
      <block wx:if="{{ form.visibility === VISIBILITY_ENUM.PUBLIC }}">
        <view class="form__title-row form__title-row--gap">
          <view class="form__sub-label form__sub-label--mb0">选择决策领域标签</view>
          <text class="form__counter">最多 {{ TAG_MAX }} 个</text>
        </view>
        <view class="form__tag-pool">
          <view
            wx:for="{{ tags }}"
            wx:key="id"
            class="form__tag-chip {{ l.has(form.tagIds, item.id) ? 'form__tag-chip--active' : '' }}"
            data-id="{{ item.id }}"
            bindtap="onTagToggle"
          >{{ item.name }}</view>
        </view>
      </block>

    </view>

    <!-- 卡片 4：结束规则（评议时限 + 评议人数上限，共同决定收口方式） -->
    <view class="form__card">
      <view class="form__title-row">
        <view class="form__card-title font-serif">结束规则<text class="form__req">*</text></view>
        <text class="form__counter">{{ form.coolDownMinutes === COOL_DOWN_ENUM.UNLIMITED ? '满员即出具报告' : '到期或满员即出具报告' }}</text>
      </view>

      <!-- 评议时限（两段式：小时 stepper + 分钟档，另「不限」开关；0=不限） -->
      <view class="form__limit-head">
        <view class="form__sub-label form__sub-label--mb0">评议时限</view>
        <view class="form__limit-ctrl">
          <view
            class="form__unlimit {{ form.coolDownMinutes === COOL_DOWN_ENUM.UNLIMITED ? 'form__unlimit--active' : '' }}"
            bindtap="onCoolDownUnlimited"
          >不限</view>
          <view class="form__stepper">
            <view class="form__stepper-btn" bindtap="onHoursMinus">-</view>
            <view class="form__stepper-val form__stepper-val--wide">{{ cdHours }} 时</view>
            <view class="form__stepper-btn" bindtap="onHoursPlus">+</view>
          </view>
        </view>
      </view>
      <view class="form__minute {{ form.coolDownMinutes === COOL_DOWN_ENUM.UNLIMITED ? 'form__minute--disabled' : '' }}">
        <view
          wx:for="{{ COOL_DOWN_MINUTE_OPTIONS }}"
          wx:key="*this"
          class="form__minute-pill {{ form.coolDownMinutes !== COOL_DOWN_ENUM.UNLIMITED && cdMins === item ? 'form__minute-pill--active' : '' }}"
          data-value="{{ item }}"
          bindtap="onMinuteSelect"
        >{{ item }} 分</view>
      </view>

      <!-- 评议人数上限（stepper 逐数 + 点击输入 + 不限开关：满员自动截止出报告；不限=只能到期/手动结束） -->
      <view class="form__limit">
        <view class="form__limit-head">
          <view class="form__sub-label form__sub-label--mb0">评议人数上限</view>
          <view class="form__limit-ctrl">
            <view
              class="form__unlimit {{ form.reviewLimit === REVIEW_LIMIT_ENUM.UNLIMITED ? 'form__unlimit--active' : '' }}"
              bindtap="onReviewLimitUnlimited"
            >不限</view>
            <view class="form__stepper">
              <view class="form__stepper-btn" bindtap="onReviewLimitMinus">-</view>
              <input
                wx:if="{{ form.reviewLimit !== REVIEW_LIMIT_ENUM.UNLIMITED }}"
                class="form__stepper-input"
                type="number"
                value="{{ form.reviewLimit }}"
                bindblur="onReviewLimitBlur"
              />
              <view wx:else class="form__stepper-val">不限</view>
              <view class="form__stepper-btn" bindtap="onReviewLimitPlus">+</view>
            </view>
          </view>
        </view>
        <view class="form__limit-sub">{{ form.visibility === VISIBILITY_ENUM.PUBLIC ? '公开档上限 50 人' : '不超过受邀评议人数' }}；满员自动截止并出具报告</view>
      </view>
    </view>

    <view class="form__disclaimer">建议仅供参考，最终决定权归你</view>
  </view>

  <!-- 底部操作 -->
  <view slot="footer" class="form__actions">
    <view class="form__btn form__btn--ghost" bindtap="onSave">存草稿</view>
    <view class="form__btn form__btn--primary" bindtap="onPublish">
      <text>发布评议</text>
      <view class="form__btn-seal"></view>
    </view>
  </view>
</container>

<!-- 选群弹窗（显隐、群组列表拉取与样式内聚于 grp-picker，选中经 bind:select 回抛） -->
<grp-picker id="grpPicker" selected="{{ form.grpId }}" bind:select="onGrpSelect" />
