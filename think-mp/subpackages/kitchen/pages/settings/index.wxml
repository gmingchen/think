<wxs src="../../../../wxs/index.wxs" module="utils" />

<container use-scroll title="厨房设置" use-back>
  <!-- 骨架屏 -->
  <skeleton wx:if="{{ loading }}" />

  <!-- ① 厨房信息卡：名称 + 角色火印章 + 六格资产（纯数字、不带上限）+ 卡底弱文字 -->
  <view class="zk__card settings__info-card">
    <view class="zk__tape"></view>
    <view class="settings__info-header">
      <text class="settings__info-name">{{ target.name }}</text>
      <text class="settings__role settings__role--{{ target.role }}">{{ utils.findEnumLabel(target.role, KITCHEN_ROLE_LIST) }}</text>
    </view>
    <view class="settings__stats">
      <view class="settings__stat" wx:for="{{ statsList }}" wx:key="label">
        <text class="settings__stat-num">{{ item.value }}</text>
        <text class="settings__stat-label">{{ item.label }}</text>
      </view>
    </view>
    <view class="settings__info-foot">已盛盘 {{ plateCount }} 份美味{{ createdDate ? ' · 创建于 ' + createdDate : '' }}</view>
  </view>

  <!-- ② 厨房容量扩容（仅厨师长/管厨、且广告总开关开启时展示；每看一次激励视频对应上限 +1，不设上限、不限次数）
       畅厨在本厨房不限数（target.unlimitedCapacity 已含 owner 判定）：行值显「x/不限」、隐藏进度条与全部 📺 按钮，
       但卡片保留——它同时是「我还能存多少」的唯一读数处；轻享不隐藏（§6.1 三分法） -->
  <view wx:if="{{ !loading && (target.role === 1 || target.role === 2) && ad.enabled }}" class="zk__card settings__expand-card">
    <view class="zk__tape--green"></view>
    <view class="settings__expand-head">
      <text class="settings__expand-title">🌿 厨房容量扩容</text>
      <text wx:if="{{ !target.unlimitedCapacity }}" class="settings__expand-tag">看视频 +1</text>
    </view>
    <view wx:if="{{ !target.unlimitedCapacity }}" class="settings__expand-desc">看一段小视频，为厨房添一格空间。菜谱与分类各自独立扩容，不设上限、不限次数。</view>
    <view wx:else class="settings__expand-desc">👑 畅厨会员 · 本厨房的分类与菜谱不限数。</view>

    <!-- 菜谱：上行为「名称 ← → 数量」左右划分，下行为「进度条 ← → 按钮」水平居中 -->
    <view class="settings__quota-row">
      <view class="settings__quota-head">
        <text class="settings__quota-name">📖 菜谱</text>
        <view class="settings__quota-count">
          <text class="settings__quota-fraction">{{ dish.cur }}/{{ dish.unlimited ? '不限' : dish.max }}</text>
          <text wx:if="{{ !dish.unlimited }}" class="settings__quota-remain">{{ dish.over > 0 ? '已超出 ' + dish.over : '余 ' + dish.remain }}</text>
          <text wx:if="{{ !dish.unlimited && !dish.over && dish.warn }}" class="settings__quota-warn">{{ dish.full ? '已满' : '即将满载' }}</text>
        </view>
      </view>
      <view wx:if="{{ !dish.unlimited }}" class="settings__quota-line">
        <view class="settings__meter">
          <view class="settings__meter-fill {{ dish.warn ? 'settings__meter-fill--alert' : '' }}" style="width: {{ dish.percent }}%"></view>
        </view>
        <view class="settings__expand-btn {{ expanding ? 'settings__expand-btn--disabled' : '' }}" bind:tap="onExpandDish">📺 看视频 +1</view>
      </view>
    </view>

    <!-- 分类：与菜谱同构 -->
    <view class="settings__quota-row">
      <view class="settings__quota-head">
        <text class="settings__quota-name">🏷️ 分类</text>
        <view class="settings__quota-count">
          <text class="settings__quota-fraction">{{ category.cur }}/{{ category.unlimited ? '不限' : category.max }}</text>
          <text wx:if="{{ !category.unlimited }}" class="settings__quota-remain">{{ category.over > 0 ? '已超出 ' + category.over : '余 ' + category.remain }}</text>
          <text wx:if="{{ !category.unlimited && !category.over && category.warn }}" class="settings__quota-warn">{{ category.full ? '已满' : '即将满载' }}</text>
        </view>
      </view>
      <view wx:if="{{ !category.unlimited }}" class="settings__quota-line">
        <view class="settings__meter">
          <view class="settings__meter-fill {{ category.warn ? 'settings__meter-fill--alert' : '' }}" style="width: {{ category.percent }}%"></view>
        </view>
        <view class="settings__expand-btn {{ expanding ? 'settings__expand-btn--disabled' : '' }}" bind:tap="onExpandCategory">📺 看视频 +1</view>
      </view>
    </view>

    <!-- 会员引导行：只给厨师长看，且畅厨自己那一行必须同时消失（给畅厨再写一行等于卖一件他刚买过的东西） -->
    <view wx:if="{{ target.isOwner && !target.unlimitedCapacity }}" class="settings__expand-vip" bind:tap="onGoVip">开通畅厨会员，不再限数 ›</view>
  </view>

  <!-- ③ 设置菜单 -->
  <view class="zk__card settings__menu-list-card">
    <view class="settings__menu-item" bind:tap="{{ target.role === 1 ? 'onKitchenName' : '' }}">
      <text>🏠 厨房名称</text>
      <view class="settings__menu-right">
        <text class="settings__menu-value">{{ target.name }}</text>
        <iconfont wx:if="{{ target.role === 1 }}" name="arrow-right" size="28" color="#8C7E72" />
      </view>
    </view>
    <view wx:if="{{ target.role === 1 || target.role === 2 }}" class="settings__menu-item {{ target.role === 1 ? 'settings__menu-item--last' : '' }}" bind:tap="onMember">
      <text>👥 成员管理</text>
      <view class="settings__menu-right">
        <text class="settings__menu-value">{{ memberCount }} 人</text>
        <iconfont name="arrow-right" size="28" color="#8C7E72" />
      </view>
    </view>
    <view wx:if="{{ target.role !== 1 }}" class="settings__menu-item settings__menu-item--last settings__menu-item--danger" bind:tap="onExitKitchen">
      <text>🚪 退出厨房</text>
      <view class="settings__menu-right">
        <iconfont name="arrow-right" size="28" color="#8C7E72" />
      </view>
    </view>
  </view>

  <!-- Banner 广告（页面末尾；加载完成即展示，无数据也展示、加载中不展示；受 store.ad.enabled 总开关控制，无填充自动隐藏） -->
  <view class="p_h-32">
    <ad-unit wx:if="{{ !loading }}" ad-unit-id="{{ AD_UNIT_KITCHEN_SETTINGS_CUSTOM }}" cls="page__ad" />
  </view>

  <!-- 编辑厨房名称弹窗 -->
  <name-popup id="namePopup" bind:confirm="onConfirm" />
</container>
