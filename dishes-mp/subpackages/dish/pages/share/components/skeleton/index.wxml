<view class="skeleton">
  <!-- 拍立得相框骨架 -->
  <view class="skeleton__frame">
    <view class="skeleton__block skeleton__block--cover"></view>
    <view class="skeleton__row">
      <view class="skeleton__block skeleton__block--title"></view>
      <view class="skeleton__block skeleton__block--stamp"></view>
    </view>
    <!-- 分享者信笺 -->
    <view class="skeleton__sharer">
      <view class="skeleton__block skeleton__block--avatar"></view>
      <view class="skeleton__sharer-info">
        <view class="skeleton__block skeleton__block--name"></view>
        <view class="skeleton__block skeleton__block--sub"></view>
      </view>
    </view>
    <!-- 评分与统计 -->
    <view class="skeleton__stats">
      <view class="skeleton__block skeleton__block--stars"></view>
      <view class="skeleton__block skeleton__block--badge"></view>
    </view>
  </view>

  <!-- 用料手记骨架 -->
  <view class="skeleton__card">
    <view class="skeleton__block skeleton__block--label"></view>
    <view class="skeleton__chips">
      <view
        class="skeleton__block skeleton__block--chip"
        wx:for="{{ [180, 240, 150, 210] }}"
        wx:key="*this"
        style="width: {{ item }}rpx;"></view>
    </view>
  </view>

  <!-- 调料清单骨架 -->
  <view class="skeleton__card">
    <view class="skeleton__block skeleton__block--label"></view>
    <view class="skeleton__chips">
      <view
        class="skeleton__block skeleton__block--chip"
        wx:for="{{ [140, 120, 150] }}"
        wx:key="*this"
        style="width: {{ item }}rpx;"></view>
    </view>
  </view>

  <!-- 步骤分解骨架 -->
  <view class="skeleton__card">
    <view class="skeleton__block skeleton__block--label"></view>
    <view class="skeleton__step" wx:for="{{ [1,2,3] }}" wx:key="*this">
      <view class="skeleton__block skeleton__block--num"></view>
      <view class="skeleton__step-lines">
        <view class="skeleton__block skeleton__block--line"></view>
        <view class="skeleton__block skeleton__block--line skeleton__block--line-short"></view>
      </view>
    </view>
  </view>

  <!-- 小贴士骨架 -->
  <view class="skeleton__memo">
    <view class="skeleton__block skeleton__block--label"></view>
    <view class="skeleton__block skeleton__block--line"></view>
    <view class="skeleton__block skeleton__block--line skeleton__block--line-short"></view>
  </view>
</view>
