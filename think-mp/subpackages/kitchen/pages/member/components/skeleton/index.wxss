/* 骨架屏遮罩 */
.skeleton {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #F5F0EB;
  padding: 24rpx 32rpx;
  overflow: hidden;
}

/* 卡片 */
.skeleton__card {
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
  background: #FFF;
  border-radius: 24rpx;
  border: 1rpx solid #ECE3D9;
  box-shadow: 2rpx 6rpx 16rpx rgba(0,0,0,0.06);
}

/* 成员项 */
.skeleton__member-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
}
.skeleton__member-item + .skeleton__member-item {
  border-top: 1rpx dashed #ECE3D9;
}
.skeleton__member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 邀请区域 */
.skeleton__invite {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}

/* 骨架块 */
.skeleton__block {
  background: linear-gradient(90deg, #f0e6d8 25%, #f7efe4 50%, #f0e6d8 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: 6rpx;
}
.skeleton__block--avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.skeleton__block--name {
  width: 140rpx;
  height: 28rpx;
}
.skeleton__block--role {
  width: 80rpx;
  height: 24rpx;
}
.skeleton__block--action {
  width: 80rpx;
  height: 24rpx;
  flex-shrink: 0;
}
.skeleton__block--btn {
  width: 300rpx;
  height: 64rpx;
  border-radius: 16rpx;
}
.skeleton__block--tip {
  width: 360rpx;
  height: 22rpx;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
